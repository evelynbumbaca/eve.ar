---
/* ============================================================
   Testimonials — reseñas de clientes que VENDEN:
   · Valoración agregada protagonista (5,0 + estrellas naranjas).
   · Una frase gigante por vez (cambia sola, con enfoque), nav propia.
   · Cierre con CTA directo al formulario de contacto.
   CONTENIDO PLACEHOLDER: reemplazar por testimonios reales.
   ============================================================ */
import T from './T.astro';

const items = [
  {
    quote: {
      es: 'Eve ordenó años de ideas sueltas en una identidad que por fin nos representa. El proceso fue tan claro como el resultado.',
      en: 'Eve turned years of loose ideas into an identity that finally represents us. The process was as clear as the result.',
    },
    who: 'Martina G.',
    role: { es: 'Fundadora — Café Tostado', en: 'Founder — Café Tostado' },
  },
  {
    quote: {
      es: 'Entendió el negocio antes que el brief. La identidad nueva nos abrió puertas: en dos meses duplicamos las consultas.',
      en: 'She understood the business before the brief. The new identity opened doors: inquiries doubled in two months.',
    },
    who: 'J. Pereyra',
    role: { es: 'Director — Estudio Pampa', en: 'Director — Estudio Pampa' },
  },
  {
    quote: {
      es: 'Criterio impecable, entregas puntuales y un ojo obsesivo por el detalle. Trabajar con ella es fácil y el resultado, elegante.',
      en: 'Impeccable judgment, on-time delivery and an obsessive eye for detail. Working with her is easy and the result, elegant.',
    },
    who: 'L. Sosa',
    role: { es: 'Coordinadora — Bienal BA', en: 'Coordinator — Bienal BA' },
  },
];
---

<section class="testi" id="testimonios" aria-label="Testimonios">
  <div class="wrap">
    <div class="ts-head">
      <p class="ts-kicker mono cap rise"><T es="Lo que dicen" en="What they say" /></p>
      <div class="ts-score" role="img" aria-label="Valoración 5 de 5 estrellas" data-score>
        <span class="ts-num" aria-hidden="true" data-count>5,0</span>
        <span class="ts-score-right">
          <span class="ts-stars big" aria-hidden="true"><i>★</i><i>★</i><i>★</i><i>★</i><i>★</i></span>
          <span class="ts-score-sub mono"><T es="Valoración de clientes · 2023–2025" en="Client rating · 2023–2025" /></span>
        </span>
      </div>
    </div>

    <div class="ts-stage" data-ts>
      <div class="ts-slides">
        {items.map((t, i) => (
          <figure class:list={['ts-slide', { 'is-on': i === 0 }]} data-ts-slide style={`--i:${i}`}>
            <blockquote class="ts-quote">
              <span data-es={`“${t.quote.es}”`} data-en={`“${t.quote.en}”`}>“{t.quote.es}”</span>
            </blockquote>
            <figcaption class="ts-who mono">
              <span class="ts-stars" aria-label="5 de 5 estrellas · 5 out of 5 stars"><i>★</i><i>★</i><i>★</i><i>★</i><i>★</i></span>
              <span>{t.who} · <span data-es={t.role.es} data-en={t.role.en}>{t.role.es}</span></span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="ts-nav" role="group" aria-label="Navegación de testimonios · Testimonials navigation">
        <button type="button" class="ts-btn" data-ts-prev aria-label="Anterior · Previous">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <span class="ts-mid">
          <p class="ts-count mono"><b data-ts-num>01</b> — {String(items.length).padStart(2, '0')}</p>
          <span class="ts-bar" aria-hidden="true"><i data-ts-bar></i></span>
        </span>
        <button type="button" class="ts-btn" data-ts-next aria-label="Siguiente · Next">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>

    <p class="ts-cta">
      <T es="¿Tu marca es la próxima?" en="Is your brand next?" />
      <a href="#contacto" data-open-contact>
        <T es="Escribime" en="Write me" />
      </a>
    </p>
  </div>
</section>

<style>
  .testi {
    padding-block: clamp(64px, 12vh, 150px) clamp(40px, 7vh, 90px);
    border-top: 1px solid var(--line);
  }

  /* ---------- cabecera: valoración protagonista ---------- */
  .ts-head {
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
    gap: 18px; margin-bottom: clamp(20px, 3.4vh, 40px);
  }
  .ts-kicker { color: var(--ink-45); display: block; }
  .ts-score { display: inline-flex; align-items: center; gap: 18px; }
  .ts-num { font-family: var(--serif); font-weight: 300; font-size: clamp(3rem, 6vw, 5rem); line-height: 0.9; letter-spacing: -0.03em; }
  .ts-score-right { display: grid; gap: 7px; }
  .ts-stars { color: var(--orange); font-size: 13px; letter-spacing: 5px; line-height: 1; }
  .ts-stars i, .ts-stars.big i { font-style: normal; display: inline-block; }
  .ts-stars.big { font-size: clamp(15px, 1.6vw, 19px); letter-spacing: 6px; }
  .ts-score-sub { color: var(--ink-45); font-size: 10px !important; letter-spacing: 0.1em; text-transform: uppercase; }

  /* ---------- una frase gigante por vez ---------- */
  .ts-stage { position: relative; padding-block: clamp(8px, 2vh, 24px) 0; }
  .ts-slides { position: relative; display: grid; min-height: clamp(260px, 38vh, 420px); align-items: center; }
  .ts-slide { --d: 0s; grid-area: 1 / 1; margin: 0; display: flex; flex-direction: column; align-items: center; text-align: center; gap: clamp(20px, 3.4vh, 36px); visibility: hidden; opacity: 0; }
  .ts-slide.is-on { visibility: visible; opacity: 1; }
  .ts-quote {
    position: relative; max-width: 30ch; margin-inline: auto;
    font-family: var(--serif); font-weight: 300;
    font-size: clamp(1.8rem, 4.4vw, 4rem); line-height: 1.12; letter-spacing: -0.025em;
    color: var(--ink); text-wrap: balance;
  }
  .ts-who { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 16px; color: var(--ink-45); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; }

  .ts-nav { display: flex; align-items: center; justify-content: center; gap: clamp(16px, 3vw, 36px); margin-top: clamp(24px, 4vh, 44px); }
  .ts-mid { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .ts-count { margin: 0; color: var(--ink-45); font-variant-numeric: tabular-nums; }
  .ts-count b { color: var(--ink); font-weight: 500; }
  .ts-bar { position: relative; display: block; width: clamp(90px, 14vw, 200px); height: 1px; background: var(--ink-18); overflow: hidden; }
  .ts-bar i { position: absolute; inset: 0; background: var(--ink); transform-origin: left center; transform: scaleX(var(--p, 0)); }
  .ts-arrows { display: inline-flex; gap: 10px; }
  .ts-btn {
    width: 44px; height: 44px; padding: 0; border: 1px solid var(--ink-35); border-radius: 50%;
    display: grid; place-items: center; color: var(--ink);
    transition: background var(--dur-micro) var(--ease-quint), color var(--dur-micro) var(--ease-quint), border-color var(--dur-micro) var(--ease-quint);
  }
  .ts-btn svg { display: block; }
  .ts-btn:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }


  /* ---------- cierre con CTA ---------- */
  .ts-cta {
    margin-top: clamp(40px, 7vh, 72px); text-align: center;
    font-family: var(--serif); font-weight: 300; font-size: clamp(1.15rem, 1.8vw, 1.6rem); letter-spacing: -0.01em; color: var(--ink-60);
    display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 10px 14px;
  }
  .ts-cta a { color: var(--ink); border-bottom: 1px solid var(--ink); padding-bottom: 2px; transition: opacity var(--dur-micro) var(--ease-quint); }
  .ts-cta a:hover { opacity: 0.65; }
  .ts-cta a span { display: inline-block; transition: transform var(--dur-ui) var(--ease-out); }
  .ts-cta a:hover span { transform: translateX(5px); }

  /* ---------- movimiento ---------- */
  @media (prefers-reduced-motion: no-preference) {
    /* la frase entra enfocándose y subiendo; la anterior se va hacia arriba, desenfocada */
    .ts-slide { transition: opacity 0.7s var(--ease-out), visibility 0s 0.7s; }
    .ts-slide .ts-quote { transform: translateY(26px); filter: blur(10px); transition: transform 1s var(--ease-out), filter 0.8s var(--ease-out); }
    .ts-slide .ts-who { opacity: 0; transform: translateY(14px); transition: opacity 0.7s var(--ease-out), transform 0.9s var(--ease-out); }
    .ts-slide.is-on { transition: opacity 0.6s var(--ease-out) 0.1s, visibility 0s; }
    .ts-slide.is-on .ts-quote { transform: none; filter: none; transition-delay: calc(0.1s + var(--d)); }
    .ts-slide.is-on .ts-who { opacity: 1; transform: none; transition-delay: calc(0.45s + var(--d)); }
    .ts-slide.is-out .ts-quote { transform: translateY(-22px); filter: blur(8px); }

    /* estrellas: se encienden de a una cuando la frase aparece */
    .ts-stars i { color: var(--ink-18); transform: translateY(6px) scale(0.5); }
    .ts-slide.is-on .ts-stars i {
      color: var(--orange); transform: none;
      transition: color 0.3s var(--ease-quint), transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
      transition-delay: calc(0.55s + var(--d) + var(--s) * 90ms);
    }
    .ts-score.in .ts-stars i { color: var(--orange); transform: none; transition: color 0.3s var(--ease-quint), transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); transition-delay: calc(0.35s + var(--s) * 110ms); }
    .ts-stars i:nth-child(1) { --s: 0; } .ts-stars i:nth-child(2) { --s: 1; } .ts-stars i:nth-child(3) { --s: 2; }
    .ts-stars i:nth-child(4) { --s: 3; } .ts-stars i:nth-child(5) { --s: 4; }

    .ts-cta { opacity: 0; transform: translateY(16px); transition: opacity 0.7s var(--ease-out) 0.2s, transform 0.7s var(--ease-out) 0.2s; }
    .ts-cta.in { opacity: 1; transform: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const score = document.querySelector<HTMLElement>('[data-score]');
  const cta = document.querySelector<HTMLElement>('.ts-cta');
  const num = document.querySelector<HTMLElement>('.ts-num[data-count]');

  /* ---------- 5,0 cuenta al aparecer ---------- */
  if (!reduce && 'IntersectionObserver' in window) {
    let raf = 0;
    const count = () => {
      if (!num) return;
      cancelAnimationFrame(raf);
      const t0 = performance.now(), D = 1300;
      const tick = (now: number) => {
        const p = Math.min(1, (now - t0) / D);
        num.textContent = (5 * (1 - Math.pow(1 - p, 3))).toFixed(1).replace('.', ',');
        if (p < 1) raf = requestAnimationFrame(tick);
      };
      num.textContent = '0,0';
      raf = requestAnimationFrame(tick);
    };
    const watch = (el: HTMLElement | null, onIn?: () => void) => {
      if (!el) return;
      new IntersectionObserver((es) => es.forEach((e) => {
        el.classList.toggle('in', e.isIntersecting);
        if (e.isIntersecting) onIn?.();
        else if (el === score && num) { cancelAnimationFrame(raf); num.textContent = '5,0'; }
      }), { threshold: 0.08, rootMargin: '0px 0px -6% 0px' }).observe(el);
    };
    watch(score, count); watch(cta);
  } else {
    score?.classList.add('in'); cta?.classList.add('in');
  }

  /* ---------- compu: las 3 se muestran juntas (aparecen escalonadas al entrar) · celu: una por vez, rota sola ---------- */
  const stage = document.querySelector<HTMLElement>('[data-ts]');
  const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-ts-slide]'));
  const numEl = document.querySelector<HTMLElement>('[data-ts-num]');
  const bar = document.querySelector<HTMLElement>('[data-ts-bar]');
  if (stage && slides.length) {
    const mq = { matches: false };               // siempre de a una, en compu, tablet y celu
    const N = slides.length, DUR = 7;
    let cur = 0, elapsed = 0, hovering = false, visible = false, raf = 0, last = 0, outT = 0;
    const setAll = (on: boolean) => slides.forEach((el) => { el.classList.toggle('is-on', on); el.classList.remove('is-out'); });
    const show = (i: number) => {
      const prev = cur; cur = (i + N) % N; elapsed = 0;
      slides.forEach((el, k) => {
        el.classList.toggle('is-on', k === cur);
        el.classList.toggle('is-out', k === prev && k !== cur);
      });
      clearTimeout(outT); outT = window.setTimeout(() => slides[prev]?.classList.remove('is-out'), 900);
      if (numEl) numEl.textContent = String(cur + 1).padStart(2, '0');
      bar?.style.setProperty('--p', '0');
    };
    const applyMode = () => {
      if (mq.matches) setAll(reduce || visible);        // compu: todas
      else { setAll(false); slides[cur].classList.add('is-on'); }   // celu: la actual
    };
    const frame = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000); last = now;
      if (!mq.matches && !hovering && visible && !reduce) {
        elapsed += dt;
        bar?.style.setProperty('--p', Math.min(1, elapsed / DUR).toFixed(4));
        if (elapsed >= DUR) show(cur + 1);
      }
      raf = requestAnimationFrame(frame);
    };
    new IntersectionObserver((es) => es.forEach((e) => {
      visible = e.isIntersecting;
      if (mq.matches && !reduce) setAll(visible);       // en compu entran al aparecer y se rearman al salir
    }), { threshold: 0.2 }).observe(stage);
    applyMode();
    stage.addEventListener('pointerenter', () => { hovering = true; });
    stage.addEventListener('pointerleave', () => { hovering = false; });
    stage.addEventListener('focusin', () => { hovering = true; });
    stage.addEventListener('focusout', () => { hovering = false; });
    document.querySelector('[data-ts-prev]')?.addEventListener('click', () => show(cur - 1));
    document.querySelector('[data-ts-next]')?.addEventListener('click', () => show(cur + 1));
    let x0 = 0;
    stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (mq.matches) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(cur + (dx < 0 ? 1 : -1));
    }, { passive: true });
    document.addEventListener('visibilitychange', () => { if (document.hidden) { cancelAnimationFrame(raf); raf = 0; } else if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); } });
    last = performance.now(); raf = requestAnimationFrame(frame);
  }
</script>
