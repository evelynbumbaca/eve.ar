---
/* ============================================================
   AboutMorph — Pantalla 2.
   La frase de presentación. "Eve" es un FANTASMA fuera del nodo
   i18n (el motor de idiomas reescribe textContent y borraría
   cualquier hijo), por eso vive aparte e invariante. El nombre
   gigante de la Pantalla 1 aterriza acá (morph por scroll).
   · enhanced: el fantasma está oculto hasta que el volador llega.
   · fallback: el fantasma es visible -> frase completa legible.
   ============================================================ */
import T from './T.astro';
import { link } from '../lib/link';
---

<section class="about-morph">
  <div class="wrap">
    <p class="am-kicker mono cap"><T es="Estudio" en="About" /></p>
    <p class="ha-lead" data-about-lead>
      <span class="ha-eve" data-name-ghost>Eve</span><span
        data-es=" es Diseñadora Multimedia & UX/UI radicada en Buenos Aires. Trabaja en la intersección entre lo editorial, la identidad de marca y el producto digital — con criterio, claridad y carácter."
        data-en=" is a Multimedia & UX/UI Designer based in Buenos Aires. She works at the intersection of editorial, brand identity and digital product — with judgment, clarity and character."
      > es Diseñadora Multimedia &amp; UX/UI radicada en Buenos Aires. Trabaja en la intersección entre lo editorial, la identidad de marca y el producto digital — con criterio, claridad y carácter.</span>
    </p>
    <a class="ha-link" href={link('/estudio')}>
      <T es="Conocé el enfoque" en="Read the approach" />
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .about-morph {
    padding-top: clamp(48px, 9vh, 120px);
    padding-bottom: clamp(40px, 9vh, 130px);
    background: var(--paper);
  }
  .am-kicker { color: var(--ink-45); margin-bottom: clamp(22px, 4vh, 40px); }

  .ha-lead {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.5rem, 3.4vw, 2.7rem);
    line-height: 1.28;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 26ch;
  }
  /* "Eve" comparte familia/peso de la frase; el volador hace crossfade al llegar */
  .ha-eve { white-space: nowrap; }
  :global(html.fx-on) .ha-eve { visibility: hidden; }

  .ha-link {
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    margin-top: clamp(26px, 4vh, 46px);
    font-family: var(--sans);
    font-size: clamp(14px, 1.1vw, 16px);
    letter-spacing: 0.02em;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 4px;
    transition: opacity var(--dur-micro) var(--ease-quint);
  }
  .ha-link span { transition: transform var(--dur-ui) var(--ease-out); display: inline-block; }
  .ha-link:hover { opacity: 0.62; }
  .ha-link:hover span { transform: translateX(6px); }
</style>
