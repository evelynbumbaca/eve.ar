---
import { site } from '../data/site';
import T from './T.astro';
---

<section class="hero" aria-label="Intro">
  <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>

  <div class="hero-inner">
    <p class="hero-kicker rise">
      <span>{site.name}</span>
      <span class="dot">·</span>
      <span><T es="Buenos Aires, Argentina" en="Buenos Aires, Argentina" /></span>
    </p>

    <h1 class="hero-title">
      <span class="line reveal"><span class="revfill" data-i18n="hero.title.1">Diseño</span></span>
      <span class="line reveal"><span class="revfill" data-i18n="hero.title.2">multimedia</span></span>
      <span class="line reveal"><span class="revfill accent" data-i18n="hero.title.3">que deja huella.</span></span>
    </h1>

    <p class="hero-sub rise rise-delay-2" data-i18n="hero.sub">
      Diseñadora Multimedia & UX/UI. Construyo identidades y experiencias con intención, claridad y carácter.
    </p>

    <a class="hero-scroll rise rise-delay-3" href="#trabajos">
      <span data-i18n="hero.scroll">Ver trabajos</span>
      <span class="arrow" aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(120px, 18vh, 220px) var(--pad) clamp(48px, 8vh, 96px);
    overflow: hidden;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: var(--maxw);
    margin-inline: auto;
    width: 100%;
  }

  .hero-kicker {
    display: flex;
    gap: 12px;
    align-items: center;
    font-family: var(--sans);
    font-size: var(--fs-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-60);
    margin-bottom: clamp(18px, 3vh, 30px);
  }
  .hero-kicker .dot { color: var(--ink-35); }

  .hero-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--fs-display);
    line-height: 0.94;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .hero-title .line { display: block; }
  .hero-title .revfill { display: block; }
  .hero-title .accent { font-style: italic; font-weight: 300; color: var(--ink-80); }

  /* stagger del reveal por mascara */
  .hero-title .line:nth-child(1) .revfill { transition-delay: 0.05s; }
  .hero-title .line:nth-child(2) .revfill { transition-delay: 0.16s; }
  .hero-title .line:nth-child(3) .revfill { transition-delay: 0.27s; }

  .hero-sub {
    margin-top: clamp(22px, 3.4vh, 36px);
    max-width: 46ch;
    font-family: var(--sans);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    line-height: 1.5;
    color: var(--ink-80);
  }

  .hero-scroll {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: clamp(30px, 5vh, 56px);
    font-family: var(--sans);
    font-size: var(--fs-small);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .hero-scroll .arrow {
    display: inline-block;
    transition: transform 0.4s var(--ease);
    animation: bob 2.4s var(--ease) infinite;
  }
  .hero-scroll:hover .arrow { transform: translateY(4px); }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll .arrow { animation: none; }
  }

  @media (max-width: 680px) {
    .hero { min-height: 86svh; }
    .hero-sub { font-size: 1rem; }
  }
</style>

<script>
  const canvas = document.querySelector('[data-hero-canvas]') as HTMLCanvasElement | null;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !reduce) {
    const ctx = canvas.getContext('2d')!;
    const hero = canvas.parentElement as HTMLElement;
    const INK = '22,21,15';
    const PAPER = '#faf9f5';

    let w = 0, h = 0, dpr = 1;
    let particles: { x: number; y: number; px: number; py: number; life: number }[] = [];
    let raf = 0;
    const mouse = { x: -9999, y: -9999, active: false };

    function seed() {
      const n = Math.round(Math.min(380, (w * h) / 3000));
      particles = Array.from({ length: n }, () => {
        const x = Math.random() * w, y = Math.random() * h;
        return { x, y, px: x, py: y, life: (Math.random() * 240) | 0 };
      });
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas!.getBoundingClientRect();
      w = r.width; h = r.height;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.fillStyle = PAPER;
      ctx.fillRect(0, 0, w, h);
      seed();
    }

    function flow(x: number, y: number, t: number) {
      const s = 0.0016;
      return (
        Math.sin(x * s + t * 0.0002) * 1.6 +
        Math.cos(y * s * 1.3 - t * 0.00015) * 1.6 +
        Math.sin((x + y) * s * 0.6) * 1.1
      );
    }

    function step(t: number) {
      // estela: velado tenue de papel
      ctx.fillStyle = 'rgba(250,249,245,0.045)';
      ctx.fillRect(0, 0, w, h);
      ctx.lineWidth = 0.7;
      ctx.strokeStyle = 'rgba(' + INK + ',0.15)';

      for (const p of particles) {
        let a = flow(p.x, p.y, t) * Math.PI;
        if (mouse.active) {
          const dx = p.x - mouse.x, dy = p.y - mouse.y, d2 = dx * dx + dy * dy;
          if (d2 < 26000) {
            const d = Math.sqrt(d2) || 1;
            a += Math.atan2(dy, dx) * 0.5 * (1 - d / 161);
          }
        }
        p.px = p.x; p.py = p.y;
        p.x += Math.cos(a) * 1.1;
        p.y += Math.sin(a) * 1.1;

        ctx.beginPath();
        ctx.moveTo(p.px, p.py);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();

        if (p.x < 0 || p.x > w || p.y < 0 || p.y > h || ++p.life > 280) {
          p.x = Math.random() * w; p.y = Math.random() * h;
          p.px = p.x; p.py = p.y; p.life = 0;
        }
      }
      raf = requestAnimationFrame(step);
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });
    hero.addEventListener('pointermove', (e) => {
      const r = canvas!.getBoundingClientRect();
      mouse.x = e.clientX - r.left;
      mouse.y = e.clientY - r.top;
      mouse.active = true;
    });
    hero.addEventListener('pointerleave', () => { mouse.active = false; });
    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) raf = requestAnimationFrame(step);
    });
    raf = requestAnimationFrame(step);
  }
</script>
