---
/* Árbol recursivo del mapa de arquitectura (casos). Los estilos son globales porque el
   componente se anida a sí mismo y se usa desde la página del caso. */
import type { TreeNode } from '../data/cases/types';
import CaseTree from './CaseTree.astro';

interface Props { nodes: TreeNode[] }
const { nodes } = Astro.props;
---
<ul class="lk-tl">
  {nodes.map((n) => (
    <li>
      <div class="lk-nd"><span data-es={n.es} data-en={n.en}>{n.es}</span></div>
      {n.kids && n.kids.length > 0 && <CaseTree nodes={n.kids} />}
    </li>
  ))}
</ul>

<style is:global>
  .lk-tl { list-style: none; margin: 12px 0 0 12px; padding: 0 0 0 14px; border-left: 2px solid rgba(206, 108, 63, 0.85); display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
  .lk-tl .lk-tl { margin-left: 4px; padding-left: 12px; }
  .lk-tl li { position: relative; min-width: 0; }
  .lk-tl li::before { content: ''; position: absolute; left: -14px; top: 20px; width: 14px; height: 2px; background: rgba(206, 108, 63, 0.85); }
  .lk-tl .lk-tl li::before { left: -12px; width: 12px; }
  .lk-nd { background: #fff; border: 1px solid rgba(22, 21, 15, 0.3); border-radius: 12px; padding: 9px 11px; font-family: var(--sans); font-size: var(--t-sm); line-height: 1.35; color: var(--lk-night, #1f0a0e); overflow-wrap: anywhere; min-width: 0; }
  .lk-nd.head { background: var(--lk-wine, #a92f3c); border-color: var(--lk-wine, #a92f3c); color: var(--lk-cream, #fff9ed); text-align: center; font-weight: 500; padding: 11px 8px; }
</style>
