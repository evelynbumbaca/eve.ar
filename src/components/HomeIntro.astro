---
/* ============================================================
   HomeIntro — portada del inicio.
   · Logo grande al centro + trabajos sueltos alrededor (parallax
     con el cursor). Con el scroll se juntan en una PILA y van
     pasando de a uno; cada tarjeta es un link al caso.
   · Primer scroll: el logo grande se contrae y se difumina en su
     lugar; recién cuando desapareció aparece el del menú, y después
     la frase. Un gesto = un paso (también en la pila).
   · Al terminar la pila, sigue la página normal.
   · Sin movimiento (reduced-motion): composición fija + lista.
   ============================================================ */
import { projects, social } from '../data/site';
import { link } from '../lib/link';
import LogoEve from './LogoEve.astro';

const works = projects.slice(0, 6);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="intro" data-banner data-intro style={`--n:${works.length}`}>
  <div class="stage" data-stage>
    <div class="bigs" aria-hidden="true">
      {works.map((p) => <p class="big" data-big>{p.title}</p>)}
    </div>
    {works.map((p, i) => (
      <a class="card" href={link(`/trabajos/${p.id}`)} data-card>
        {p.heroLoop && (
          <video muted loop playsinline preload="none" aria-hidden="true">
            <source src={`${base}/${p.heroLoop.webm}`} type="video/webm" />
            <source src={`${base}/${p.heroLoop.mp4}`} type="video/mp4" />
          </video>
        )}
        {p.hero
          ? <img src={`${base}/${p.hero}`} alt="" loading="eager" decoding="async" />
          : (
            <span class="ficha">
              <span class="f-idx mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="f-title">{p.title}</span>
            </span>
          )}
        <span class:list={['ccap', { 'on-photo': !!p.hero }]}>
          <span class="ccap-t">
            {p.hero && <b>{p.title}</b>}
            <span class="ccap-m"><span data-es={p.disc.es} data-en={p.disc.en}>{p.disc.es}</span> · {p.year}</span>
          </span>
          <i><span data-es="Ver caso de estudio" data-en="View case study">Ver caso de estudio</span> →</i>
        </span>
      </a>
    ))}

    <div class="statement" data-statement>
      <p data-es="Diseñadora multimedia & UX/UI especializada en motion. Diseño identidades y experiencias con intención, claridad y carácter."
         data-en="Multimedia & UX/UI designer specialized in motion. I design identities and experiences with intent, clarity and character."
      >Diseñadora multimedia &amp; UX/UI especializada en motion. Diseño identidades y experiencias con intención, claridad y carácter.</p>
    </div>

    <div class="center">
      <h1 class="bn-name-slot" aria-label="eve" data-eve><LogoEve /></h1>
    </div>

    <p class="meta m-bl mono" data-intro-role data-es="Diseñadora multimedia & UX/UI · motion" data-en="Multimedia & UX/UI designer · motion">Diseñadora multimedia &amp; UX/UI · motion</p>
    <p class="meta m-bl m-count mono" data-intro-count><span data-es="Caso de estudio" data-en="Case study">Caso de estudio</span> <b data-intro-num>01</b> — {String(works.length).padStart(2, '0')}</p>
  </div>
</section>

<section class="hi-after" id="trabajos">
  <div class="wrap hi-wrap">
    <p class="hi-lead"
      data-es="Diseñadora multimedia & UX/UI especializada en motion. Diseño identidades y experiencias con intención, claridad y carácter."
      data-en="Multimedia & UX/UI designer specialized in motion. I design identities and experiences with intent, clarity and character."
    >Diseñadora multimedia &amp; UX/UI especializada en motion. Diseño identidades y experiencias con intención, claridad y carácter.</p>

    <ol class="hi-works rise rise-delay-1">
      {works.map((p, i) => (
        <li>
          <a href={link(`/trabajos/${p.id}`)}>
            <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
            <b>{p.title}</b>
            <span class="d mono"><span data-es={p.disc.es} data-en={p.disc.en}>{p.disc.es}</span> · {p.year}</span>
          </a>
        </li>
      ))}
    </ol>

    <div class="hi-foot" data-foot>
      <nav class="hi-social" aria-label="Redes">
        {social.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
      </nav>
      <a class="hi-all" href={link('/trabajos')}>
        <span data-es="Ver todos los casos de estudio" data-en="See all case studies">Ver todos los casos de estudio</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* altura del tramo: llegada (1 pantalla) + 0,75 por trabajo + colchón */
  .intro { position: relative; height: calc((var(--n) * 0.75 + 2.35) * 100svh); --cw: 320px; }
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }

  .bigs { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .big {
    position: absolute; left: 50%; top: 50%; margin: 0; width: max-content; white-space: nowrap;
    font-family: var(--serif); font-weight: 300; font-size: clamp(5rem, 15vw, 15rem); line-height: 1;
    letter-spacing: -0.045em; color: rgba(22, 21, 15, 0.1); opacity: 0; will-change: transform, opacity;
  }
  /* texto fantasma: casi invisible, solo se descubre donde pasa la luz del cursor */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .big {
      --bx: -9999px; --by: -9999px; --br: 0px; --ghost: rgba(22, 21, 15, 0.045);
      color: var(--ghost);
      background-image: radial-gradient(circle var(--br) at var(--bx) var(--by), #fffdf9 0%, rgba(250, 246, 240, 0.92) 40%, var(--ghost) 100%);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }
  .statement {
    position: absolute; inset: 0; z-index: 60; display: grid; place-items: center; padding-inline: var(--pad);
    opacity: 0; pointer-events: none; will-change: transform, opacity;
  }
  .statement p {
    margin: 0; max-width: min(27ch, 88%); text-align: center; text-wrap: balance;
    font-family: var(--serif); font-weight: 300; font-size: clamp(1.2rem, 2.1vw, 2rem); line-height: 1.2; letter-spacing: -0.02em; color: var(--ink);
  }
  .center { position: absolute; inset: 0; z-index: 60; display: grid; place-items: center; pointer-events: none; }
  .bn-name-slot { margin: 0; }
  .bn-name-slot :global(svg) {
    display: block; height: clamp(58px, 11.5vw, 184px); width: auto; color: var(--ink); overflow: visible;
  }
  .bn-name-slot :global(.ltr) { transform-box: fill-box; transform-origin: 50% 62%; }

  /* ---------- tarjetas ---------- */
  .card {
    position: absolute; left: 50%; top: 50%; width: var(--cw); aspect-ratio: 4 / 5;
    margin: calc(var(--cw) * -0.625) 0 0 calc(var(--cw) * -0.5);
    display: block; overflow: hidden; border-radius: 4px; color: #fff; background: #e9e4d9;
    will-change: transform, opacity;
    box-shadow: 0 1px 2px rgba(22, 21, 15, 0.14), 0 22px 50px -16px rgba(22, 21, 15, 0.4);
  }
  .card video { position: absolute; inset: 0; z-index: 1; opacity: 0; transition: opacity 0.45s var(--ease-out, ease); pointer-events: none; }
  .card.playing video { opacity: 1; }
  .card img, .card video { display: block; width: 100%; height: 100%; object-fit: cover; transform: translate3d(var(--ix, 0px), var(--iy, 0px), 0) scale(var(--is, 1.08)); will-change: transform; }
  .card::after { content: ''; position: absolute; inset: 0; z-index: 2; background: var(--paper); opacity: var(--dim, 0); pointer-events: none; }
  .card:focus-visible { outline: 2px solid var(--orange); outline-offset: 4px; }

  .ficha {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-start; gap: clamp(8px, 1.4vw, 16px);
    padding: clamp(14px, 2.2vw, 26px); background: #efece4; box-shadow: inset 0 0 0 1px var(--ink-12);
  }
  .f-idx { color: var(--ink-35); }
  .f-title { font-family: var(--serif); font-size: clamp(1.5rem, 3.4vw, 2.8rem); line-height: 1.04; letter-spacing: -0.015em; color: var(--ink); }

  .ccap {
    position: absolute; inset: auto 0 0 0; display: flex; align-items: flex-end; justify-content: space-between; gap: 6px 16px;
    padding: clamp(10px, 1.6vw, 20px); opacity: var(--cap, 0); color: var(--ink); z-index: 3;
  }
  .ccap.on-photo { padding-top: clamp(28px, 5vw, 56px); color: #fff; background: linear-gradient(to top, rgba(14, 13, 10, 0.74), rgba(14, 13, 10, 0)); }
  .ccap b { display: block; font-family: var(--serif); font-weight: 400; font-size: clamp(1.35rem, 3.1vw, 2.5rem); line-height: 1.04; letter-spacing: -0.015em; }
  .ccap-m { display: block; margin-top: 6px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.8; }
  .ccap:not(.on-photo) .ccap-m { margin-top: 0; }
  .ccap i { font: 500 0.8125rem var(--sans); font-style: normal; white-space: nowrap; border-bottom: 1px solid currentColor; padding-bottom: 2px; }

  /* ---------- meta ---------- */
  .meta {
    position: absolute; z-index: 61; color: var(--ink-60); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    will-change: opacity; pointer-events: none;
  }
  .m-bl { left: var(--pad); bottom: clamp(18px, 3.4vh, 34px); max-width: 62vw; }
  .m-count { opacity: 0; color: var(--ink); font-variant-numeric: tabular-nums; }
  .m-count b { font-weight: 500; }
  @media (prefers-reduced-motion: no-preference) {
      @keyframes cue { 0%, 100% { transform: scaleY(0.35); opacity: 0.4; } 50% { transform: scaleY(1); opacity: 1; } }
  }

  /* ---------- lo que sigue ---------- */
  .hi-after { padding-block: clamp(20px, 3vh, 32px) clamp(40px, 8vh, 100px); }
  :global(html.intro-static) .hi-after { padding-top: clamp(48px, 10vh, 120px); }
  .hi-wrap { display: grid; gap: clamp(32px, 6vh, 64px); }
  .hi-lead { display: none;
   
    font-family: var(--serif); font-weight: 300; font-size: clamp(1.5rem, 3.4vw, 2.9rem);
    line-height: 1.14; letter-spacing: -0.02em; max-width: 26ch; text-wrap: balance; color: var(--ink);
  }
  .hi-works { display: none; list-style: none; border-top: 1px solid var(--line); }
  .hi-works li { border-bottom: 1px solid var(--line); }
  .hi-works a { display: grid; grid-template-columns: 3ch minmax(0, 1fr) auto; align-items: baseline; gap: 4px 18px; padding-block: 16px; }
  .hi-works b { font-family: var(--serif); font-weight: 400; font-size: clamp(1.3rem, 2.6vw, 2rem); }
  .hi-works .n, .hi-works .d { color: var(--ink-45); text-transform: uppercase; }
  .hi-foot { position: relative; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 14px 24px; padding-top: 18px; }
  /* la línea va de borde a borde de la pantalla */
  .hi-foot::before {
    content: ''; position: absolute; top: 0; left: calc(50% - 50vw); width: 100vw; height: 1px;
    background: var(--line); transform-origin: left center;
  }
  .hi-social { display: flex; flex-wrap: wrap; gap: 18px; }
  .hi-social a { font-size: var(--fs-small); color: var(--ink-60); transition: color var(--dur-micro) var(--ease-quint); }
  .hi-social a:hover { color: var(--ink); }
  .hi-all {
    display: inline-flex; align-items: baseline; gap: 10px; font-weight: 500; font-size: clamp(1rem, 1.3vw, 1.25rem);
    border-bottom: 1px solid var(--ink-35); padding-bottom: 3px;
    transition: border-color var(--dur-micro) var(--ease-quint), opacity var(--dur-micro) var(--ease-quint);
  }
  .hi-all:hover { opacity: 0.7; border-color: var(--ink); }
  .hi-all span[aria-hidden] { transition: transform var(--dur-ui) var(--ease-out); display: inline-block; }
  .hi-all:hover span[aria-hidden] { transform: translateX(5px); }

  /* entra justo después del último caso: se dibuja la línea, suben los links y la flecha señala en loop */
  @media (prefers-reduced-motion: no-preference) {
    .hi-foot::before { transform: scaleX(0); transition: transform 1.1s var(--ease-out); }
    .hi-foot > * { opacity: 0; transform: translateY(12px); transition: opacity 0.6s var(--ease-out), transform 0.7s var(--ease-out); }
    .hi-foot.in::before { transform: none; }
    .hi-foot.in > * { opacity: 1; transform: none; transition-delay: 0.3s; }
    .hi-foot.in > :last-child { transition-delay: 0.42s; }
    .hi-foot.in .hi-all span[aria-hidden] { animation: nudge 1.4s ease-in-out 1s infinite; }
    .hi-all:hover span[aria-hidden] { animation-duration: 0.7s; }
    @keyframes nudge { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(8px); } }
  }

  @media (max-width: 700px) {
    .ccap i { display: none; }
    .hi-works a { grid-template-columns: 3ch minmax(0, 1fr); }
    .hi-works .d { grid-column: 2; }
  }

  /* sin movimiento: portada fija (tarjetas sueltas) y los trabajos como lista */
  :global(html.intro-static) .intro { height: 100svh; }
  :global(html.intro-static) .stage { position: relative; }
  :global(html.intro-static) .bigs
  :global(html.intro-static) .hi-works { display: block; }
  :global(html.intro-static) .hi-lead { display: block; }
  :global(html.intro-static) .statement { display: none; }
</style>

<script>
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const roleEl = document.querySelector<HTMLElement>('[data-intro-role]');
  const countEl = document.querySelector<HTMLElement>('[data-intro-count]');
  const numEl = document.querySelector<HTMLElement>('[data-intro-num]');
  const stmt = document.querySelector<HTMLElement>('[data-statement]');
  const eve = document.querySelector<HTMLElement>('[data-eve]');
  const mark = document.querySelector<HTMLElement>('[data-name-target]');
  const letters = eve ? Array.from(eve.querySelectorAll<SVGGElement>('.ltr')) : [];
  const footEl = document.querySelector<HTMLElement>('[data-foot]');
  const bigs = Array.from(document.querySelectorAll<HTMLElement>('[data-big]'));

  /* videos de las tarjetas: se reproducen al frente de la pila o con el mouse encima.
     preload="none": no se descargan hasta que van a sonar. */
  const vids = cards.map((c) => c.querySelector<HTMLVideoElement>('video'));
  const vOn = cards.map(() => false);
  let hoverIdx = -1, frontIdx = -1, stackOn = false;
  const touchOnly = !matchMedia('(hover: hover)').matches;
  const setVid = (i: number, on: boolean) => {
    const v = vids[i];
    if (!v || vOn[i] === on) return;
    vOn[i] = on;
    if (on) {
      v.preload = 'auto';
      const pr = v.play();
      const show = () => { if (vOn[i]) cards[i].classList.add('playing'); };
      if (pr) pr.then(show).catch(() => { vOn[i] = false; }); else show();
    } else {
      cards[i].classList.remove('playing');
      v.pause();
    }
  };
  /* solo con la pila armada (no en la escena suelta): la tarjeta de adelante, al pasar el mouse;
     en pantallas táctiles, la de adelante directamente */
  const syncVids = () => vids.forEach((v, i) => { if (v) setVid(i, stackOn && i === frontIdx && (touchOnly || i === hoverIdx)); });
  cards.forEach((c, i) => {
    if (!vids[i]) return;
    c.addEventListener('mouseenter', () => { hoverIdx = i; syncVids(); });
    c.addEventListener('mouseleave', () => { if (hoverIdx === i) hoverIdx = -1; syncVids(); });
  });

  if (footEl) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) footEl.classList.add('in');
    else new IntersectionObserver((es) => es.forEach((e) => footEl.classList.toggle('in', e.isIntersecting)), { threshold: 0.6 }).observe(footEl);
  }

  if (intro && stage && cards.length) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const N = cards.length;
    const GS = 1.15;                 // empiezan a juntarse (después de la frase)
    const GATHER = GS + 0.9, STEP = 0.75;

    // posición suelta de cada pieza (fracción del escenario desde el centro), escala, giro y profundidad
    const loose = [
      { fx: -0.34, fy: -0.20, s: 0.40, rot: -4, depth: 0.35 },
      { fx:  0.33, fy: -0.22, s: 0.44, rot:  3, depth: 0.80 },
      { fx:  0.30, fy:  0.26, s: 0.36, rot: -2, depth: 1.25 },
      { fx: -0.30, fy:  0.28, s: 0.36, rot:  5, depth: 0.60 },
      { fx: -0.08, fy:  0.36, s: 0.30, rot: -6, depth: 1.00 },
      { fx:  0.08, fy: -0.36, s: 0.30, rot:  4, depth: 0.50 },
    ];

    let W = 0, H = 0, ch = 0, lastNum = 0, exW = 0, exH = 0;
    const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
    const smooth = (t: number) => t * t * (3 - 2 * t);
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
    let opening = 0;                  // 0 = logo grande · 1 = logo en el menú y frase visible
    const mix = (a: number, b: number, t: number) => a + (b - a) * t;

    /* escena suelta: cada tarjeta parte de su lugar en `loose` y se separa de las demás y del logo
       hasta que no se pisan (con aire entre medio). Se calcula al medir, no en cada cuadro. */
    const loosePos: { x: number; y: number; s: number }[] = [];
    const layLoose = () => {
      const SAFE_TOP = 104, SAFE_BOT = 92, PAR = 34, GAP = 30;
      const k = 0.82 * Math.min(1, Math.max(W * 0.55, 300) / ch, H * 0.62 / ch);
      const P = cards.map((_, i) => { const L = loose[i % loose.length]; return { x: L.fx * W, y: L.fy * H, s: L.s * k }; });
      const half = (p: { s: number }) => { const hh = p.s * ch / 2; return [hh * 0.8 + 8, hh + 8]; }; // +8: el giro
      const clampP = (p: { x: number; y: number; s: number }) => {
        const [hw, hh] = half(p);
        const bx = W / 2 - hw - 12 - PAR, by0 = -H / 2 + SAFE_TOP + hh + PAR, by1 = H / 2 - SAFE_BOT - hh - PAR;
        p.x = Math.max(-bx, Math.min(bx, p.x));
        p.y = by0 > by1 ? (by0 + by1) / 2 : Math.max(by0, Math.min(by1, p.y));
      };
      const sgn = (v: number) => (v < 0 ? -1 : 1);
      for (let it = 0; it < 400; it++) {
        let moved = false;
        for (let i = 0; i < P.length; i++) {
          const a = P[i], [aw, ah] = half(a);
          const ox = exW + aw - Math.abs(a.x), oy = exH + ah - Math.abs(a.y);
          if (ox > 0 && oy > 0) { moved = true; if (ox < oy) a.x += sgn(a.x) * ox; else a.y += sgn(a.y) * oy; }
          for (let j = i + 1; j < P.length; j++) {
            const b = P[j], [bw, bh] = half(b), dx = b.x - a.x, dy = b.y - a.y;
            const px = aw + bw + GAP - Math.abs(dx), py = ah + bh + GAP - Math.abs(dy);
            if (px > 0 && py > 0) {
              moved = true;
              if (px < py) { a.x -= sgn(dx) * px / 2; b.x += sgn(dx) * px / 2; }
              else { a.y -= sgn(dy) * py / 2; b.y += sgn(dy) * py / 2; }
            }
          }
          clampP(a);
        }
        if (!moved) break;
        if (it % 50 === 49) P.forEach((p) => { p.s *= 0.95; });   // si no entran, se achican un poco
      }
      P.forEach((p, i) => { loosePos[i] = p; });
    };

    const measure = () => {
      W = stage.clientWidth; H = stage.clientHeight;
      // tarjetas verticales (4:5): el alto manda, y nunca más anchas que la pantalla
      ch = Math.min(H * 0.72, W * 0.86 * 5 / 4, 620);
      const cw = ch * 0.8;
      intro.style.setProperty('--cw', cw.toFixed(1) + 'px');
      // zona libre alrededor del logo y de la frase (con aire), para que las tarjetas sueltas no los pisen
      const sp = stmt ? stmt.querySelector('p') : null;
      exW = Math.max(eve ? eve.offsetWidth : 0, sp ? sp.offsetWidth : 0) / 2 + 56;
      exH = Math.max(eve ? eve.offsetHeight : 0, sp ? sp.offsetHeight : 0) / 2 + 56;
      // cada título se ajusta para ocupar todo el ancho (asoma siempre a los costados de la tarjeta)
      bigs.forEach((el) => {
        el.style.fontSize = '100px';
        const w100 = el.offsetWidth || 1;
        el.style.fontSize = Math.min((W * 1.02 / w100) * 100, H * 0.5).toFixed(1) + 'px';
      });
      layLoose();
    };

    // Objetivos según el scroll (sin suavizar). El suavizado va en el tiempo (frame), así cada
    // gesto empuja rápido al principio y se acomoda despacio, igual hacia arriba que hacia abajo.
    const gatherTarget = (u: number) => clamp01((u - GS) / 0.9);
    const cardTarget = (u: number) => {
      const q = Math.max(0, Math.min(N - 1, (u - GATHER) / STEP));
      const fi = Math.floor(q);
      return fi + clamp01((q - fi - 0.12) / 0.5);   // cada tarjeta descansa un rato al frente
    };

    // u = scroll en alturas de pantalla; gd = avance de la pila; q2 = tarjeta al frente; sx, sy = puntero (-1..1)
    const render = (u: number, gd: number, q2: number, sx: number, sy: number) => {
      const g = gd * gd * (3 - 2 * gd) * 0.35 + gd * 0.65;  // casi lineal: la respuesta la da el tiempo
      if (stmt) {                     // la frase entra cuando el logo ya se fue, y se va antes de que se junten
        const si = easeOut(clamp01((opening - 0.45) / 0.55)), so = smooth(clamp01((u - 0.95) / 0.3));
        stmt.style.opacity = (si * (1 - so)).toFixed(3);
        stmt.style.transform = `translate3d(0,${((1 - si) * 30 - so * 28).toFixed(1)}px,0)`;
      }
      const behind = Math.max(0, Math.min(4, N - 1 - q2));
      const front = ch * 0.0425 * behind - H * 0.015;      // la pila se recentra sola

      for (let i = 0; i < N; i++) {
        const L = loose[i % loose.length];
        const r = i - q2;
        let X: number, Y: number, S: number, R: number, O: number, dim: number, cap: number;
        const w = clamp01(1 - Math.abs(r) * 2.2); // peso del proyecto que está al frente
        if (r >= 0) {            // en la pila: más atrás = más chica, más arriba, más velada
          X = -sx * r * 7; Y = front - r * ch * 0.13 - sy * r * 4;
          S = Math.max(0.5, 1 - 0.09 * r); R = 0;
          O = 1 - clamp01(r - 3.6); dim = Math.min(0.55, r * 0.13); cap = clamp01(1 - r * 2.2);
        } else {                 // saliendo: cae hacia adelante y se va
          const t = -r, dir = i % 2 ? 1 : -1;      // pasa por delante de cámara, alternando lado
          X = dir * t * W * 0.16; Y = front - t * H * 0.16; S = 1 + 0.55 * t; R = dir * t * 7;
          O = 1 - clamp01((t - 0.12) / 0.5); dim = 0; cap = 1 - clamp01(t * 2.4);
        }
        // escena suelta: posición ya repartida sin superposiciones (layLoose)
        const lp = loosePos[i] || { x: 0, y: 0, s: 0.3 };
        const ls = lp.s, lx = lp.x, ly = lp.y;
        const x = mix(lx - sx * L.depth * 30, X, g);
        const y = mix(ly - sy * L.depth * 30, Y, g);
        const s = mix(ls, S, g), rot = mix(L.rot, R, g), o = mix(1, O, g);
        const el = cards[i];
        const tx = sy * -7 * w * g, ty = sx * 9 * w * g;       // inclinación 3D con el cursor
        el.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0) perspective(1200px) rotateX(${tx.toFixed(2)}deg) rotateY(${ty.toFixed(2)}deg) rotate(${rot.toFixed(2)}deg) scale(${s.toFixed(4)})`;
        el.style.setProperty('--ix', (-sx * 22 * w * g + (r < 0 ? -r * 40 * (i % 2 ? 1 : -1) : 0)).toFixed(1) + 'px');
        el.style.setProperty('--iy', (-sy * 16 * w * g).toFixed(1) + 'px');
        el.style.setProperty('--is', (1.08 + 0.08 * (1 - w) * g + (r < 0 ? -r * 0.18 : 0)).toFixed(3));
        el.style.opacity = o.toFixed(3);
        el.style.zIndex = String(50 - Math.round(r * 10));
        el.style.pointerEvents = o < 0.3 ? 'none' : 'auto';
        el.style.setProperty('--dim', (dim * g).toFixed(3));
        el.style.setProperty('--cap', (cap * clamp01((g - 0.7) / 0.3)).toFixed(3));
      }

      // títulos gigantes: entran de un lado, cruzan por detrás de la tarjeta y salen por el otro
      for (let i = 0; i < N; i++) {
        const r = i - q2, a = Math.abs(r);
        const el = bigs[i];
        el.style.opacity = (clamp01(1 - a * 1.15) * 0.92 * clamp01((g - 0.6) / 0.4)).toFixed(3);
        el.style.transform = `translate(calc(-50% + ${(r * W * 0.62 - sx * 24).toFixed(1)}px), -50%)`;
      }
      if (roleEl) roleEl.style.opacity = (1 - clamp01(opening / 0.3)).toFixed(3);
      if (countEl) countEl.style.opacity = clamp01((g - 0.7) / 0.3).toFixed(3);
      const fi = Math.round(q2), fr = g > 0.85 && Math.abs(fi - q2) < 0.3 ? fi : -1;
      const so = g > 0.85;
      if (fr !== frontIdx || so !== stackOn) { frontIdx = fr; stackOn = so; syncVids(); }
      const n = Math.min(N, Math.round(q2) + 1);
      if (n !== lastNum && numEl) { lastNum = n; numEl.textContent = (n < 10 ? '0' : '') + n; }
    };

    if (reduce) {
      document.documentElement.classList.add('intro-static');
      measure(); render(0, 0, 0, 0, 0);
      addEventListener('resize', () => { measure(); render(0, 0, 0, 0, 0); }, { passive: true });
    } else {
      let mx = 0, my = 0, sx = 0, sy = 0, su = 0, gd = 0, qd = 0, raf = 0, running = false, last = 0;
      let op = 0, px = -1e5, py = -1e5;
      const OPEN_DUR = 0.85;                       // segundos que dura la apertura completa
      const openTarget = (u: number) => (u > 0.4 ? 1 : 0);
      const lsx = letters.map(() => 1), lcx: number[] = [], lcy: number[] = [];

      const renderOpen = () => {
        const e = easeOut(clamp01(op / 0.4));      // el logo se contrae y se difumina en su lugar
        if (eve) {
          if (e < 0.001) { eve.style.opacity = ''; eve.style.transform = ''; eve.style.filter = ''; eve.style.visibility = ''; }
          else {
            // se desvanece más rápido de lo que se difumina, y al terminar se oculta del todo (sin restos borrosos)
            const fade = clamp01(e * 1.8);
            eve.style.opacity = (1 - fade).toFixed(3);
            eve.style.transform = `scale(${(1 - 0.3 * e).toFixed(4)})`;
            if (fade >= 0.999) { eve.style.filter = ''; eve.style.visibility = 'hidden'; }
            else { eve.style.filter = `blur(${(10 * e).toFixed(2)}px)`; eve.style.visibility = ''; }
          }
        }
        const w = easeOut(clamp01((op - 0.42) / 0.26)); // el del menú aparece recién cuando el grande ya no está
        if (mark) {
          mark.style.opacity = w.toFixed(3);
          mark.style.filter = w > 0.999 || w < 0.001 ? '' : `blur(${(5 * (1 - w)).toFixed(2)}px)`;
        }
      };
      const measureLetters = () => {
        if (op > 0.01) return;
        letters.forEach((l, i) => { const r = l.getBoundingClientRect(); lcx[i] = r.left + r.width / 2; lcy[i] = r.top + r.height / 2; });
      };
      const scrollU = () => Math.max(0, (scrollY - intro.offsetTop) / (H || 1));
      // acercamiento exponencial: máxima velocidad al arrancar, frena suave al llegar (independiente de los Hz)
      const k = (rate: number, dt: number) => 1 - Math.exp(-rate * dt);

      // la luz que descubre los títulos gigantes (texto fantasma): sigue al cursor con inercia
      let bx = -1e5, by = -1e5, la = 0, lightBusy = false;
      const paintLight = (dt: number) => {
        if (!fine) return;
        const on = px > -9e4;
        if (on && bx < -9e4) { bx = px; by = py; }
        if (on) { bx += (px - bx) * k(9, dt); by += (py - by) * k(9, dt); }
        la += ((on ? 1 : 0) - la) * k(8, dt);
        lightBusy = (on && Math.hypot(px - bx, py - by) > 0.4) || Math.abs((on ? 1 : 0) - la) > 0.004;
        const R = (300 * la).toFixed(1) + 'px';
        for (const el of bigs) {
          if (parseFloat(el.style.opacity || '0') < 0.01) continue;
          const r = el.getBoundingClientRect();
          el.style.setProperty('--bx', (bx - r.left).toFixed(1) + 'px');
          el.style.setProperty('--by', (by - r.top).toFixed(1) + 'px');
          el.style.setProperty('--br', R);
        }
      };

      const frame = (now: number) => {
        const dt = Math.min(0.05, Math.max(0.001, (now - last) / 1000)); last = now;
        const u = scrollU();
        const ot = openTarget(u);
        op += Math.sign(ot - op) * Math.min(Math.abs(ot - op), dt / OPEN_DUR);
        opening = op;
        su += (u - su) * k(9, dt);
        gd += (gatherTarget(u) - gd) * k(6, dt);
        qd += (cardTarget(u) - qd) * k(6.5, dt);
        sx += (mx - sx) * k(5, dt); sy += (my - sy) * k(5, dt);
        renderOpen();
        render(su, gd, qd, sx, sy);
        paintLight(dt);
        // letras del logo: se estiran cerca del cursor (solo con puntero fino y el logo en reposo)
        let lettersMoving = false;
        if (fine && letters.length) {
          const active = op < 0.02 && lcx.length === letters.length;
          letters.forEach((l, i) => {
            let tg = 1;
            if (active) tg = 1 + 0.12 * smooth(clamp01(1 - Math.hypot(px - lcx[i], py - lcy[i]) / 300));
            lsx[i] += (tg - lsx[i]) * k(10, dt);
            if (Math.abs(tg - lsx[i]) > 0.002) lettersMoving = true;
            l.style.transform = `scaleX(${lsx[i].toFixed(4)})`;
          });
        }
        const moving = Math.abs(ot - op) > 0.0005 || lettersMoving || lightBusy || Math.abs(u - su) > 0.0008 || Math.abs(gatherTarget(u) - gd) > 0.0008 || Math.abs(cardTarget(u) - qd) > 0.0008 ||
                       Math.abs(mx - sx) > 0.002 || Math.abs(my - sy) > 0.002;
        if (moving) raf = requestAnimationFrame(frame); else running = false;
      };
      const kick = () => { if (!running) { running = true; last = performance.now(); raf = requestAnimationFrame(frame); } };

      if (fine) {
        stage.addEventListener('pointermove', (ev) => {
          const b = stage.getBoundingClientRect();
          mx = ((ev.clientX - b.left) / b.width) * 2 - 1;
          my = ((ev.clientY - b.top) / b.height) * 2 - 1;
          px = ev.clientX; py = ev.clientY;
          kick();
        }, { passive: true });
        stage.addEventListener('pointerleave', () => { mx = 0; my = 0; px = py = -1e5; kick(); }, { passive: true });
      }
      /* ---------- pasador: un gesto = un paso ----------
         Paradas: arriba de todo, la frase de presentación y cada proyecto al frente. Dentro de esa zona,
         cada gesto (rueda, trackpad, deslizar, teclado) salta a la parada siguiente; la
         animación la hace el suavizado en el tiempo. En los extremos, el scroll sigue normal. */
      const STMT_REST = 0.82;
      const ZONE_LO = 0;
      const uMax = () => intro.offsetHeight / (H || 1) - 1;
      // parada final: la página sube lo justo para que la fila de abajo quede a la vista
      const afterRest = () => {
        if (!footEl) return uMax();
        const bottom = footEl.getBoundingClientRect().bottom + scrollY;
        return Math.max(uMax() + 0.05, (bottom - 0.94 * H - intro.offsetTop) / (H || 1));
      };
      const rests = () => [0, STMT_REST, ...cards.map((_, i) => GATHER + (i + 0.02) * STEP), afterRest()];
      const inZone = (u: number) => u >= ZONE_LO && u <= afterRest() + 0.05;
      const nextRest = (u: number, dir: number) => {
        const r = rests(), eps = 0.02;
        if (dir > 0) { for (const x of r) if (x > u + eps) return x; }
        else { for (let i = r.length - 1; i >= 0; i--) if (r[i] < u - eps) return r[i]; }
        return null;
      };
      const jumpTo = (u: number) => {
        // dentro de la portada el salto es instantáneo (anima el suavizado); fuera, desliza la página
        const glide = Math.max(u, scrollU()) > uMax() + 0.001;
        scrollTo({ top: Math.round(intro.offsetTop + u * H), behavior: (glide ? 'smooth' : 'instant') as ScrollBehavior });
        kick();
      };

      // rueda y trackpad: la inercia de un mismo gesto no avanza más de un paso
      // Un gesto = un paso. La inercia del trackpad (Mac) sigue mandando eventos más de un segundo,
      // a veces con repuntes: no cuentan como gesto nuevo. Gesto nuevo = una pausa real (>220 ms),
      // un cambio de sentido, o un empujón claramente más fuerte que lo que venía llegando.
      let locked = false, lockT = 0, lastT = 0, lastSign = 0;
      const recent: number[] = [];
      addEventListener('wheel', (e) => {
        if (e.ctrlKey || e.deltaY === 0 || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
        const now = performance.now(), abs = Math.abs(e.deltaY), sign = e.deltaY > 0 ? 1 : -1;
        const gap = now - lastT, since = now - lockT;
        if (gap > 220) recent.length = 0;
        const avg = recent.length ? recent.reduce((x, y) => x + y, 0) / recent.length : 0;
        recent.push(abs); if (recent.length > 6) recent.shift();
        const fresh = (sign !== lastSign && since > 250) ||
          (since > 480 && (gap > 220 || (since > 750 && avg > 0 && abs > avg * 2.5 && abs > 10)));
        lastT = now; lastSign = sign;
        const u = scrollU();
        if (!inZone(u)) { locked = false; return; }
        if (locked && !fresh) { e.preventDefault(); return; }
        locked = false;
        const target = nextRest(u, sign);
        if (target === null) return;                 // extremo: sigue el scroll normal
        e.preventDefault();
        jumpTo(target); locked = true; lockT = now; recent.length = 0;
      }, { passive: false });

      // deslizar en pantallas táctiles
      let ty0 = 0, tdy = 0, tmode = '';
      addEventListener('touchstart', (e) => {
        if (e.touches.length !== 1) { tmode = 'native'; return; }
        ty0 = e.touches[0].clientY; tdy = 0; tmode = '';
      }, { passive: true });
      addEventListener('touchmove', (e) => {
        if (tmode === 'native' || e.touches.length !== 1) return;
        tdy = ty0 - e.touches[0].clientY;
        if (!tmode) {
          if (tdy === 0) return;
          const u = scrollU();
          tmode = inZone(u) && nextRest(u, tdy > 0 ? 1 : -1) !== null ? 'page' : 'native';
        }
        if (tmode === 'page' && e.cancelable) e.preventDefault();
      }, { passive: false });
      addEventListener('touchend', () => {
        if (tmode === 'page' && Math.abs(tdy) > 30) {
          const target = nextRest(scrollU(), tdy > 0 ? 1 : -1);
          if (target !== null) jumpTo(target);
        }
        tmode = '';
      }, { passive: true });

      // teclado
      addEventListener('keydown', (e) => {
        if (e.altKey || e.ctrlKey || e.metaKey) return;
        const el = e.target as HTMLElement | null;
        if (el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
        const down = e.key === 'ArrowDown' || e.key === 'PageDown' || (e.key === ' ' && !e.shiftKey);
        const up = e.key === 'ArrowUp' || e.key === 'PageUp' || (e.key === ' ' && e.shiftKey);
        if (!down && !up) return;
        const u = scrollU();
        if (!inZone(u)) return;
        const target = nextRest(u, down ? 1 : -1);
        if (target === null) return;
        e.preventDefault(); jumpTo(target);
      });

      // si el scroll queda entre dos paradas (barra de scroll, recarga), se acomoda a la más cercana
      let settle = 0;
      addEventListener('scroll', () => {
        clearTimeout(settle);
        settle = window.setTimeout(() => {
          const u = scrollU(), r = rests();
          if (u <= r[0] || u >= r[r.length - 1]) return;
          let best = r[0];
          for (const x of r) if (Math.abs(x - u) < Math.abs(best - u)) best = x;
          if (Math.abs(best - u) > 0.01) jumpTo(best);
        }, 180);
      }, { passive: true });

      // con teclado: al enfocar una tarjeta, salta a ese proyecto
      cards.forEach((el, i) => {
        el.addEventListener('focus', () => {
          if (!el.matches(':focus-visible')) return;
          const want = GATHER + (i + 0.02) * STEP;
          if (Math.abs(scrollU() - want) > 0.05) jumpTo(want);
        });
      });
      addEventListener('scroll', kick, { passive: true });
      let rt = 0;
      addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(() => { measure(); measureLetters(); kick(); }, 120); }, { passive: true });
      document.addEventListener('visibilitychange', () => { if (document.hidden) { cancelAnimationFrame(raf); running = false; } else kick(); });
      addEventListener('load', () => { measure(); measureLetters(); kick(); }, { once: true });
      measure(); su = scrollU(); op = opening = openTarget(su); gd = gatherTarget(su); qd = cardTarget(su);
      renderOpen(); render(su, gd, qd, 0, 0); measureLetters(); kick();
    }
  }
</script>
