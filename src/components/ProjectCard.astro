---
import type { Project } from '../data/site';
import { link } from '../lib/link';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
---

<a class="card" href={link(`/trabajos/${p.id}`)} data-cat={p.cat}>
  <div class="card-frame reveal" data-glow-dock style={`aspect-ratio:${p.ratio}`}>
    <span class="card-img ph revfill" data-label={`${p.title} — cover`}></span>
    <span class="card-alt ph" data-label={`${p.title} — detalle`} aria-hidden="true"></span>
  </div>
  <div class="card-meta rise">
    <h3>{p.title}</h3>
    <p class="card-disc">
      <span data-es={p.disc.es} data-en={p.disc.en}>{p.disc.es}</span>
      <span class="year">{p.year}</span>
    </p>
  </div>
</a>

<style>
  .card { display: block; }
  .card.is-hidden { display: none; }

  .card-frame { position: relative; width: 100%; overflow: hidden; }
  .card-img {
    width: 100%;
    height: 100%;
    transition: transform 0.5s var(--ease-out);
  }
  .card:hover .card-img { transform: scale(1.03); }

  /* segunda toma del proyecto al hover (como en el home) */
  .card-alt {
    position: absolute; inset: 0;
    opacity: 0;
    background:
      repeating-linear-gradient(45deg, var(--ink-12) 0 10px, transparent 10px 20px),
      #dcd8ce;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .card:hover .card-alt { animation: cardSwap 1.5s steps(1) infinite 0.15s; }
    @keyframes cardSwap { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }
  }
  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    .card:hover .card-alt { opacity: 1; }
  }

  .card-meta { padding-top: 13px; }
  .card-meta h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.1;
    letter-spacing: -0.005em;
  }
  .card-disc {
    display: flex;
    gap: 10px;
    margin-top: 4px;
    font-family: var(--sans);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-60);
  }
  .card-disc .year { color: var(--ink-35); }
</style>
