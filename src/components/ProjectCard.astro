---
import type { Project } from '../data/site';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
---

<a class="card" href={`/trabajos/${p.id}`} data-cat={p.cat}>
  <div class="card-frame reveal" style={`aspect-ratio:${p.ratio}`}>
    <span class="card-img ph revfill" data-label={`${p.title} — cover`}></span>
  </div>
  <div class="card-meta rise">
    <h3>{p.title}</h3>
    <p class="card-disc">
      <span data-es={p.disc.es} data-en={p.disc.en}>{p.disc.es}</span>
      <span class="year">{p.year}</span>
    </p>
  </div>
</a>

<style>
  .card { display: block; }
  .card.is-hidden { display: none; }

  .card-frame { width: 100%; }
  .card-img {
    width: 100%;
    height: 100%;
    transition: opacity 0.4s var(--ease);
  }
  .card:hover .card-img { opacity: 0.82; }

  .card-meta { padding-top: 13px; }
  .card-meta h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.1;
    letter-spacing: -0.005em;
  }
  .card-disc {
    display: flex;
    gap: 10px;
    margin-top: 4px;
    font-family: var(--sans);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-60);
  }
  .card-disc .year { color: var(--ink-35); }
</style>
