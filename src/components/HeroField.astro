---
/* ============================================================
   HeroField — campo cinematográfico de portadas sobre blanco.
   · 3 capas de profundidad (parallax 3D): derivan a distinta
     velocidad y reaccionan distinto al cursor.
   · Hover: la portada se agranda y las demás se atenúan.
   · Al salir el mouse: parallax a neutro + zoom-out (se ve más).
   · Arrastrable con inercia. Click entra al proyecto. Loop 3x3.
   Las .ph son placeholders -> luego las portadas reales.
   ============================================================ */
import { projects } from '../data/site';
import { link } from '../lib/link';

const TILE = { w: 1600, h: 1100 };

type Item = { x: number; y: number; w: number; ar: string; p: number };

// dk = factor de deriva/arrastre · pk = factor de parallax del cursor
const layers: { name: string; dk: number; pk: number; items: Item[] }[] = [
  {
    name: 'back', dk: 0.68, pk: 0.30,
    items: [
      { x: 120, y: 120, w: 165, ar: '4/5', p: 0 },
      { x: 720, y: 70, w: 200, ar: '3/2', p: 1 },
      { x: 1200, y: 210, w: 160, ar: '4/5', p: 2 },
      { x: 470, y: 660, w: 175, ar: '1/1', p: 3 },
      { x: 1320, y: 760, w: 165, ar: '3/4', p: 5 },
    ],
  },
  {
    name: 'mid', dk: 0.86, pk: 0.62,
    items: [
      { x: 300, y: 250, w: 250, ar: '4/5', p: 4 },
      { x: 980, y: 300, w: 280, ar: '3/2', p: 6 },
      { x: 130, y: 770, w: 240, ar: '4/3', p: 7 },
      { x: 800, y: 820, w: 230, ar: '4/5', p: 0 },
      { x: 1290, y: 520, w: 240, ar: '1/1', p: 2 },
    ],
  },
  {
    name: 'front', dk: 1.08, pk: 1.0,
    items: [
      { x: 520, y: 110, w: 340, ar: '3/2', p: 1 },
      { x: 1060, y: 650, w: 360, ar: '4/5', p: 3 },
      { x: 110, y: 420, w: 320, ar: '4/3', p: 6 },
      { x: 770, y: 480, w: 300, ar: '4/5', p: 5 },
    ],
  },
];

const grid = [];
for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) grid.push({ ox: i * TILE.w, oy: j * TILE.h });
---

<section class="field" data-field aria-label="Proyectos">
  <div class="field-zoom" data-zoom>
    {layers.map((L) => (
      <div class={`layer layer-${L.name}`} data-layer data-pk={L.pk} data-dk={L.dk}>
        <div class="world" data-world data-tw={TILE.w} data-th={TILE.h}>
          {grid.map((t) => (
            <div class="tile" style={`transform:translate(${t.ox}px,${t.oy}px)`}>
              {L.items.map((pl) => {
                const proj = projects[pl.p % projects.length];
                return (
                  <a
                    class="fcard"
                    href={link(`/trabajos/${proj.id}`)}
                    style={`left:${pl.x}px;top:${pl.y}px;width:${pl.w}px;aspect-ratio:${pl.ar}`}
                    data-title={proj.title}
                    draggable="false"
                  >
                    <span class="fcard-img ph" data-label={proj.title}></span>
                  </a>
                );
              })}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <p class="field-hint" aria-hidden="true">
    <span data-es="Arrastrá · clic para entrar" data-en="Drag · click to open">Arrastrá · clic para entrar</span>
  </p>
</section>

<style>
  .field {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 560px;
    background: #fff;
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  .field.is-dragging { cursor: grabbing; }

  .field-zoom { position: absolute; inset: 0; transform-origin: center center; will-change: transform; }
  .layer { position: absolute; inset: 0; will-change: transform; }
  .layer-back { opacity: 0.86; }
  .world { position: absolute; inset: 0; will-change: transform; }
  .tile { position: absolute; top: 0; left: 0; width: 1600px; height: 1100px; }

  .fcard {
    position: absolute;
    display: block;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 6px 22px rgba(22, 21, 15, 0.07);
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease), opacity 0.45s var(--ease);
    -webkit-user-drag: none;
  }
  .fcard-img { display: block; width: 100%; height: 100%; }

  /* Hover cinematográfico: la portada bajo el cursor se agranda,
     las demás se atenúan (quedan secundarias). */
  .field-zoom:has(.fcard:hover) .fcard:not(:hover) { opacity: 0.3; }
  .field:not(.is-dragging) .fcard:hover {
    transform: scale(1.22);
    z-index: 50;
    box-shadow: 0 34px 90px rgba(22, 21, 15, 0.30);
  }

  .field-hint {
    position: absolute;
    left: 50%;
    bottom: clamp(20px, 4vh, 40px);
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-35);
    pointer-events: none;
    animation: hintpulse 3.2s var(--ease) infinite;
  }
  @keyframes hintpulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.85; } }

  @media (prefers-reduced-motion: reduce) {
    .field-hint { animation: none; }
    .fcard { transition: opacity 0.3s var(--ease); }
  }
</style>

<script>
  const field = document.querySelector('[data-field]') as HTMLElement | null;
  const zoomEl = document.querySelector('[data-zoom]') as HTMLElement | null;

  if (field && zoomEl) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const layers = Array.from(field.querySelectorAll<HTMLElement>('[data-layer]')).map((el) => {
      const world = el.querySelector<HTMLElement>('[data-world]')!;
      return {
        layer: el,
        world,
        pk: parseFloat(el.dataset.pk || '1'),
        dk: parseFloat(el.dataset.dk || '1'),
        tw: parseFloat(world.dataset.tw || '1600'),
        th: parseFloat(world.dataset.th || '1100'),
      };
    });

    // posicion del mundo (se envuelve modulo tile -> loop infinito)
    let offX = -800, offY = -440;
    // deriva automatica (un poco mas rapida)
    const driftX = reduce ? 0 : -0.36;
    const driftY = reduce ? 0 : -0.2;
    // inercia del arrastre
    let velX = 0, velY = 0;
    // parallax del cursor (objetivo / actual)
    let tPX = 0, tPY = 0, cPX = 0, cPY = 0;
    const PARA = 0.05;
    // zoom (respiro): afuera = mas chico (se ve mas), adentro = inmersivo
    const REST = 0.82, ACTIVE = 1.06;
    let zoom = REST, tZoom = REST;
    let engaged = false;

    let cx = innerWidth / 2, cy = innerHeight / 2;
    const setCenter = () => { cx = innerWidth / 2; cy = innerHeight / 2; };
    addEventListener('resize', setCenter, { passive: true });

    let dragging = false, moved = false;
    let startX = 0, startY = 0, lastX = 0, lastY = 0;

    field.addEventListener('pointerdown', (e) => {
      dragging = true; moved = false;
      startX = lastX = e.clientX; startY = lastY = e.clientY;
      velX = velY = 0;
      field.classList.add('is-dragging');
      try { field.setPointerCapture(e.pointerId); } catch {}
    });

    field.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse') {
        engaged = true;
        if (!reduce) { tPX = (e.clientX - cx) * -PARA; tPY = (e.clientY - cy) * -PARA; }
        tZoom = ACTIVE;
      }
      if (!dragging) return;
      const dx = e.clientX - lastX, dy = e.clientY - lastY;
      offX += dx; offY += dy;
      velX = dx; velY = dy;
      if (Math.abs(e.clientX - startX) + Math.abs(e.clientY - startY) > 6) moved = true;
      lastX = e.clientX; lastY = e.clientY;
    });

    const end = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      field.classList.remove('is-dragging');
      try { field.releasePointerCapture(e.pointerId); } catch {}
    };
    field.addEventListener('pointerup', end);
    field.addEventListener('pointercancel', end);

    // al salir el mouse: parallax a neutro + zoom-out (se ve la mayoria)
    field.addEventListener('pointerleave', (e) => {
      if (dragging) { dragging = false; field.classList.remove('is-dragging'); }
      if ((e as PointerEvent).pointerType !== 'touch') {
        engaged = false; tPX = 0; tPY = 0; tZoom = REST;
      }
    });

    // si hubo arrastre, no navegar al soltar
    field.addEventListener('click', (e) => {
      if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
    }, true);

    const wrap = (v: number, s: number) => (((v % s) + s) % s) - s;

    let raf = 0;
    const frame = () => {
      velX *= 0.94; velY *= 0.94;
      offX += driftX + velX;
      offY += driftY + velY;
      cPX += (tPX - cPX) * 0.07;
      cPY += (tPY - cPY) * 0.07;
      zoom += (tZoom - zoom) * 0.05;

      zoomEl.style.transform = `scale(${zoom.toFixed(4)})`;
      for (const L of layers) {
        L.world.style.transform =
          `translate3d(${wrap(offX * L.dk, L.tw).toFixed(2)}px, ${wrap(offY * L.dk, L.th).toFixed(2)}px, 0)`;
        L.layer.style.transform =
          `translate3d(${(cPX * L.pk).toFixed(2)}px, ${(cPY * L.pk).toFixed(2)}px, 0)`;
      }
      raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);

    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) raf = requestAnimationFrame(frame);
    });
  }
</script>
