---
/* ============================================================
   HeroField — enjambre 3D de portadas en un campo de profundidad.
   · Perspectiva real (eje Z): flotan a distintas profundidades.
   · Derivan continuamente (nube/enjambre), sin arrastre.
   · Hover: zoom dramatico y veloz a esa portada; al salir, vuelve.
   · Sin sombra. Click entra al proyecto.
   Hit-testing propio (el nativo no anda con preserve-3d).
   Las .ph son placeholders -> luego las portadas reales.
   ============================================================ */
import { projects } from '../data/site';
import { link } from '../lib/link';

function mulberry32(a: number) {
  return function () {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(20260615);
const ratios = ['4/5', '3/4', '1/1', '3/2', '4/3'];

const N = 24;
const cards = Array.from({ length: N }, (_, i) => ({
  bxf: rnd() * 2 - 1,
  byf: rnd() * 2 - 1,
  bz: Math.round(-720 + rnd() * 770),
  w: 150 + Math.round(rnd() * 135),
  ar: ratios[Math.floor(rnd() * ratios.length)],
  p: i % projects.length,
  fa: 16 + Math.round(rnd() * 30),
  fs: 0.25 + rnd() * 0.45,
  ph: Math.round(rnd() * 628) / 100,
}));
---

<section class="field" data-field aria-label="Proyectos">
  <div class="stage" data-stage>
    {cards.map((c) => {
      const proj = projects[c.p % projects.length];
      return (
        <a
          class="fcard"
          href={link(`/trabajos/${proj.id}`)}
          style={`width:${c.w}px;aspect-ratio:${c.ar}`}
          data-bxf={c.bxf}
          data-byf={c.byf}
          data-bz={c.bz}
          data-fa={c.fa}
          data-fs={c.fs}
          data-ph={c.ph}
          data-title={proj.title}
          draggable="false"
        >
          <span class="fcard-img ph" data-label={proj.title}></span>
        </a>
      );
    })}
  </div>

  <p class="field-hint" aria-hidden="true">
    <span data-es="Pasá el cursor · clic para entrar" data-en="Hover · click to open">Pasá el cursor · clic para entrar</span>
  </p>
</section>

<style>
  .field {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 560px;
    background: #fff;
    overflow: hidden;
    perspective: 900px;
    perspective-origin: 50% 48%;
    cursor: default;
  }
  .field.over-card { cursor: pointer; }
  .stage { position: absolute; inset: 0; transform-style: preserve-3d; }

  .fcard {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    border-radius: 2px;
    overflow: hidden;
    transform-origin: center center;
    will-change: transform;
    transition: opacity 0.5s var(--ease);
    -webkit-user-drag: none;
  }
  .fcard-img { display: block; width: 100%; height: 100%; }

  /* foco: las demas se atenuan y quedan secundarias */
  .field.has-focus .fcard:not(.is-focus) { opacity: 0.26; }

  .field-hint {
    position: absolute;
    left: 50%;
    bottom: clamp(20px, 4vh, 40px);
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-35);
    pointer-events: none;
    animation: hintpulse 3.2s var(--ease) infinite;
  }
  @keyframes hintpulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.85; } }
  @media (prefers-reduced-motion: reduce) { .field-hint { animation: none; } }
</style>

<script>
  const field = document.querySelector('[data-field]') as HTMLElement | null;

  if (field) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const still = location.hash === '#freeze';
    const animate = !reduce && !still;

    const P = 900;          // perspectiva (coincide con el CSS)
    const SPEED = animate ? 0.85 : 0;
    const FA = animate ? 1 : 0;
    const HOVER_S = 2.2;    // cuanto agranda al hacer foco
    const FRONT = 140;      // z al frente cuando esta enfocada

    type Card = {
      el: HTMLElement; bxf: number; byf: number; bz: number;
      fa: number; fs: number; ph: number; w: number; h: number;
      X: number; Y: number; Zamb: number; z: number; s: number;
      rl: number; rr: number; rt: number; rb: number;
    };

    const cards: Card[] = Array.from(field.querySelectorAll<HTMLElement>('.fcard')).map((el) => ({
      el,
      bxf: parseFloat(el.dataset.bxf || '0'),
      byf: parseFloat(el.dataset.byf || '0'),
      bz: parseFloat(el.dataset.bz || '0'),
      fa: parseFloat(el.dataset.fa || '20'),
      fs: parseFloat(el.dataset.fs || '0.4'),
      ph: parseFloat(el.dataset.ph || '0'),
      w: el.offsetWidth, h: el.offsetHeight,
      X: 0, Y: 0, Zamb: 0, z: parseFloat(el.dataset.bz || '0'), s: 1,
      rl: 0, rr: 0, rt: 0, rb: 0,
    }));

    let cw = field.clientWidth, ch = field.clientHeight;
    let XR = cw / 2 + 380, YR = ch / 2 + 160;
    const measure = () => {
      cw = field.clientWidth; ch = field.clientHeight;
      XR = cw / 2 + 380; YR = ch / 2 + 160;
      cards.forEach((c) => { c.w = c.el.offsetWidth; c.h = c.el.offsetHeight; });
    };
    addEventListener('resize', measure, { passive: true });

    // puntero relativo al campo
    let px = -1, py = -1, inside = false;
    const toLocal = (e: PointerEvent | MouseEvent) => {
      const r = field.getBoundingClientRect();
      px = e.clientX - r.left; py = e.clientY - r.top;
    };
    field.addEventListener('pointermove', (e) => { toLocal(e); inside = true; });
    field.addEventListener('pointerleave', () => { inside = false; });

    let focus: Card | null = null;
    const setFocus = (c: Card | null) => {
      if (focus === c) return;
      if (focus) focus.el.classList.remove('is-focus');
      focus = c;
      field.classList.toggle('has-focus', !!c);
      field.classList.toggle('over-card', !!c);
      if (c) c.el.classList.add('is-focus');
    };

    // click/tap: navega a la portada bajo el cursor (hit-test propio)
    field.addEventListener('click', (e) => {
      const r = field.getBoundingClientRect();
      const x = e.clientX - r.left, y = e.clientY - r.top;
      let hit: Card | null = null, hz = -1e9;
      for (const c of cards) {
        if (x >= c.rl && x <= c.rr && y >= c.rt && y <= c.rb && c.Zamb > hz) { hz = c.Zamb; hit = c; }
      }
      if (hit) location.href = hit.el.getAttribute('href') || '#';
    });

    const wrap = (v: number, r: number) => (((v + r) % (2 * r)) + 2 * r) % (2 * r) - r;

    const t0 = performance.now();
    let raf = 0;
    const frame = (now: number) => {
      const t = (now - t0) / 1000;
      gx -= SPEED;
      const Oy = ch * 0.48;

      // pass 1: posicion ambiente + rectangulo de deteccion (footprint base)
      for (const c of cards) {
        c.X = wrap(c.bxf * XR + gx + Math.sin(t * c.fs + c.ph) * c.fa * FA, XR);
        c.Y = c.byf * YR * 0.82 + Math.sin(t * c.fs * 0.8 + c.ph) * c.fa * FA;
        c.Zamb = c.bz + Math.sin(t * c.fs * 0.6 + c.ph) * c.fa * 0.5 * FA;
        const f = P / (P - c.Zamb);
        const pcx = cw / 2 + c.X * f;
        const pcy = Oy + (ch / 2 - Oy + c.Y) * f;
        const hw = (c.w * f) / 2, hh = (c.h * f) / 2;
        c.rl = pcx - hw; c.rr = pcx + hw; c.rt = pcy - hh; c.rb = pcy + hh;
      }

      // hit-test propio -> foco
      let hit: Card | null = null, hz = -1e9;
      if (inside) {
        for (const c of cards) {
          if (px >= c.rl && px <= c.rr && py >= c.rt && py <= c.rb && c.Zamb > hz) { hz = c.Zamb; hit = c; }
        }
      }
      setFocus(hit);

      // pass 2: visual (la enfocada hace zoom y va al frente)
      for (const c of cards) {
        const f0 = focus === c;
        c.z += ((f0 ? FRONT : c.Zamb) - c.z) * (f0 ? 0.2 : 0.14);
        c.s += ((f0 ? HOVER_S : 1) - c.s) * (f0 ? 0.2 : 0.14);
        const tx = cw / 2 + c.X - c.w / 2;
        const ty = ch / 2 + c.Y - c.h / 2;
        c.el.style.transform =
          `translate3d(${tx.toFixed(1)}px, ${ty.toFixed(1)}px, ${c.z.toFixed(1)}px) scale(${c.s.toFixed(3)})`;
      }
      raf = requestAnimationFrame(frame);
    };
    let gx = 0;
    raf = requestAnimationFrame(frame);

    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) raf = requestAnimationFrame(frame);
    });
  }
</script>
