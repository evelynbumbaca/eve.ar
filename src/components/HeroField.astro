---
/* ============================================================
   HeroField — campo 3D de portadas, zoom calmo guiado por el cursor.
   · Mucho aire en Z (capas de profundidad) + deriva suave (enjambre).
   · Cuando el cursor SE DETIENE, la escena hace un zoom (lean-in) con
     origen EN el cursor: esa seccion se agranda y el cursor queda
     dentro de la portada (clickeable). No zoomea mientras te movés
     (no marea). Todo con smooth-damp (ease-in-out).
   · Hit-testing propio para hover (cursor) y click.
   Las .ph son placeholders -> luego las portadas reales.
   ============================================================ */
import { projects } from '../data/site';
import { link } from '../lib/link';

function mulberry32(a: number) {
  return function () {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(20260615);
const ratios = ['4/5', '3/4', '1/1', '3/2', '4/3'];

const N = 22;
const cards = Array.from({ length: N }, (_, i) => ({
  bxf: rnd() * 2 - 1,
  byf: rnd() * 2 - 1,
  bz: Math.round(-1500 + rnd() * 1650),
  w: 160 + Math.round(rnd() * 140),
  ar: ratios[Math.floor(rnd() * ratios.length)],
  p: i % projects.length,
  fa: 16 + Math.round(rnd() * 30),
  fs: 0.25 + rnd() * 0.45,
  ph: Math.round(rnd() * 628) / 100,
}));
---

<section class="field" data-field aria-label="Proyectos">
  <div class="stage" data-stage>
    {cards.map((c) => {
      const proj = projects[c.p % projects.length];
      return (
        <a
          class="fcard"
          href={link(`/trabajos/${proj.id}`)}
          style={`width:${c.w}px;aspect-ratio:${c.ar}`}
          data-bxf={c.bxf} data-byf={c.byf} data-bz={c.bz}
          data-fa={c.fa} data-fs={c.fs} data-ph={c.ph}
          data-title={proj.title} draggable="false"
        >
          <span class="fcard-img ph" data-label={proj.title}></span>
        </a>
      );
    })}
  </div>

  <p class="field-hint" aria-hidden="true">
    <span data-es="Pasá el cursor · clic para entrar" data-en="Hover · click to open">Pasá el cursor · clic para entrar</span>
  </p>
</section>

<style>
  .field {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 560px;
    background: #fff;
    overflow: hidden;
    perspective: 750px;
    perspective-origin: 50% 48%;
    cursor: default;
  }
  .field.over-card { cursor: pointer; }
  .stage { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; }

  .fcard {
    position: absolute;
    left: 0; top: 0;
    display: block;
    border-radius: 2px;
    overflow: hidden;
    transform-origin: center center;
    will-change: transform;
    -webkit-user-drag: none;
  }
  .fcard-img { display: block; width: 100%; height: 100%; }

  .field-hint {
    position: absolute;
    left: 50%; bottom: clamp(20px, 4vh, 40px);
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-35); pointer-events: none;
    animation: hintpulse 3.2s var(--ease) infinite;
  }
  @keyframes hintpulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.85; } }
  @media (prefers-reduced-motion: reduce) { .field-hint { animation: none; } }
</style>

<script>
  const field = document.querySelector('[data-field]') as HTMLElement | null;
  const stage = document.querySelector('[data-stage]') as HTMLElement | null;

  if (field && stage) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const still = location.hash === '#freeze';
    const animate = !reduce && !still;

    const P = 750;
    const ZOOM = 0.16;  // cuanto agranda al frenar (lean-in) — ya 30% mas bajo
    const SPD = 600;    // px/s: por encima -> "moviendose" (sin zoom)

    type Card = {
      el: HTMLElement; bxf: number; byf: number; bz: number;
      fa: number; fs: number; ph: number; w: number; h: number;
      hs: number; vz: number; rl: number; rr: number; rt: number; rb: number;
    };
    const cards: Card[] = Array.from(field.querySelectorAll<HTMLElement>('.fcard')).map((el) => ({
      el,
      bxf: parseFloat(el.dataset.bxf || '0'), byf: parseFloat(el.dataset.byf || '0'),
      bz: parseFloat(el.dataset.bz || '0'),
      fa: parseFloat(el.dataset.fa || '20'), fs: parseFloat(el.dataset.fs || '0.4'),
      ph: parseFloat(el.dataset.ph || '0'),
      w: el.offsetWidth, h: el.offsetHeight,
      hs: 1, vz: 0, rl: 0, rr: 0, rt: 0, rb: 0,
    }));

    let cw = field.clientWidth, ch = field.clientHeight;
    let XR = cw / 2 + 460, YR = ch / 2 + 300;
    const measure = () => {
      cw = field.clientWidth; ch = field.clientHeight;
      XR = cw / 2 + 460; YR = ch / 2 + 300;
      cards.forEach((c) => { c.w = c.el.offsetWidth; c.h = c.el.offsetHeight; });
    };
    addEventListener('resize', measure, { passive: true });

    let px = -1, py = -1, inside = false;
    field.addEventListener('pointermove', (e) => { const r = field.getBoundingClientRect(); px = e.clientX - r.left; py = e.clientY - r.top; inside = true; });
    field.addEventListener('pointerleave', () => { inside = false; });

    // hit-test sobre los rects de perspectiva (el zoom 2D con origen en el
    // cursor preserva la contencion, asi que esto sigue siendo valido)
    const hitAt = (x: number, y: number) => {
      let hit: Card | null = null, hz = -1e9;
      for (const c of cards) if (x >= c.rl && x <= c.rr && y >= c.rt && y <= c.rb && c.vz > hz) { hz = c.vz; hit = c; }
      return hit;
    };
    field.addEventListener('click', (e) => {
      const r = field.getBoundingClientRect();
      const h = hitAt(e.clientX - r.left, e.clientY - r.top);
      if (h) location.href = h.el.getAttribute('href') || '#';
    });

    const wrap = (v: number, r: number) => (((v + r) % (2 * r)) + 2 * r) % (2 * r) - r;
    const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);

    type SD = { v: number; vel: number };
    const smoothDamp = (s: SD, target: number, smoothTime: number, dt: number) => {
      const omega = 2 / Math.max(0.0001, smoothTime);
      const x = omega * dt;
      const exp = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x);
      const change = s.v - target;
      const temp = (s.vel + omega * change) * dt;
      s.vel = (s.vel - omega * temp) * exp;
      s.v = target + (change + temp) * exp;
      return s.v;
    };

    let offX = 0, offY = 0;
    const eng: SD = { v: 0, vel: 0 }, zoom: SD = { v: 0, vel: 0 };
    let ozx = cw / 2, ozy = ch / 2; // origen del zoom (cursor, suavizado solo cuando se mueve)
    let lpx = -1, lpy = -1;
    const t0 = performance.now();
    let last = t0, raf = 0;

    const frame = (now: number) => {
      const t = (now - t0) / 1000;
      const dt = Math.min(0.05, (now - last) / 1000); last = now;

      // engagement = quietud del cursor (1 = frenado, 0 = moviendose)
      let speed = 0;
      if (inside && lpx >= 0) speed = Math.hypot(px - lpx, py - lpy) / Math.max(dt, 0.001);
      lpx = px; lpy = py;
      const engT = inside && !reduce ? clamp(1 - speed / SPD, 0, 1) : 0;
      smoothDamp(eng, engT, 0.14, dt);
      smoothDamp(zoom, ZOOM * eng.v, 0.32, dt); // ease-in-out

      // el origen del zoom sigue al cursor; cuando esta casi quieto, fijo
      if (inside) { ozx += (px - ozx) * (0.25 + 0.6 * eng.v); ozy += (py - ozy) * (0.25 + 0.6 * eng.v); }
      const s = 1 + zoom.v;
      stage.style.transformOrigin = `${ozx.toFixed(1)}px ${ozy.toFixed(1)}px`;
      stage.style.transform = `scale(${s.toFixed(4)})`;

      // deriva suave (enjambre)
      if (animate) { offX += -0.28; offY += -0.16; }

      const hov = inside ? hitAt(px, py) : null;
      field.classList.toggle('over-card', !!hov);

      const Ox = cw * 0.5, Oy = ch * 0.48;
      for (const c of cards) {
        const aX = wrap(c.bxf * XR + offX + Math.sin(t * c.fs + c.ph) * c.fa * (animate ? 1 : 0), XR);
        const aY = wrap(c.byf * YR + offY + Math.sin(t * c.fs * 0.8 + c.ph) * c.fa * (animate ? 1 : 0), YR);
        const aZ = c.bz + Math.sin(t * c.fs * 0.6 + c.ph) * c.fa * 0.5 * (animate ? 1 : 0);
        c.hs += (((c === hov) ? 1.05 : 1) - c.hs) * 0.16;
        const S = c.hs;
        c.vz = aZ;
        const tx = cw / 2 + aX - c.w / 2, ty = ch / 2 + aY - c.h / 2;
        c.el.style.transform = `translate3d(${tx.toFixed(1)}px, ${ty.toFixed(1)}px, ${aZ.toFixed(1)}px) scale(${S.toFixed(3)})`;
        // rect proyectado, luego escalado 2D respecto del origen del zoom
        const f = P / (P - aZ);
        let pcx = Ox + (cw / 2 + aX - Ox) * f, pcy = Oy + (ch / 2 + aY - Oy) * f;
        let hw = (c.w * S * f) / 2, hh = (c.h * S * f) / 2;
        pcx = ozx + (pcx - ozx) * s; pcy = ozy + (pcy - ozy) * s; hw *= s; hh *= s;
        c.rl = pcx - hw; c.rr = pcx + hw; c.rt = pcy - hh; c.rb = pcy + hh;
      }
      raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);

    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) { last = performance.now(); raf = requestAnimationFrame(frame); }
    });
  }
</script>
