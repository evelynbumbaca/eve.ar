---
/* ============================================================
   HeroField — "Revelado": contact-sheet de portadas + lente.
   · Estado base ESTATICO (cero deriva, cero camara) -> no marea.
   · El cursor es una lente: solo lo que esta debajo se REVELA
     (gris claro -> tinta, aparece el titulo), se eleva apenas
     (max 5%, no es un zoom) y se imanta levemente hacia el cursor.
   · Falloff suave por distancia -> el cambio es LOCAL; el resto
     del campo queda quieto y calmo.
   · La portada mas cercana es el objetivo de clic.
   · Las .fcard-fill son placeholders (al cargar las portadas
     reales, el "revelado" pasa de gris a la imagen a full).
   ============================================================ */
import { projects } from '../data/site';
import { link } from '../lib/link';

function mulberry32(a: number) {
  return function () {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(20260615);
const ratios = ['4/5', '3/4', '1/1', '3/2'];

const N = 16;
// reparto de portadas barajado (evita que el mismo proyecto caiga en fila/columna)
const pool = Array.from({ length: projects.length }, (_, k) => k);
const shuffled = () => {
  const a = [...pool];
  for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(rnd() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
  return a;
};
const order: number[] = [];
let bag: number[] = [];
for (let i = 0; i < N; i++) { if (!bag.length) bag = shuffled(); order.push(bag.pop()!); }

const cards = Array.from({ length: N }, (_, i) => ({
  jx: rnd() * 2 - 1,           // jitter dentro de la celda
  jy: rnd() * 2 - 1,
  sf: rnd(),                   // factor de tamano (variedad)
  ar: ratios[Math.floor(rnd() * ratios.length)],
  p: order[i],
  d: i,                        // orden de entrada (stagger)
}));
---

<section class="field" data-field aria-label="Proyectos">
  <div class="stage" data-stage>
    {cards.map((c) => {
      const proj = projects[c.p % projects.length];
      return (
        <a
          class="fcard"
          href={link(`/trabajos/${proj.id}`)}
          style={`--ar:${c.ar};--d:${c.d * 45}ms`}
          data-jx={c.jx} data-jy={c.jy} data-sf={c.sf} data-ar={c.ar}
          data-title={proj.title} draggable="false"
        >
          <span class="fcard-fill"></span>
          <span class="fcard-label">{proj.title}</span>
        </a>
      );
    })}
  </div>

  <div class="lens" data-lens aria-hidden="true"></div>

  <p class="field-hint" aria-hidden="true">
    <span data-es="Pasá el cursor para revelar · clic para entrar" data-en="Move to reveal · click to open">Pasá el cursor para revelar · clic para entrar</span>
  </p>
</section>

<style>
  .field {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 560px;
    background: #fff;
    overflow: hidden;
    cursor: default;
  }
  .field.over-card { cursor: pointer; }
  .stage { position: absolute; inset: 0; }

  .fcard {
    position: absolute;
    left: 0; top: 0;
    display: block;
    border-radius: 2px;
    transform-origin: center center;
    transform: translate3d(var(--tx, 0px), var(--ty, 0px), 0) scale(calc(1 + var(--r, 0) * 0.05));
    box-shadow:
      0 calc(2px + var(--r, 0) * 14px) calc(8px + var(--r, 0) * 30px)
      rgba(14, 14, 14, calc(var(--r, 0) * 0.16));
    will-change: transform;
    -webkit-user-drag: none;
  }
  .fcard-fill {
    position: absolute; inset: 0;
    border-radius: inherit;
    border: 1px solid color-mix(in oklab, #0d0d0d calc(var(--r, 0) * 90%), #e8e8e8);
    background-color: color-mix(in oklab, #0d0d0d calc(var(--r, 0) * 100%), #f4f4f4);
  }
  /* entrada: revelado de arriba hacia abajo, escalonado */
  .field:not(.is-still) .fcard-fill {
    animation: fcardIn 0.8s cubic-bezier(0.22, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes fcardIn {
    from { clip-path: inset(0 0 100% 0); opacity: 0; }
    to   { clip-path: inset(0 0 0 0); opacity: 1; }
  }

  .fcard-label {
    position: absolute;
    left: 10px; right: 10px; bottom: 9px;
    font-family: var(--mono);
    font-size: 11px; letter-spacing: 0.06em;
    line-height: 1.25;
    color: color-mix(in oklab, #ffffff calc(var(--r, 0) * 100%), #b7b7b7);
    opacity: calc(0.3 + var(--r, 0) * 0.7);
    pointer-events: none;
    text-transform: uppercase;
  }

  .fcard.is-active .fcard-fill {
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.55);
  }

  /* lente sutil que acompana al cursor (afordancia) */
  .lens {
    position: absolute; left: 0; top: 0;
    width: 520px; height: 520px;
    margin: -260px 0 0 -260px;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.45s ease;
    transform: translate3d(var(--lx, 0px), var(--ly, 0px), 0);
    background: radial-gradient(circle, transparent 36%, rgba(13, 13, 13, 0.05) 39%, transparent 54%);
  }
  .field.is-live .lens { opacity: 1; }

  .field-hint {
    position: absolute;
    left: 50%; bottom: clamp(20px, 4vh, 40px);
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-35); pointer-events: none;
    animation: hintpulse 3.2s var(--ease) infinite;
  }
  @keyframes hintpulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.8; } }

  @media (prefers-reduced-motion: reduce) {
    .field:not(.is-still) .fcard-fill { animation: none; }
    .field-hint { animation: none; }
    .lens { display: none; }
  }
  /* tactil: sin lente, contacto legible y tocable */
  @media (hover: none) {
    .lens { display: none; }
    .fcard-label { opacity: 0.7; color: #777; }
  }
</style>

<script>
  const field = document.querySelector('[data-field]') as HTMLElement | null;

  if (field) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = matchMedia('(hover: none)').matches;
    const still = location.hash === '#freeze';
    if (still) field.classList.add('is-still');

    const lens = field.querySelector<HTMLElement>('[data-lens]');

    type Card = {
      el: HTMLElement; fill: HTMLElement;
      jx: number; jy: number; sf: number; arN: number;
      cx: number; cy: number; w: number; h: number;
      r: number; rt: number;
    };

    const arNum = (s: string) => { const [a, b] = s.split('/').map(Number); return a / b; };

    const cards: Card[] = Array.from(field.querySelectorAll<HTMLElement>('.fcard')).map((el) => ({
      el,
      fill: el.querySelector('.fcard-fill') as HTMLElement,
      jx: parseFloat(el.dataset.jx || '0'), jy: parseFloat(el.dataset.jy || '0'),
      sf: parseFloat(el.dataset.sf || '0.5'), arN: arNum(el.dataset.ar || '4/5'),
      cx: 0, cy: 0, w: 0, h: 0, r: 0, rt: 0,
    }));

    let cw = field.clientWidth, ch = field.clientHeight;
    let LENS = 300;

    const measure = () => {
      cw = field.clientWidth; ch = field.clientHeight;
      LENS = Math.min(360, Math.max(220, cw * 0.22));
      const mx = Math.max(40, cw * 0.05);
      const topPad = Math.max(46, ch * 0.10);
      const botPad = Math.max(96, ch * 0.16);
      const gw = cw - mx * 2;
      const gh = ch - topPad - botPad;
      const cols = Math.min(5, Math.max(3, Math.round(cw / 340)));
      const rows = Math.ceil(cards.length / cols);
      const cellW = gw / cols, cellH = gh / rows;

      cards.forEach((c, idx) => {
        const i = idx % cols, j = Math.floor(idx / cols);
        const cx = mx + (i + 0.5) * cellW + c.jx * cellW * 0.15;
        const cy = topPad + (j + 0.5) * cellH + c.jy * cellH * 0.15;
        // tamano que cabe en la celda, con variedad
        const wMax = cellW * 0.82, hMax = cellH * 0.82;
        let w = Math.min(wMax, hMax * c.arN) * (0.86 + c.sf * 0.14);
        let h = w / c.arN;
        c.cx = cx; c.cy = cy; c.w = w; c.h = h;
        c.el.style.left = (cx - w / 2).toFixed(1) + 'px';
        c.el.style.top = (cy - h / 2).toFixed(1) + 'px';
        c.el.style.width = w.toFixed(1) + 'px';
        c.el.style.height = h.toFixed(1) + 'px';
      });
    };
    measure();
    addEventListener('resize', measure, { passive: true });

    let px = -1e5, py = -1e5, inside = false;
    let lx = 0, ly = 0;
    field.addEventListener('pointermove', (e) => {
      const rct = field.getBoundingClientRect();
      px = e.clientX - rct.left; py = e.clientY - rct.top;
      if (!inside) { inside = true; lx = px; ly = py; field.classList.add('is-live'); }
    });
    field.addEventListener('pointerleave', () => { inside = false; field.classList.remove('is-live'); });

    // clic -> portada mas cercana dentro de la lente
    const nearest = () => {
      let hit: Card | null = null, bd = LENS * LENS;
      for (const c of cards) {
        const dx = px - c.cx, dy = py - c.cy, d2 = dx * dx + dy * dy;
        if (d2 < bd) { bd = d2; hit = c; }
      }
      return hit;
    };
    field.addEventListener('click', () => {
      const h = nearest();
      if (h) location.href = h.el.getAttribute('href') || '#';
    });

    const smooth = (t: number) => { t = t < 0 ? 0 : t > 1 ? 1 : t; return t * t * (3 - 2 * t); };

    // tactil: revelado base tenue y quieto (los <a> ya son tocables)
    if (coarse || reduce) {
      cards.forEach((c) => c.el.style.setProperty('--r', '0'));
    }

    let active: Card | null = null;
    let raf = 0;
    const frame = () => {
      // lente suavizada
      lx += (px - lx) * 0.2; ly += (py - ly) * 0.2;
      if (lens) { lens.style.setProperty('--lx', lx.toFixed(1) + 'px'); lens.style.setProperty('--ly', ly.toFixed(1) + 'px'); }

      let best: Card | null = null, bestR = 0.18;
      for (const c of cards) {
        let target = 0;
        if (inside) {
          const dx = px - c.cx, dy = py - c.cy;
          const d = Math.hypot(dx, dy);
          target = smooth(1 - d / LENS);
        }
        c.r += (target - c.r) * 0.16;
        if (c.r < 0.001) c.r = 0;
        c.el.style.setProperty('--r', c.r.toFixed(3));
        // imantacion sutil hacia el cursor (max ~12px)
        if (c.r > 0.002 && inside) {
          const dx = px - c.cx, dy = py - c.cy, d = Math.hypot(dx, dy) || 1;
          const pull = c.r * 12;
          c.el.style.setProperty('--tx', ((dx / d) * pull).toFixed(1) + 'px');
          c.el.style.setProperty('--ty', ((dy / d) * pull).toFixed(1) + 'px');
        } else {
          c.el.style.setProperty('--tx', '0px');
          c.el.style.setProperty('--ty', '0px');
        }
        c.el.style.zIndex = String(1 + Math.round(c.r * 100));
        if (c.r > bestR) { bestR = c.r; best = c; }
      }

      if (best !== active) {
        if (active) active.el.classList.remove('is-active');
        active = best;
        if (active) active.el.classList.add('is-active');
        field.classList.toggle('over-card', !!active);
      }
      raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);

    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) raf = requestAnimationFrame(frame);
    });
  }
</script>
