---
/* ============================================================
   PacksSection — 3 packs de branding preestablecidos.
   CTA primario: WhatsApp con mensaje prellenado por pack.
   CTA secundario: mail con asunto prellenado.
   Cierre: puente a #contacto para proyectos a medida.
   Contenido placeholder: alcances/tiempos se ajustan con Eve.
   ============================================================ */
import { site } from '../data/site';
import T from './T.astro';

/* Paquetes reales de Eve (doc "Servicios de diseño", feb 2026),
   condensados para la web. Los precios se suman cuando Eve los confirme. */
const packs = [
  {
    num: '01',
    name: 'Esencial',
    fullName: 'Identidad Visual Esencial',
    who: { es: 'Para emprendedores y marcas que arrancan.', en: 'For founders and brands just starting out.' },
    items: [
      { es: 'Logotipo principal + variante', en: 'Primary logo + variant' },
      { es: 'Paleta de color y sistema tipográfico', en: 'Color palette & type system' },
      { es: 'Kit para redes (perfil, highlights, posteo base)', en: 'Social kit (avatar, highlights, base post)' },
      { es: '2 patterns de marca + brand board', en: '2 brand patterns + brand board' },
      { es: 'Guía de estilo esencial (PDF) + editables', en: 'Essential style guide (PDF) + source files' },
      { es: 'Presentación final con asesoría', en: 'Final walkthrough & guidance' },
    ],
    time: { es: 'Duración: 4 semanas · 2 rondas de revisión', en: 'Timeline: 4 weeks · 2 revision rounds' },
    full: [
      { es: 'Brief inicial de marca (llamada de 30 min)', en: 'Initial brand brief (30-min call)' },
      { es: 'Logotipo principal + variante (PNG y PDF)', en: 'Primary logo + variant (PNG & PDF)' },
      { es: 'Paleta de colores de marca', en: 'Brand color palette' },
      { es: 'Sistema tipográfico (primaria y secundaria)', en: 'Type system (primary & secondary)' },
      { es: 'Highlights para Instagram (hasta 5)', en: 'Instagram highlights (up to 5)' },
      { es: '2 patterns de marca (PNG y AI)', en: '2 brand patterns (PNG & AI)' },
      { es: 'Posteo base para redes con el logo', en: 'Base social post with the logo' },
      { es: 'Imagen de perfil optimizada para redes', en: 'Optimized profile image' },
      { es: 'Brand board completo (PDF)', en: 'Full brand board (PDF)' },
      { es: 'Guía de estilo visual esencial (PDF)', en: 'Essential visual style guide (PDF)' },
      { es: 'Reunión final de presentación y asesoría', en: 'Final walkthrough & guidance session' },
      { es: 'Archivo editable AI + carpetas organizadas (PDF, PNG, SVG)', en: 'Editable AI file + organized folders (PDF, PNG, SVG)' },
      { es: 'Add-on opcional: animación de logo (MP4 para Reels e intros)', en: 'Optional add-on: logo animation (MP4 for Reels & intros)' },
    ],
  },
  {
    num: '02',
    name: 'Profesional',
    fullName: 'Identidad Visual Profesional',
    featured: true,
    who: { es: 'Para marcas en crecimiento y profesionales establecidos.', en: 'For growing brands and established professionals.' },
    items: [
      { es: 'Estrategia: brief profundo, competencia y concepto', en: 'Strategy: deep brief, competitors & concept' },
      { es: 'Sistema visual completo (logos, color, tipografía)', en: 'Full visual system (logos, color, type)' },
      { es: 'Brandbook + definición de estilo de marca', en: 'Brandbook + brand style definition' },
      { es: 'Aplicaciones: redes, firma de mail, tarjeta, plantillas', en: 'Applications: social, email signature, card, templates' },
      { es: 'Animación de logo incluida (MP4)', en: 'Logo animation included (MP4)' },
    ],
    time: { es: 'Duración: 6–8 semanas · 2 rondas por etapa', en: 'Timeline: 6–8 weeks · 2 rounds per stage' },
    full: [
      { es: 'Etapa 1 — Estrategia: brief en profundidad + reunión de inicio', en: 'Stage 1 — Strategy: in-depth brief + kickoff' },
      { es: 'Análisis de competencia y referencias', en: 'Competitor & reference analysis' },
      { es: 'Personalidad de marca, valores y tono visual', en: 'Brand personality, values & visual tone' },
      { es: 'Concepto creativo que guía todo el proyecto', en: 'Creative concept guiding the whole project' },
      { es: 'Etapa 2 — Sistema: logo principal, secundario, isotipo y variantes', en: 'Stage 2 — System: primary & secondary logos, mark & variants' },
      { es: 'Paleta con códigos HEX, RGB y CMYK', en: 'Palette with HEX, RGB & CMYK specs' },
      { es: 'Sistema tipográfico con jerarquías', en: 'Type system with hierarchies' },
      { es: 'Recursos gráficos: patterns, íconos o texturas', en: 'Graphic assets: patterns, icons or textures' },
      { es: 'Etapa 3 — Brandbook: manual de identidad completo (PDF)', en: 'Stage 3 — Brandbook: full identity manual (PDF)' },
      { es: 'Definición de estilo de marca (moodboard + estilo fotográfico)', en: 'Brand style definition (moodboard + photo style)' },
      { es: 'Portadas y perfil para redes + firma de mail + tarjeta', en: 'Social covers & avatar + email signature + business card' },
      { es: 'Plantilla de story editable', en: 'Editable story template' },
      { es: 'Animación de construcción de logo (MP4)', en: 'Logo build animation (MP4)' },
      { es: 'Editables AI + carpetas organizadas', en: 'AI source files + organized folders' },
    ],
  },
  {
    num: '03',
    name: 'Corporativa',
    fullName: 'Identidad Visual Corporativa',
    who: { es: 'Para PyMEs, empresas y organizaciones con estructura.', en: 'For SMEs, companies and structured organizations.' },
    items: [
      { es: 'Diagnóstico y estrategia con tu equipo', en: 'Diagnosis & strategy with your team' },
      { es: 'Sistema visual + manual corporativo interactivo', en: 'Visual system + interactive corporate manual' },
      { es: 'Papelería, presentación corporativa y kit digital', en: 'Stationery, corporate deck & digital kit' },
      { es: 'Animación de logo incluida (MP4)', en: 'Logo animation included (MP4)' },
      { es: '30 días de acompañamiento post entrega', en: '30 days of post-delivery support' },
    ],
    time: { es: 'Duración: 8–12 semanas · cotización a medida', en: 'Timeline: 8–12 weeks · tailored quote' },
    full: [
      { es: 'Etapa 1 — Diagnóstico: reunión con el equipo + análisis de identidad actual', en: 'Stage 1 — Diagnosis: team session + current identity analysis' },
      { es: 'Estudio de competencia y posicionamiento', en: 'Competitor & positioning study' },
      { es: 'Concepto creativo con fundamentación estratégica', en: 'Creative concept with strategic rationale' },
      { es: 'Etapa 2 — Sistema visual completo (todas las variantes)', en: 'Stage 2 — Full visual system (all variants)' },
      { es: 'Paleta primaria y secundaria (HEX, RGB, CMYK, Pantone)', en: 'Primary & secondary palettes (HEX, RGB, CMYK, Pantone)' },
      { es: 'Tipografías, recursos gráficos y reglas de composición', en: 'Type, graphic assets & composition rules' },
      { es: 'Etapa 3 — Manual corporativo interactivo (PDF)', en: 'Stage 3 — Interactive corporate manual (PDF)' },
      { es: 'Etapa 4 — Aplicaciones: papelería institucional completa', en: 'Stage 4 — Applications: full corporate stationery' },
      { es: 'Firma de mail (individual y para equipo)', en: 'Email signature (individual & team)' },
      { es: 'Plantilla de presentación corporativa editable', en: 'Editable corporate deck template' },
      { es: 'Kit de redes: portadas, perfil y plantillas de posteo', en: 'Social kit: covers, avatar & post templates' },
      { es: 'Animación de construcción de logo (MP4)', en: 'Logo build animation (MP4)' },
      { es: 'Etapa 5 — 30 días de consultas + sesión de revisión final', en: 'Stage 5 — 30 days of support + final review session' },
    ],
  },
];

const wa = (p: { fullName: string }) => `${site.whatsapp}?text=${encodeURIComponent(`Hola Eve! Quiero contratar el pack ${p.fullName}.`)}`;
---

<section class="packs" id="packs" aria-label="Packs de branding">
  <div class="wrap">
    <header class="pk-head">
      <p class="pk-kicker mono cap rise"><T es="Packs de branding" en="Branding packs" /></p>
      <h2 class="pk-title rise rise-delay-1">
        <T es="Tu marca, lista para despegar." en="Your brand, ready for take-off." />
      </h2>
      <p class="pk-sub rise rise-delay-2">
        <T
          es="Tres alcances claros, pensados para emprendimientos y empresas que entienden el diseño como inversión. Y un diferencial: mis identidades nacen pensadas para moverse — la animación de tu logo va incluida."
          en="Three clear scopes, for ventures and companies that see design as an investment. Plus a differentiator: my identities are born to move — your logo animation is included."
        />
      </p>
    </header>

    <div class="pk-grid">
      {packs.map((p, i) => (
        <article class:list={['pack', 'rise', `rise-delay-${i + 1}`, { 'is-featured': p.featured }]}>
          {p.featured && (
            <span class="pk-tag mono cap"><T es="El más elegido" en="Most chosen" /></span>
          )}
          <span class="pk-num mono">{p.num}</span>
          <h3 class="pk-name">
            <span class="pk-name-pre mono cap"><T es="Identidad Visual" en="Visual Identity" /></span>
            {p.name}
          </h3>
          <p class="pk-who"><span data-es={p.who.es} data-en={p.who.en}>{p.who.es}</span></p>
          <ul class="pk-items">
            {p.items.map((it) => (
              <li><span data-es={it.es} data-en={it.en}>{it.es}</span></li>
            ))}
          </ul>
          <details class="pk-full">
            <summary class="mono"><T es="Ver alcance completo" en="See full scope" /> <span aria-hidden="true">+</span></summary>
            <ul>
              {p.full.map((it) => (
                <li><span data-es={it.es} data-en={it.en}>{it.es}</span></li>
              ))}
            </ul>
          </details>
          <p class="pk-time mono"><span data-es={p.time.es} data-en={p.time.en}>{p.time.es}</span></p>
          <div class="pk-ctas">
            <a class="pk-wa" href={wa(p)} target="_blank" rel="noopener noreferrer" data-glow-dock>
              <T es="Contratar" en="Book" />
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <p class="pk-audit mono rise">
      <T
        es="Servicio adicional — Auditoría de Identidad Visual · diagnóstico profesional en 7–10 días · el mejor primer paso"
        en="Add-on service — Visual Identity Audit · professional diagnosis in 7–10 days · the best first step"
      />
    </p>

    <div class="pk-custom rise">
      <p class="pkc-q"><T es="¿Buscás algo distinto?" en="Looking for something different?" /></p>
      <p class="pkc-sub"><T es="Escribime y ponemos tu proyecto en marcha." en="Write me and let's get your project moving." /></p>
      <a class="pkc-btn" href="#contacto" data-open-contact data-glow-dock>
        <T es="Escribime" en="Write me" />
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .packs { padding-block: clamp(72px, 13vh, 160px) clamp(24px, 4vh, 56px); }

  .pk-head { max-width: 60ch; margin-bottom: clamp(36px, 6vh, 64px); }
  .pk-kicker { color: var(--ink-45); margin-bottom: clamp(16px, 2.5vh, 26px); display: block; }
  .pk-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.9rem, 4.2vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .pk-sub {
    margin-top: 16px;
    font-family: var(--sans);
    font-size: clamp(0.95rem, 1.15vw, 1.1rem);
    line-height: 1.5;
    color: var(--ink-80);
    max-width: 52ch;
  }

  .pk-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(14px, 1.6vw, 24px);
    align-items: stretch;
  }
  .pack {
    position: relative;
    display: flex; flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(20px, 2.2vw, 32px);
    background: color-mix(in oklab, var(--paper) 72%, transparent);
    transition: border-color var(--dur-ui) var(--ease-quint), transform var(--dur-ui) var(--ease-out);
  }
  .pack:hover { border-color: var(--ink-45); transform: translateY(-3px); }
  .pack.is-featured { border-color: var(--ink); }

  .pk-tag {
    position: absolute; top: -11px; left: clamp(18px, 2vw, 30px);
    background: var(--ink); color: var(--paper);
    padding: 4px 12px; border-radius: 20px;
    font-size: 10px !important;
  }
  .pk-num { color: var(--ink-35); margin-bottom: clamp(18px, 3vh, 30px); }
  .pk-name {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    letter-spacing: -0.015em;
    margin-bottom: 8px;
    display: flex; flex-direction: column; gap: 6px;
  }
  .pk-name-pre { color: var(--ink-45); font-size: 10px !important; letter-spacing: 0.14em; }
  .pk-who {
    font-family: var(--sans);
    font-size: clamp(0.9rem, 1vw, 1rem);
    color: var(--ink-60);
    margin-bottom: clamp(16px, 2.5vh, 24px);
    min-height: 2.6em;
  }
  .pk-items { list-style: none; margin-bottom: clamp(16px, 2.5vh, 24px); }
  .pk-items li {
    font-family: var(--sans);
    font-size: clamp(0.88rem, 1vw, 0.98rem);
    color: var(--ink-80);
    padding-block: 9px;
    border-top: 1px solid var(--ink-12);
    display: flex; gap: 10px;
  }
  .pk-items li::before { content: '·'; color: var(--ink-35); }
  /* alcance completo desplegable: síntesis arriba, detalle a un clic */
  .pk-full { margin-bottom: clamp(14px, 2vh, 20px); }
  .pk-full summary {
    cursor: pointer;
    list-style: none;
    color: var(--ink-60);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color var(--dur-micro) var(--ease-quint);
  }
  .pk-full summary::-webkit-details-marker { display: none; }
  .pk-full summary:hover { color: var(--ink); }
  .pk-full[open] summary span[aria-hidden] { display: inline-block; transform: rotate(45deg); }
  .pk-full ul { list-style: none; margin-top: 10px; }
  .pk-full li {
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--ink-60);
    padding-block: 6px;
    border-top: 1px solid var(--ink-06);
    display: flex; gap: 9px;
  }
  .pk-full li::before { content: '·'; color: var(--ink-35); }

  .pk-time { color: var(--ink-45); margin-bottom: clamp(18px, 3vh, 28px); }

  .pk-ctas { margin-top: auto; display: flex; justify-content: center; }
  .pk-wa {
    display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    padding: 12px 34px;
    border-radius: 40px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 13.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: opacity var(--dur-micro) var(--ease-quint);
  }
  .pk-wa:hover { opacity: 0.85; }
  .pack.is-featured .pk-wa { background: var(--orange); color: #fff; }

  .pk-audit {
    margin-top: clamp(24px, 4vh, 40px);
    text-align: center;
    color: var(--ink-45);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pk-custom {
    margin-top: clamp(40px, 7vh, 72px);
    text-align: center;
  }
  .pkc-q {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .pkc-sub {
    margin-top: 10px;
    font-family: var(--sans);
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    color: var(--ink-60);
  }
  .pkc-btn {
    display: inline-flex; align-items: center; gap: 10px;
    margin-top: clamp(18px, 3vh, 28px);
    padding: 13px 30px;
    border-radius: 40px;
    border: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 14px;
    letter-spacing: 0.02em;
    transition: background var(--dur-micro) var(--ease-quint), color var(--dur-micro) var(--ease-quint);
  }
  .pkc-btn:hover { background: var(--ink); color: var(--paper); }

  @media (max-width: 900px) {
    .pk-grid { grid-template-columns: 1fr; max-width: 520px; }
    .pk-who { min-height: 0; }
  }
</style>
