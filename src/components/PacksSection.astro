---
/* ============================================================
   PacksSection — 3 packs de branding preestablecidos.
   CTA primario: WhatsApp con mensaje prellenado por pack.
   CTA secundario: mail con asunto prellenado.
   Cierre: puente a #contacto para proyectos a medida.
   Contenido placeholder: alcances/tiempos se ajustan con Eve.
   ============================================================ */
import { site } from '../data/site';
import T from './T.astro';

/* Paquetes reales de Eve (doc "Servicios de diseño", feb 2026),
   condensados para la web. Los precios se suman cuando Eve los confirme. */
const packs = [
  {
    num: '01',
    name: 'Esencial',
    fullName: 'Identidad Visual Esencial',
    who: { es: 'Para emprendedores y marcas que arrancan.', en: 'For founders and brands just starting out.' },
    price: { ars: 'ARS 1.400.000', usd: 'USD 950' },
    items: [
      { es: 'Logotipo principal + variante', en: 'Primary logo + variant' },
      { es: 'Paleta de color y sistema tipográfico', en: 'Color palette & type system' },
      { es: 'Kit para redes (perfil, highlights, posteo base)', en: 'Social kit (avatar, highlights, base post)' },
      { es: '2 patterns de marca + brand board', en: '2 brand patterns + brand board' },
      { es: 'Guía de estilo esencial (PDF) + editables', en: 'Essential style guide (PDF) + source files' },
      { es: 'Presentación final con asesoría', en: 'Final walkthrough & guidance' },
    ],
    time: { es: 'Duración: 4 semanas · 2 rondas de revisión', en: 'Timeline: 4 weeks · 2 revision rounds' },
    full: [
      { es: 'Brief inicial de marca (llamada de 30 min)', en: 'Initial brand brief (30-min call)' },
      { es: 'Logotipo principal + variante (PNG y PDF)', en: 'Primary logo + variant (PNG & PDF)' },
      { es: 'Paleta de colores de marca', en: 'Brand color palette' },
      { es: 'Sistema tipográfico (primaria y secundaria)', en: 'Type system (primary & secondary)' },
      { es: 'Highlights para Instagram (hasta 5)', en: 'Instagram highlights (up to 5)' },
      { es: '2 patterns de marca (PNG y AI)', en: '2 brand patterns (PNG & AI)' },
      { es: 'Posteo base para redes con el logo', en: 'Base social post with the logo' },
      { es: 'Imagen de perfil optimizada para redes', en: 'Optimized profile image' },
      { es: 'Brand board completo (PDF)', en: 'Full brand board (PDF)' },
      { es: 'Guía de estilo visual esencial (PDF)', en: 'Essential visual style guide (PDF)' },
      { es: 'Reunión final de presentación y asesoría', en: 'Final walkthrough & guidance session' },
      { es: 'Archivo editable AI + carpetas organizadas (PDF, PNG, SVG)', en: 'Editable AI file + organized folders (PDF, PNG, SVG)' },
      { es: 'Add-on opcional: animación de logo (MP4 para Reels e intros)', en: 'Optional add-on: logo animation (MP4 for Reels & intros)' },
    ],
  },
  {
    num: '02',
    name: 'Profesional',
    fullName: 'Identidad Visual Profesional',
    featured: true,
    who: { es: 'Para marcas en crecimiento y profesionales establecidos.', en: 'For growing brands and established professionals.' },
    price: { ars: 'ARS 3.000.000', usd: 'USD 2.000' },
    items: [
      { es: 'Estrategia: brief profundo, competencia y concepto', en: 'Strategy: deep brief, competitors & concept' },
      { es: 'Sistema visual completo (logos, color, tipografía)', en: 'Full visual system (logos, color, type)' },
      { es: 'Brandbook + definición de estilo de marca', en: 'Brandbook + brand style definition' },
      { es: 'Aplicaciones: redes, firma de mail, tarjeta, plantillas', en: 'Applications: social, email signature, card, templates' },
      { es: 'Animación de logo incluida (MP4)', en: 'Logo animation included (MP4)' },
    ],
    time: { es: 'Duración: 6–8 semanas · 2 rondas por etapa', en: 'Timeline: 6–8 weeks · 2 rounds per stage' },
    full: [
      { es: 'Etapa 1 — Estrategia: brief en profundidad + reunión de inicio', en: 'Stage 1 — Strategy: in-depth brief + kickoff' },
      { es: 'Análisis de competencia y referencias', en: 'Competitor & reference analysis' },
      { es: 'Personalidad de marca, valores y tono visual', en: 'Brand personality, values & visual tone' },
      { es: 'Concepto creativo que guía todo el proyecto', en: 'Creative concept guiding the whole project' },
      { es: 'Etapa 2 — Sistema: logo principal, secundario, isotipo y variantes', en: 'Stage 2 — System: primary & secondary logos, mark & variants' },
      { es: 'Paleta con códigos HEX, RGB y CMYK', en: 'Palette with HEX, RGB & CMYK specs' },
      { es: 'Sistema tipográfico con jerarquías', en: 'Type system with hierarchies' },
      { es: 'Recursos gráficos: patterns, íconos o texturas', en: 'Graphic assets: patterns, icons or textures' },
      { es: 'Etapa 3 — Brandbook: manual de identidad completo (PDF)', en: 'Stage 3 — Brandbook: full identity manual (PDF)' },
      { es: 'Definición de estilo de marca (moodboard + estilo fotográfico)', en: 'Brand style definition (moodboard + photo style)' },
      { es: 'Portadas y perfil para redes + firma de mail + tarjeta', en: 'Social covers & avatar + email signature + business card' },
      { es: 'Plantilla de story editable', en: 'Editable story template' },
      { es: 'Animación de construcción de logo (MP4)', en: 'Logo build animation (MP4)' },
      { es: 'Editables AI + carpetas organizadas', en: 'AI source files + organized folders' },
    ],
  },
  {
    num: '03',
    name: 'Corporativa',
    fullName: 'Identidad Visual Corporativa',
    who: { es: 'Para PyMEs, empresas y organizaciones con estructura.', en: 'For SMEs, companies and structured organizations.' },
    price: { ars: 'ARS 5.250.000', usd: 'USD 3.500', desde: true },
    items: [
      { es: 'Diagnóstico y estrategia con tu equipo', en: 'Diagnosis & strategy with your team' },
      { es: 'Sistema visual + manual corporativo interactivo', en: 'Visual system + interactive corporate manual' },
      { es: 'Papelería, presentación corporativa y kit digital', en: 'Stationery, corporate deck & digital kit' },
      { es: 'Animación de logo incluida (MP4)', en: 'Logo animation included (MP4)' },
      { es: '30 días de acompañamiento post entrega', en: '30 days of post-delivery support' },
    ],
    time: { es: 'Duración: 8–12 semanas · cotización a medida', en: 'Timeline: 8–12 weeks · tailored quote' },
    full: [
      { es: 'Etapa 1 — Diagnóstico: reunión con el equipo + análisis de identidad actual', en: 'Stage 1 — Diagnosis: team session + current identity analysis' },
      { es: 'Estudio de competencia y posicionamiento', en: 'Competitor & positioning study' },
      { es: 'Concepto creativo con fundamentación estratégica', en: 'Creative concept with strategic rationale' },
      { es: 'Etapa 2 — Sistema visual completo (todas las variantes)', en: 'Stage 2 — Full visual system (all variants)' },
      { es: 'Paleta primaria y secundaria (HEX, RGB, CMYK, Pantone)', en: 'Primary & secondary palettes (HEX, RGB, CMYK, Pantone)' },
      { es: 'Tipografías, recursos gráficos y reglas de composición', en: 'Type, graphic assets & composition rules' },
      { es: 'Etapa 3 — Manual corporativo interactivo (PDF)', en: 'Stage 3 — Interactive corporate manual (PDF)' },
      { es: 'Etapa 4 — Aplicaciones: papelería institucional completa', en: 'Stage 4 — Applications: full corporate stationery' },
      { es: 'Firma de mail (individual y para equipo)', en: 'Email signature (individual & team)' },
      { es: 'Plantilla de presentación corporativa editable', en: 'Editable corporate deck template' },
      { es: 'Kit de redes: portadas, perfil y plantillas de posteo', en: 'Social kit: covers, avatar & post templates' },
      { es: 'Animación de construcción de logo (MP4)', en: 'Logo build animation (MP4)' },
      { es: 'Etapa 5 — 30 días de consultas + sesión de revisión final', en: 'Stage 5 — 30 days of support + final review session' },
    ],
  },
];

const wa = (p: { fullName: string }) => `${site.whatsapp}?text=${encodeURIComponent(`Hola Eve! Quiero contratar el pack ${p.fullName}.`)}`;
---

<section class="packs" id="packs" aria-label="Packs de branding">
  <div class="wrap">
    <header class="pk-head">
      <p class="pk-kicker mono cap rise"><T es="Packs de branding" en="Branding packs" /></p>
      <h2 class="pk-title rise rise-delay-1">
        <T es="Tu marca, lista para despegar." en="Your brand, ready for take-off." />
      </h2>
      <p class="pk-sub rise rise-delay-2">
        <T
          es="Tres alcances claros, pensados para emprendimientos y empresas que entienden el diseño como inversión. Y un diferencial: mis identidades nacen pensadas para moverse — la animación de tu logo va incluida."
          en="Three clear scopes, for ventures and companies that see design as an investment. Plus a differentiator: my identities are born to move — your logo animation is included."
        />
      </p>
    </header>

    <div class="pk-list">
      {packs.map((p, i) => (
        <article class:list={['pk-row', { 'is-featured': p.featured }]} data-pk data-open="false">
          <button class="pk-hd" type="button" aria-expanded="false" aria-controls={`pk-panel-${i}`}>
            <span class="pk-num mono">{p.num}</span>
            <span class="pk-id">
              <span class="pk-pre mono cap">
                <T es="Identidad Visual" en="Visual Identity" />
                {p.featured && <span class="pk-tag"><T es="El más elegido" en="Most chosen" /></span>}
              </span>
              <b class="pk-name" data-pk-name>{p.name}</b>
              <span class="pk-who"><span data-es={p.who.es} data-en={p.who.en}>{p.who.es}</span></span>
            </span>
            <span class="pk-price">
              {p.price.desde && <span class="pp-desde mono" data-es="desde" data-en="from">desde</span>}
              <span class="pp-ars" data-pk-count>{p.price.ars}</span>
              <span class="pp-usd mono" data-pk-count>{p.price.usd}</span>
            </span>
            <span class="pk-plus" aria-hidden="true">+</span>
          </button>

          <div class="pk-quick">
            <ul class="pk-key">
              {p.items.slice(0, 3).map((it) => (
                <li><span data-es={it.es} data-en={it.en}>{it.es}</span></li>
              ))}
            </ul>
            <div class="pk-act">
              <a class="pk-wa" href={wa(p)} target="_blank" rel="noopener noreferrer" data-glow-dock>
                <T es="Contratar" en="Book" />
                <span aria-hidden="true">↗</span>
              </a>
            </div>
            <p class="pk-time mono"><span data-es={p.time.es} data-en={p.time.en}>{p.time.es}</span></p>
            <button class="pk-more mono" type="button" data-pk-more aria-controls={`pk-panel-${i}`}>
              <T es="Ver alcance completo" en="See full scope" /> <span aria-hidden="true">+</span>
            </button>
          </div>

          <div class="pk-panel" id={`pk-panel-${i}`}>
            <div class="pk-panel-in">
              <div class="pk-scope">
                <p class="pk-scope-t mono cap"><T es="Alcance completo" en="Full scope" /></p>
                <ul>
                  {p.full.map((it) => (
                    <li><span data-es={it.es} data-en={it.en}>{it.es}</span></li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="pk-audit mono rise">
      <T
        es="Servicio adicional — Auditoría de Identidad Visual · diagnóstico profesional en 7–10 días · ARS 720.000 / USD 480"
        en="Add-on service — Visual Identity Audit · professional diagnosis in 7–10 days · ARS 720.000 / USD 480"
      />
    </p>

    <div class="pk-custom rise">
      <p class="pkc-q"><T es="¿Buscás algo distinto?" en="Looking for something different?" /></p>
      <p class="pkc-sub"><T es="Escribime y ponemos tu proyecto en marcha." en="Write me and let's get your project moving." /></p>
      <a class="pkc-btn" href="#contacto" data-open-contact data-glow-dock>
        <T es="Escribime" en="Write me" />
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .packs { padding-block: clamp(72px, 13vh, 160px) clamp(24px, 4vh, 56px); }

  .pk-head { max-width: 60ch; margin-bottom: clamp(36px, 6vh, 64px); }
  .pk-kicker { color: var(--ink-45); margin-bottom: clamp(16px, 2.5vh, 26px); display: block; }
  .pk-title {
    font-family: var(--serif); font-weight: 400;
    font-size: clamp(1.9rem, 4.2vw, 3.4rem); line-height: 1.05; letter-spacing: -0.02em;
  }
  .pk-sub {
    margin-top: 16px; font-family: var(--sans);
    font-size: clamp(0.95rem, 1.15vw, 1.1rem); line-height: 1.5; color: var(--ink-80); max-width: 52ch;
  }

  /* ---------- filas tipográficas ---------- */
  .pk-list { border-top: 1px solid var(--ink); }
  .pk-row { position: relative; border-bottom: 1px solid var(--line); }

  .pk-hd {
    width: 100%; display: grid; align-items: center; text-align: left;
    grid-template-columns: clamp(34px, 4vw, 64px) minmax(0, 1fr) auto 36px;
    gap: 0 clamp(10px, 2vw, 32px);
    padding-block: clamp(22px, 3.6vh, 40px) clamp(14px, 2vh, 22px);
    cursor: pointer; color: var(--ink);
  }
  .pk-num { color: var(--ink-35); align-self: start; padding-top: 0.6em; }
  .pk-id { display: grid; gap: 6px; min-width: 0; }
  .pk-pre { color: var(--ink-45); font-size: 10px !important; letter-spacing: 0.14em; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
  .pk-tag {
    background: var(--orange); color: #fff; padding: 3px 10px; border-radius: 20px;
    font-size: 10px; letter-spacing: 0.1em;
  }
  .pk-name {
    font-family: var(--serif); font-weight: 300; font-style: normal;
    font-size: clamp(2.8rem, 9vw, 8rem); line-height: 0.98; letter-spacing: -0.045em;
    color: var(--ink); padding-bottom: 0.04em;
    transition: color var(--dur-ui) var(--ease-quint);
  }
  .pk-who { font-family: var(--sans); font-size: clamp(0.9rem, 1vw, 1rem); color: var(--ink-60); margin-top: 2px; }

  /* con mouse: el nombre está en gris y la luz del cursor lo enciende */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .pk-name {
      --bx: -9999px; --by: -9999px; --br: 0px; --base: rgba(22, 21, 15, 0.3);
      color: var(--base);
      background-image: radial-gradient(circle var(--br) at var(--bx) var(--by), #16150f 0%, rgba(22, 21, 15, 0.9) 45%, var(--base) 100%);
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    }
    .pk-row.open .pk-name, .pk-row:focus-within .pk-name { --base: rgba(22, 21, 15, 0.85); }
  }

  .pk-price { display: grid; justify-items: end; gap: 6px; text-align: right; white-space: nowrap; }
  .pp-desde { color: var(--ink-45); font-size: 11px !important; letter-spacing: 0.1em; text-transform: uppercase; }
  .pp-ars { font-family: var(--serif); font-weight: 300; font-size: clamp(1.4rem, 2.6vw, 2.4rem); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .pp-usd { font-family: var(--mono); color: var(--ink-60); font-size: clamp(11px, 1vw, 13px); letter-spacing: 0.06em; font-variant-numeric: tabular-nums; }
  /* en inglés, el protagonista es el USD */
  :global(html[lang='en']) .pp-ars { order: 3; font-family: var(--mono); font-size: clamp(11px, 1vw, 13px); letter-spacing: 0.06em; color: var(--ink-60); }
  :global(html[lang='en']) .pp-usd { order: 1; font-family: var(--serif); font-weight: 300; font-size: clamp(1.4rem, 2.6vw, 2.4rem); letter-spacing: -0.02em; color: var(--ink); }

  .pk-plus {
    width: 36px; height: 36px; border: 1px solid var(--ink-35); border-radius: 50%;
    display: grid; place-items: center; font-family: var(--sans); font-size: 18px; line-height: 1; color: var(--ink);
    transition: transform var(--dur-ui) var(--ease-out), background var(--dur-micro) var(--ease-quint), color var(--dur-micro) var(--ease-quint);
  }
  .pk-hd:hover .pk-plus { background: var(--ink); color: var(--paper); }
  .pk-row.open .pk-plus { transform: rotate(45deg); }

  /* ---------- panel con el alcance completo ---------- */
  .pk-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.7s var(--ease-out); }
  .pk-row.open .pk-panel { grid-template-rows: 1fr; }
  .pk-panel-in { overflow: hidden; min-height: 0; }
  /* franja siempre visible: 3 claves + Contratar (para comparar de un vistazo) */
  .pk-quick {
    --ind: calc(clamp(34px, 4vw, 64px) + clamp(10px, 2vw, 32px));
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end;
    gap: 16px clamp(20px, 3vw, 48px);
    padding: 0 0 clamp(22px, 3.4vh, 36px) var(--ind);
  }
  .pk-key { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 clamp(16px, 2.4vw, 36px); }
  .pk-key li {
    font-family: var(--sans); font-size: clamp(0.86rem, 0.95vw, 0.95rem); line-height: 1.45; color: var(--ink-80);
    padding-top: 10px; border-top: 1px solid var(--ink-12);
  }
  .pk-act { grid-column: 2; grid-row: 1; }
  .pk-time { grid-column: 1; grid-row: 2; color: var(--ink-45); }
  .pk-more {
    grid-column: 2; grid-row: 2; justify-self: end; cursor: pointer;
    color: var(--ink-60); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    transition: color var(--dur-micro) var(--ease-quint);
  }
  .pk-more:hover { color: var(--ink); }
  .pk-more span { display: inline-block; transition: transform var(--dur-ui) var(--ease-out); }
  .pk-row.open .pk-more span { transform: rotate(45deg); }

  .pk-scope {
    min-height: 0; opacity: 0; transform: translateY(14px);
    padding: 4px 0 clamp(28px, 5vh, 48px) calc(clamp(34px, 4vw, 64px) + clamp(10px, 2vw, 32px));
    transition: opacity 0.5s var(--ease-out), transform 0.7s var(--ease-out);
  }
  .pk-row.open .pk-scope { opacity: 1; transform: none; transition-delay: 0.18s; }
  .pk-scope-t { color: var(--ink-45); font-size: 10px !important; letter-spacing: 0.12em; margin-bottom: 8px; }
  .pk-scope ul { list-style: none; columns: 2; column-gap: clamp(20px, 3vw, 44px); }
  .pk-scope li {
    break-inside: avoid; font-family: var(--sans); font-size: 0.92rem; line-height: 1.5; color: var(--ink-80);
    padding-block: 9px; border-top: 1px solid var(--ink-12); display: flex; gap: 10px;
  }
  .pk-scope li::before { content: '·'; color: var(--ink-35); }

  .pk-wa {
    display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    padding: 12px 34px; border-radius: 40px; background: var(--ink); color: var(--paper);
    font-family: var(--sans); font-size: 13.5px; letter-spacing: 0.04em; text-transform: uppercase;
    transition: opacity var(--dur-micro) var(--ease-quint);
  }
  .pk-wa:hover { opacity: 0.85; }
  .pk-row.is-featured .pk-wa { background: var(--orange); color: #fff; }

  .pk-audit {
    margin-top: clamp(24px, 4vh, 40px); text-align: left; color: var(--ink-45);
    font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .pk-custom { margin-top: clamp(40px, 7vh, 72px); text-align: left; }
  .pkc-q { font-family: var(--serif); font-weight: 400; font-size: clamp(1.4rem, 2.6vw, 2.2rem); letter-spacing: -0.015em; color: var(--ink); }
  .pkc-sub { margin-top: 10px; font-family: var(--sans); font-size: clamp(0.95rem, 1.1vw, 1.05rem); color: var(--ink-60); }
  .pkc-btn {
    display: inline-flex; align-items: center; gap: 10px; margin-top: clamp(18px, 3vh, 28px);
    padding: 13px 30px; border-radius: 40px; border: 1px solid var(--ink); color: var(--ink);
    font-family: var(--sans); font-size: 14px; letter-spacing: 0.02em;
    transition: background var(--dur-micro) var(--ease-quint), color var(--dur-micro) var(--ease-quint);
  }
  .pkc-btn:hover { background: var(--ink); color: var(--paper); }

  @media (max-width: 860px) {
    .pk-hd { grid-template-columns: 28px minmax(0, 1fr) 36px; }
    .pk-price { grid-column: 2; grid-row: 2; justify-items: start; text-align: left; margin-top: 10px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
    .pk-plus { grid-column: 3; grid-row: 1; }
    .pk-name { font-size: clamp(2.4rem, 13vw, 4rem); }
    .pk-quick { grid-template-columns: 1fr; padding-left: 0; }
    .pk-key { grid-template-columns: 1fr; gap: 0; }
    .pk-act, .pk-time, .pk-more { grid-column: 1; grid-row: auto; justify-self: start; }
    .pk-scope { padding-left: 0; }
    .pk-scope ul { columns: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pk-panel, .pk-scope, .pk-plus { transition: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-pk]'));

  /* ---------- acordeón: una fila abierta a la vez ---------- */
  const setOpen = (row: HTMLElement, open: boolean) => {
    row.classList.toggle('open', open);
    row.querySelector('.pk-hd')?.setAttribute('aria-expanded', String(open));
    row.querySelector('[data-pk-more]')?.setAttribute('aria-expanded', String(open));
    const panel = row.querySelector<HTMLElement>('.pk-panel');
    if (panel) { if (open) panel.removeAttribute('inert'); else panel.setAttribute('inert', ''); }
  };
  rows.forEach((row) => {
    setOpen(row, row.dataset.open === 'true');
    const toggle = () => {
      const willOpen = !row.classList.contains('open');
      rows.forEach((r) => setOpen(r, r === row ? willOpen : false));
    };
    row.querySelector('.pk-hd')?.addEventListener('click', toggle);
    row.querySelector('[data-pk-more]')?.addEventListener('click', toggle);
  });

  /* ---------- los precios cuentan hasta su valor al entrar (una vez) ---------- */
  const fmt = (n: number) => String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  const countEls = Array.from(document.querySelectorAll<HTMLElement>('.pk-price [data-pk-count]'));
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement; io.unobserve(el);
      const txt = el.textContent || '';
      const m = txt.match(/^(\D*)([\d.]+)(.*)$/);
      if (!m) return;
      const to = parseInt(m[2].replace(/\./g, ''), 10), t0 = performance.now(), D = 1300;
      const tick = (now: number) => {
        const p = Math.min(1, (now - t0) / D), v = to * (1 - Math.pow(1 - p, 3));
        el.textContent = m[1] + (p < 1 ? fmt(v) : m[2]) + m[3];
        if (p < 1) requestAnimationFrame(tick);
      };
      el.textContent = m[1] + '0' + m[3];
      requestAnimationFrame(tick);
    }), { threshold: 0.8 });
    countEls.forEach((el) => io.observe(el));
  }

  /* ---------- la luz del cursor enciende el nombre de la fila ---------- */
  if (fine && !reduce) {
    const names = rows.map((r) => r.querySelector<HTMLElement>('[data-pk-name]'));
    let px = -1e5, py = -1e5, bx = -1e5, by = -1e5, la = 0, raf = 0, last = 0;
    const frame = (now: number) => {
      const dt = Math.min(0.05, Math.max(0.001, (now - last) / 1000)); last = now;
      const on = px > -9e4;
      if (on && bx < -9e4) { bx = px; by = py; }
      if (on) { const k = 1 - Math.exp(-9 * dt); bx += (px - bx) * k; by += (py - by) * k; }
      la += ((on ? 1 : 0) - la) * (1 - Math.exp(-8 * dt));
      const R = (260 * la).toFixed(1) + 'px';
      names.forEach((el) => {
        if (!el) return;
        const r = el.getBoundingClientRect();
        if (r.bottom < -50 || r.top > innerHeight + 50) return;
        el.style.setProperty('--bx', (bx - r.left).toFixed(1) + 'px');
        el.style.setProperty('--by', (by - r.top).toFixed(1) + 'px');
        el.style.setProperty('--br', R);
      });
      const busy = (on && Math.hypot(px - bx, py - by) > 0.4) || Math.abs((on ? 1 : 0) - la) > 0.004;
      raf = busy ? requestAnimationFrame(frame) : 0;
    };
    const kick = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); } };
    const list = document.querySelector('.pk-list');
    list?.addEventListener('pointermove', (e) => { px = (e as PointerEvent).clientX; py = (e as PointerEvent).clientY; kick(); }, { passive: true });
    list?.addEventListener('pointerleave', () => { px = py = -1e5; kick(); });
    addEventListener('scroll', () => { if (la > 0.01) kick(); }, { passive: true });
  }
</script>
