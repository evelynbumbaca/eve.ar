---
/* ============================================================
   SiteFooter — cierre del one-page = sección CONTACTO (#contacto).
   CTA claro para proyectos A MEDIDA (distinto de los packs):
   mail prellenado + WhatsApp + redes. Luego la base legal.
   ============================================================ */
import { social, site } from '../data/site';
import T from './T.astro';

const mailHref = `mailto:${site.email}?subject=${encodeURIComponent('Proyecto a medida')}`;
const waHref = `${site.whatsapp}?text=${encodeURIComponent('Hola Eve! Tengo un proyecto para contarte.')}`;
---

<footer class="site-foot" id="contacto">
  <div class="wrap">
    <div class="foot-cta">
      <p class="foot-kicker mono cap rise"><T es="Contacto" en="Contact" /></p>
      <p class="foot-line rise rise-delay-1">
        <T es="¿Otro proyecto, una idea, una colaboración?" en="Another project, an idea, a collaboration?" />
      </p>
      <p class="foot-sub rise rise-delay-2">
        <T
          es="No hace falta que sea un pack: contame qué necesitás — identidad, editorial, UX/UI, packaging o algo que todavía no tiene nombre — y lo armamos a medida."
          en="It doesn't have to be a pack: tell me what you need — identity, editorial, UX/UI, packaging or something that doesn't have a name yet — and we'll shape it together."
        />
      </p>
      <div class="foot-actions rise rise-delay-3">
        <a class="fa-mail" href={mailHref}>
          <T es="Escribime" en="Email me" />
          <span aria-hidden="true">→</span>
        </a>
        <a class="fa-wa" href={waHref} target="_blank" rel="noopener noreferrer">
          WhatsApp <span aria-hidden="true">↗</span>
        </a>
        <span class="fa-addr mono">{site.email}</span>
      </div>
    </div>

    <div class="foot-grid">
      <span class="mono cap"><T k="footer.work" /></span>
      <nav class="foot-social" aria-label="Redes">
        {social.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
        ))}
      </nav>
    </div>

    <div class="foot-base">
      <span>© {new Date().getFullYear()} {site.name} — {site.domain}</span>
      <span><T k="footer.rights" /></span>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    border-top: 1px solid var(--line);
    margin-top: clamp(40px, 8vh, 100px);
    padding-block: clamp(56px, 10vh, 120px) clamp(28px, 4vh, 44px);
  }

  .foot-cta { padding-bottom: clamp(44px, 8vh, 90px); }
  .foot-kicker { color: var(--ink-45); margin-bottom: clamp(16px, 2.5vh, 26px); display: block; }
  .foot-line {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.9rem, 4.6vw, 3.8rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 22ch;
  }
  .foot-sub {
    margin-top: 18px;
    font-family: var(--sans);
    font-size: clamp(0.95rem, 1.15vw, 1.1rem);
    line-height: 1.55;
    color: var(--ink-80);
    max-width: 56ch;
  }
  .foot-actions {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 14px 22px;
    margin-top: clamp(24px, 4vh, 40px);
  }
  .fa-mail {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 14px 28px;
    border-radius: 40px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 14.5px;
    letter-spacing: 0.02em;
    transition: opacity var(--dur-micro) var(--ease-quint);
  }
  .fa-mail:hover { opacity: 0.85; }
  .fa-wa {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 13px 24px;
    border-radius: 40px;
    border: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 14px;
    letter-spacing: 0.02em;
    transition: background var(--dur-micro) var(--ease-quint), color var(--dur-micro) var(--ease-quint);
  }
  .fa-wa:hover { background: var(--ink); color: var(--paper); }
  .fa-addr { color: var(--ink-45); }

  .foot-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 24px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
    color: var(--ink-60);
  }
  .foot-social { display: flex; flex-wrap: wrap; gap: 18px; }
  .foot-social a {
    font-family: var(--sans);
    font-size: var(--fs-small);
    letter-spacing: 0.02em;
    transition: opacity 0.2s var(--ease);
  }
  .foot-social a:hover { opacity: 0.55; }

  .foot-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(40px, 7vh, 72px);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-35);
  }
</style>
