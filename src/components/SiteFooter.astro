---
/* ============================================================
   SiteFooter — cierre del one-page = sección CONTACTO (#contacto).
   Un solo CTA "Contactame" que DESPLIEGA el formulario inline
   (sin backend: compone un mail prellenado, igual que /contacto).
   Luego redes y base legal.
   ============================================================ */
import { social, site } from '../data/site';
import T from './T.astro';
---

<footer class="site-foot" id="contacto">
  <div class="wrap">
    <div class="foot-cta">
      <p class="foot-kicker mono cap rise"><T es="Contacto" en="Contact" /></p>
      <p class="foot-line rise rise-delay-1">
        <T es="Contame el proyecto que tenés en mente." en="Tell me about the project on your mind." />
      </p>
      <p class="foot-sub rise rise-delay-2">
        <T
          es="Identidad, editorial, UX/UI, packaging o algo completamente nuevo — cada proyecto empieza con una buena conversación."
          en="Identity, editorial, UX/UI, packaging or something entirely new — every project starts with a good conversation."
        />
      </p>
      <div class="foot-actions rise rise-delay-3">
        <button class="fa-open" type="button" data-form-toggle data-glow-dock aria-expanded="false" aria-controls="foot-form">
          <T es="Contactame" en="Contact me" />
          <span aria-hidden="true">→</span>
        </button>
      </div>

      <form class="foot-form" id="foot-form" data-foot-form data-email={site.email} data-form-key={site.formKey} hidden novalidate>
        <div class="ff-row">
          <div class="ff-field">
            <label for="ff-name"><T es="Nombre" en="Name" /></label>
            <input id="ff-name" name="name" type="text" autocomplete="name" placeholder="Tu nombre" required />
          </div>
          <div class="ff-field">
            <label for="ff-email">Email</label>
            <input id="ff-email" name="email" type="email" autocomplete="email" placeholder="tu@mail.com" required />
          </div>
        </div>
        <div class="ff-field">
          <label for="ff-msg"><T es="Mensaje" en="Message" /></label>
          <textarea id="ff-msg" name="message" rows="5" placeholder="Contame qué tenés en mente: qué es, para cuándo, y todo lo que sume." required></textarea>
        </div>
        <div class="ff-foot">
          <p class="ff-note" data-ff-note aria-live="polite"></p>
          <button class="ff-send" type="submit" data-glow-dock>
            <T es="Enviar mensaje" en="Send message" />
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </form>
    </div>

    <div class="foot-grid">
      <nav class="foot-social" aria-label="Redes">
        {social.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
        ))}
      </nav>
    </div>

    <div class="foot-base">
      <span>© {new Date().getFullYear()} {site.name} — {site.domain}</span>
      <span><T k="footer.rights" /></span>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    border-top: 1px solid var(--line);
    margin-top: clamp(40px, 8vh, 100px);
    padding-block: clamp(56px, 10vh, 120px) clamp(28px, 4vh, 44px);
  }

  .foot-cta { padding-bottom: clamp(44px, 8vh, 90px); }
  .foot-kicker { color: var(--ink-45); margin-bottom: clamp(16px, 2.5vh, 26px); display: block; }
  .foot-line {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.9rem, 4.6vw, 3.8rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 22ch;
  }
  .foot-sub {
    margin-top: 18px;
    font-family: var(--sans);
    font-size: clamp(0.95rem, 1.15vw, 1.1rem);
    line-height: 1.55;
    color: var(--ink-80);
    max-width: 56ch;
  }
  .foot-actions { margin-top: clamp(24px, 4vh, 40px); }
  .fa-open {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 14px 30px;
    border-radius: 40px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 14.5px;
    letter-spacing: 0.02em;
    transition: opacity var(--dur-micro) var(--ease-quint);
  }
  .fa-open:hover { opacity: 0.85; }
  .fa-open[aria-expanded="true"] { opacity: 0.6; }

  /* formulario desplegable: tarjeta contenida, campos delimitados */
  .foot-form {
    max-width: 680px;
    margin-top: clamp(26px, 4vh, 44px);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: clamp(20px, 2.6vw, 36px);
    /* translúcido: deja pasar el halo de la luz detrás del botón */
    background: color-mix(in srgb, #ffffff 55%, transparent);
  }
  .foot-form:not([hidden]) { animation: ffIn 0.5s var(--ease-out) both; }
  @keyframes ffIn { from { opacity: 0; transform: translateY(14px); } }
  @media (prefers-reduced-motion: reduce) { .foot-form:not([hidden]) { animation: none; } }

  .ff-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 clamp(14px, 1.8vw, 24px); }
  .ff-field { margin-bottom: clamp(14px, 2.2vh, 22px); }
  .ff-field label {
    display: block;
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-60);
    margin-bottom: 8px;
  }
  .ff-field input,
  .ff-field textarea {
    width: 100%;
    background: #fff;
    border: 1px solid var(--ink-18);
    border-radius: 5px;
    padding: 12px 14px;
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink);
    transition: border-color var(--dur-micro) var(--ease-quint), box-shadow var(--dur-micro) var(--ease-quint);
  }
  .ff-field input::placeholder,
  .ff-field textarea::placeholder { color: var(--ink-35); }
  .ff-field input:focus,
  .ff-field textarea:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--orange) 18%, transparent);
  }
  .ff-field textarea { resize: vertical; }

  .ff-foot {
    display: flex; flex-wrap: wrap-reverse; align-items: center;
    justify-content: space-between; gap: 12px 20px;
    margin-top: 4px;
  }
  .ff-send {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 13px 30px;
    border-radius: 40px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 14px;
    letter-spacing: 0.02em;
    transition: opacity var(--dur-micro) var(--ease-quint);
  }
  .ff-send:hover { opacity: 0.85; }
  .ff-send[disabled] { opacity: 0.5; cursor: default; }
  .ff-note { font-size: var(--fs-small); color: var(--ink-60); min-height: 1em; }

  .foot-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 16px 24px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
    color: var(--ink-60);
  }
  .foot-social { display: flex; flex-wrap: wrap; gap: 18px; }
  .foot-social a {
    font-family: var(--sans);
    font-size: var(--fs-small);
    letter-spacing: 0.02em;
    transition: opacity 0.2s var(--ease);
  }
  .foot-social a:hover { opacity: 0.55; }

  .foot-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(40px, 7vh, 72px);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-35);
  }

  @media (max-width: 560px) {
    .ff-row { grid-template-columns: 1fr; gap: 0; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-form-toggle]');
  const form = document.querySelector<HTMLFormElement>('[data-foot-form]');

  const openForm = () => {
    if (!form || !toggle) return;
    form.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    const first = form.querySelector<HTMLInputElement>('input');
    first?.focus({ preventScroll: true });
  };

  if (toggle && form) {
    toggle.addEventListener('click', () => {
      const open = form.hidden;
      if (open) {
        openForm();
        form.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
      } else {
        form.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
      }
    });

    // CTA de otras secciones ("Escribime" en packs): scrollea y abre el formulario
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest('[data-open-contact]');
      if (!t) return;
      e.preventDefault();
      openForm();
      document.getElementById('contacto')?.scrollIntoView({
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'start',
      });
      history.pushState(null, '', '#contacto');
    });

    // envío: con formKey (web3forms) manda directo al mail de Eve;
    // sin clave, compone un mail en el cliente (fallback).
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = (data.get('name') || '').toString().trim();
      const from = (data.get('email') || '').toString().trim();
      const msg = (data.get('message') || '').toString().trim();
      const note = form.querySelector<HTMLElement>('[data-ff-note]');
      const send = form.querySelector<HTMLButtonElement>('.ff-send');
      const say = (t: string) => { if (note) note.textContent = t; };

      if (!name || !from || !msg) {
        say('Completá todos los campos · Please fill in all fields');
        return;
      }

      const key = form.dataset.formKey || '';
      if (key) {
        try {
          send?.setAttribute('disabled', '');
          say('Enviando… · Sending…');
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              access_key: key,
              subject: `Proyecto — ${name}`,
              name,
              email: from,
              message: msg,
            }),
          });
          const out = await res.json();
          if (out.success) {
            form.reset();
            say('¡Mensaje enviado! Te respondo pronto · Message sent!');
          } else {
            say('No se pudo enviar; probá de nuevo · Could not send, try again');
          }
        } catch {
          say('No se pudo enviar; probá de nuevo · Could not send, try again');
        } finally {
          send?.removeAttribute('disabled');
        }
        return;
      }

      const email = form.dataset.email || '';
      const subject = encodeURIComponent(`Proyecto — ${name}`);
      const body = encodeURIComponent(`${msg}\n\n— ${name} (${from})`);
      location.href = `mailto:${email}?subject=${subject}&body=${body}`;
      say('Abriendo tu cliente de correo… · Opening your email client…');
    });
  }
</script>
