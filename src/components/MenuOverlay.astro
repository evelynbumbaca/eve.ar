---
import { nav, site } from '../data/site';
import T from './T.astro';
import { link } from '../lib/link';
---

<div class="overlay" id="overlay">
  <nav aria-label="Principal">
    {nav.map((n) => (
      <a href={link(n.href)}>
        <span data-es={n.es} data-en={n.en}>{n.es}</span>
        {n.tagEs && <sup class="nav-tag mono" data-es={n.tagEs} data-en={n.tagEn}>{n.tagEs}</sup>}
      </a>
    ))}
  </nav>

  <div class="meta">
    <span><T es="Buenos Aires — Argentina" en="Buenos Aires — Argentina" /></span>
    <span>{site.email}</span>
    <span><T es="Diseño multimedia & UX/UI" en="Multimedia & UX/UI design" /></span>
  </div>
</div>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background: var(--ink);
    color: #f7f6f3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(96px, 12vh, 160px) var(--pad) clamp(28px, 5vh, 48px);
    transform: translateY(-100%);
    transition: transform 0.7s var(--ease);
    pointer-events: none;
  }
  :global(body.menu-open) .overlay {
    transform: translateY(0);
    pointer-events: auto;
  }

  .overlay nav {
    display: flex;
    flex-direction: column;
    gap: clamp(2px, 0.5vw, 6px);
  }
  .overlay nav a {
    font-family: var(--sans);
    font-weight: 500;
    text-transform: uppercase;
    font-size: clamp(34px, 7vw, 82px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    width: max-content;
    color: #f7f6f3;
    transform: translateY(40px);
    transition: transform 0.6s var(--ease);
  }
  :global(body.menu-open) .overlay nav a { transform: translateY(0); }

  /* texto fantasma: transparente, y la luz del cursor lo descubre al pasar
     (como los títulos gigantes de la portada). Sin mouse queda a la vista. */
  @media (hover: hover) and (pointer: fine) {
    .overlay nav a {
      --mx: -9999px; --my: -9999px; --ghost: rgba(247, 246, 243, 0.24);
      color: var(--ghost);
      background-image: radial-gradient(circle 210px at var(--mx) var(--my), #fff4ec 0%, #f6a07c 42%, var(--ghost) 100%);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent;
      transition: transform 0.6s var(--ease), --ghost 0.3s;
    }
    .overlay nav a:hover { --ghost: rgba(247, 246, 243, 0.4); }
    .overlay nav a:focus-visible { -webkit-text-fill-color: #f7f6f3; background-image: none; outline: none; }
    .overlay nav .nav-tag { -webkit-text-fill-color: var(--orange); }
  }
  @media (hover: none), (pointer: coarse) { .overlay nav a { opacity: 0.9; } }
  .overlay nav .nav-tag {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--orange);
    margin-left: 12px;
    vertical-align: super;
  }

  :global(body.menu-open) .overlay nav a:nth-child(1) { transition-delay: 0.12s; }
  :global(body.menu-open) .overlay nav a:nth-child(2) { transition-delay: 0.17s; }
  :global(body.menu-open) .overlay nav a:nth-child(3) { transition-delay: 0.22s; }
  :global(body.menu-open) .overlay nav a:nth-child(4) { transition-delay: 0.27s; }
  :global(body.menu-open) .overlay nav a:nth-child(5) { transition-delay: 0.32s; }
  :global(body.menu-open) .overlay nav a:nth-child(6) { transition-delay: 0.37s; }

  .overlay .meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-family: var(--sans);
    font-size: 13px;
    letter-spacing: 0.04em;
    opacity: 0;
    transition: opacity 0.4s 0.35s var(--ease);
    border-top: 1px solid rgba(247, 246, 243, 0.18);
    padding-top: 20px;
  }
  :global(body.menu-open) .overlay .meta { opacity: 0.7; }
</style>

<script>
  const links = Array.from(document.querySelectorAll<HTMLElement>('.overlay nav a'));
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (links.length && fine) {
    let tx = -9999, ty = -9999, x = -9999, y = -9999, raf = 0, running = false;
    const paint = () => {
      for (const a of links) {
        const r = a.getBoundingClientRect();
        a.style.setProperty('--mx', (x - r.left).toFixed(1) + 'px');
        a.style.setProperty('--my', (y - r.top).toFixed(1) + 'px');
      }
    };
    const frame = () => {
      if (x < -9000) { x = tx; y = ty; }
      x += (tx - x) * 0.16; y += (ty - y) * 0.16;
      paint();
      if (Math.hypot(tx - x, ty - y) > 0.4) raf = requestAnimationFrame(frame); else running = false;
    };
    addEventListener('pointermove', (e) => {
      if (!document.body.classList.contains('menu-open')) return;
      tx = e.clientX; ty = e.clientY;
      if (!running) { running = true; raf = requestAnimationFrame(frame); }
    }, { passive: true });
    // al cerrar el menú, la luz se va
    new MutationObserver(() => {
      if (!document.body.classList.contains('menu-open')) { cancelAnimationFrame(raf); running = false; x = y = tx = ty = -9999; paint(); }
    }).observe(document.body, { attributes: true, attributeFilter: ['class'] });
  }
</script>
