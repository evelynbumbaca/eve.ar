---
import { nav, site } from '../data/site';
import T from './T.astro';
---

<div class="overlay" id="overlay">
  <nav aria-label="Principal">
    {nav.map((n) => (
      <a href={n.href} data-es={n.es} data-en={n.en}>{n.es}</a>
    ))}
  </nav>

  <div class="meta">
    <span><T es="Buenos Aires — Argentina" en="Buenos Aires — Argentina" /></span>
    <span>{site.email}</span>
    <span><T es="Diseño multimedia & UX/UI" en="Multimedia & UX/UI design" /></span>
  </div>
</div>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background: var(--ink);
    color: #f7f6f3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(96px, 12vh, 160px) var(--pad) clamp(28px, 5vh, 48px);
    transform: translateY(-100%);
    transition: transform 0.7s var(--ease);
    pointer-events: none;
  }
  :global(body.menu-open) .overlay {
    transform: translateY(0);
    pointer-events: auto;
  }

  .overlay nav {
    display: flex;
    flex-direction: column;
    gap: clamp(2px, 0.5vw, 6px);
  }
  .overlay nav a {
    font-family: var(--sans);
    font-weight: 500;
    text-transform: uppercase;
    font-size: clamp(34px, 7vw, 82px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    width: max-content;
    color: #f7f6f3;
    opacity: 0.55;
    transform: translateY(40px);
    transition: opacity 0.35s var(--ease), transform 0.6s var(--ease);
  }
  :global(body.menu-open) .overlay nav a { transform: translateY(0); }
  .overlay nav a:hover { opacity: 1; }

  :global(body.menu-open) .overlay nav a:nth-child(1) { transition-delay: 0.12s; }
  :global(body.menu-open) .overlay nav a:nth-child(2) { transition-delay: 0.17s; }
  :global(body.menu-open) .overlay nav a:nth-child(3) { transition-delay: 0.22s; }
  :global(body.menu-open) .overlay nav a:nth-child(4) { transition-delay: 0.27s; }
  :global(body.menu-open) .overlay nav a:nth-child(5) { transition-delay: 0.32s; }

  .overlay .meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-family: var(--sans);
    font-size: 13px;
    letter-spacing: 0.04em;
    opacity: 0;
    transition: opacity 0.4s 0.35s var(--ease);
    border-top: 1px solid rgba(247, 246, 243, 0.18);
    padding-top: 20px;
  }
  :global(body.menu-open) .overlay .meta { opacity: 0.7; }
</style>
