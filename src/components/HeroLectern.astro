---
/* ============================================================
   HeroLectern — "Portada viva".
   Evolucion del hero-indice: suma una PORTADA GRANDE siempre
   visible (impacto al cargar) junto al indice editorial.
   · Al hover/focus sobre un proyecto, la portada grande cambia
     con un crossfade (opacity) y se actualiza el caption.
   · Parallax MINIMO del escenario (±6px, lerp) -> vida sin mareo.
   · Sin auto-movimiento. Sin zoom. Solo transform/opacity.
   · Tactil/reduced-motion: layout estatico, filas tocables.
   ============================================================ */
import { projects } from '../data/site';
import { link } from '../lib/link';

const featured = projects.slice(0, 8);
---

<section class="lec" data-lec aria-label="Inicio">
  <div class="lec-grid wrap">
    <div class="lec-left">
      <p class="lec-id">
        <span data-es="Diseñadora Multimedia & UX/UI" data-en="Multimedia & UX/UI Designer">Diseñadora Multimedia &amp; UX/UI</span>
        <span class="sep" aria-hidden="true">—</span>
        <span>Buenos Aires, AR</span>
      </p>

      <p class="lec-kicker mono cap" data-es="Trabajos seleccionados" data-en="Selected work">Trabajos seleccionados</p>

      <ol class="lec-list" data-list>
        {featured.map((p, i) => (
          <li class="lrow" style={`--i:${i}`}>
            <a class="lrow-link" href={link(`/trabajos/${p.id}`)} data-idx={i} data-title={p.title}>
              <span class="lrow-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="lrow-title">{p.title}</span>
              <span class="lrow-disc" data-es={p.disc.es} data-en={p.disc.en}>{p.disc.es}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <div class="lec-stage" data-stage>
      <div class="lec-covers">
        {featured.map((p, i) => (
          <figure class:list={['lcov', { on: i === 0 }]} data-cov={i}>
            <span class="lcov-img ph" data-label={p.title}></span>
            <figcaption class="lcov-cap">
              <span class="cap-title">{p.title}</span>
              <span class="cap-meta">
                <span data-es={p.disc.es} data-en={p.disc.en}>{p.disc.es}</span>
                <span class="cap-dot" aria-hidden="true">·</span>
                <span>{p.year}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>

  <p class="lec-hint" aria-hidden="true">
    <span data-es="Pasá el cursor por la lista · clic para entrar" data-en="Hover the list · click to open">Pasá el cursor por la lista · clic para entrar</span>
  </p>
</section>

<style>
  .lec {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: clamp(96px, 13vh, 150px);
    padding-bottom: clamp(40px, 7vh, 72px);
    background: var(--paper);
    overflow: hidden;
  }
  .lec-grid {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
    width: 100%;
  }

  /* ---------- izquierda: identidad + indice ---------- */
  .lec-id {
    display: flex; flex-wrap: wrap; gap: 0 12px;
    font-family: var(--mono);
    font-size: clamp(11px, 1vw, 13px);
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-60);
    margin-bottom: clamp(18px, 3vh, 30px);
  }
  .lec-id .sep { color: var(--ink-35); }
  .lec-kicker {
    color: var(--ink-45);
    margin-bottom: clamp(12px, 2vh, 20px);
    padding-bottom: clamp(12px, 2vh, 18px);
    border-bottom: 1px solid var(--line);
  }

  .lec-list { list-style: none; }
  .lrow { border-bottom: 1px solid var(--line); }
  .lrow-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: clamp(12px, 1.6vw, 24px);
    padding-block: clamp(8px, 1.5vh, 16px);
    color: var(--ink);
    transition: opacity var(--dur-ui) var(--ease-quint);
  }
  .lrow-num {
    font-family: var(--mono);
    font-size: clamp(10px, 0.85vw, 12px);
    color: var(--ink-35);
    transition: color var(--dur-micro) var(--ease-quint);
  }
  .lrow-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    transition: transform var(--dur-ui) var(--ease-out);
  }
  .lrow-disc {
    font-family: var(--mono);
    font-size: clamp(9px, 0.8vw, 11px);
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--ink-45);
    text-align: right;
    transition: opacity var(--dur-ui) var(--ease-quint);
  }
  /* estado activo */
  .lec.has-active .lrow-title { opacity: 0.34; }
  .lec.has-active .lrow-disc { opacity: 0.4; }
  .lrow-link.is-active .lrow-title { opacity: 1; transform: translateX(clamp(4px, 0.8vw, 12px)); }
  .lrow-link.is-active .lrow-disc { opacity: 0.85; }
  .lrow-link.is-active .lrow-num { color: var(--ink); }
  .lrow-link:focus-visible { outline: none; }
  .lrow-link:focus-visible .lrow-title { opacity: 1; text-decoration: underline; text-underline-offset: 5px; }

  /* ---------- derecha: portada grande viva ---------- */
  .lec-stage {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 460px;
    will-change: transform;
  }
  .lec-covers {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
  }
  .lcov {
    position: absolute; inset: 0;
    opacity: 0;
    transform: scale(1.012);
    transition: opacity var(--dur-content) var(--ease-out),
                transform 0.8s var(--ease-out);
    pointer-events: none;
  }
  .lcov.on { opacity: 1; transform: scale(1); }
  .lcov-img {
    width: 100%; height: 100%;
    border-radius: 3px;
    box-shadow: 0 30px 70px rgba(14, 14, 14, 0.16);
  }
  .lcov-cap {
    position: absolute; left: 2px; right: 2px; bottom: -2px;
    transform: translateY(100%);
    padding-top: 14px;
    display: flex; flex-wrap: wrap; align-items: baseline;
    justify-content: space-between; gap: 6px 14px;
  }
  .cap-title {
    font-family: var(--serif);
    font-size: clamp(1.05rem, 1.5vw, 1.4rem);
    letter-spacing: -0.01em;
  }
  .cap-meta {
    font-family: var(--mono);
    font-size: clamp(10px, 0.85vw, 12px);
    letter-spacing: 0.05em; text-transform: uppercase;
    color: var(--ink-45);
    display: inline-flex; gap: 8px;
  }
  .cap-dot { color: var(--ink-35); }

  .lec-hint {
    align-self: center;
    margin-top: clamp(28px, 4vh, 44px);
    font-family: var(--mono);
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-35);
  }

  /* ---------- entrada (gateada: base = sin movimiento) ---------- */
  .lec.anim .lrow-link { opacity: 0; transform: translateY(16px); }
  .lec.anim .lec-id,
  .lec.anim .lec-kicker,
  .lec.anim .lec-hint { opacity: 0; }
  .lec.anim .lcov.on { opacity: 0; }
  .lec.anim .lcov.on .lcov-img { clip-path: inset(0 0 100% 0); }

  .lec.anim.ready .lrow-link {
    opacity: 1; transform: translateY(0);
    transition: opacity var(--dur-content) var(--ease-out),
                transform var(--dur-content) var(--ease-out);
    transition-delay: calc(0.24s + var(--i) * 0.05s);
  }
  .lec.anim.ready .lec-id { opacity: 1; transition: opacity var(--dur-content) var(--ease-out); }
  .lec.anim.ready .lec-kicker { opacity: 1; transition: opacity var(--dur-content) var(--ease-out) 0.08s; }
  .lec.anim.ready .lec-hint { opacity: 1; transition: opacity var(--dur-content) var(--ease-out) 0.7s; }
  .lec.anim.ready .lcov.on { opacity: 1; transition: opacity var(--dur-hero) var(--ease-out); }
  .lec.anim.ready .lcov.on .lcov-img {
    clip-path: inset(0 0 0 0);
    transition: clip-path var(--dur-hero) var(--ease-out);
  }

  /* ---------- responsive ---------- */
  @media (max-width: 900px) {
    .lec { justify-content: flex-start; }
    .lec-grid { grid-template-columns: 1fr; gap: clamp(28px, 6vw, 48px); }
    .lec-stage { order: -1; max-width: 340px; justify-self: start; }
    .lcov-cap { position: static; transform: none; padding-top: 12px; }
    .lec-hint { align-self: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lcov { transition: opacity 0.001s; }
  }
</style>

<script>
  const lec = document.querySelector('[data-lec]') as HTMLElement | null;
  if (lec) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (!reduce) {
      lec.classList.add('anim');
      requestAnimationFrame(() => requestAnimationFrame(() => lec.classList.add('ready')));
    }

    const covers = Array.from(lec.querySelectorAll<HTMLElement>('.lcov'));
    const links = Array.from(lec.querySelectorAll<HTMLElement>('.lrow-link'));
    const stage = lec.querySelector<HTMLElement>('[data-stage]');
    let active = 0;

    const setActive = (idx: number) => {
      if (idx === active || idx < 0 || idx >= covers.length) return;
      covers[active]?.classList.remove('on');
      links[active]?.classList.remove('is-active');
      active = idx;
      covers[idx]?.classList.add('on');
      links[idx]?.classList.add('is-active');
    };

    links.forEach((lnk, i) => {
      lnk.addEventListener('pointerenter', () => { lec.classList.add('has-active'); setActive(i); });
      lnk.addEventListener('focus', () => { lec.classList.add('has-active'); setActive(i); });
    });
    const list = lec.querySelector('[data-list]');
    list?.addEventListener('pointerleave', () => { lec.classList.remove('has-active'); });

    /* parallax minimo del escenario (solo puntero fino, sin reduced-motion) */
    if (fine && !reduce && stage) {
      let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0, running = false;
      const loop = () => {
        tx += (cx - tx) * 0.08; ty += (cy - ty) * 0.08;
        stage.style.transform = `translate3d(${tx.toFixed(2)}px, ${ty.toFixed(2)}px, 0)`;
        if (Math.abs(cx - tx) > 0.05 || Math.abs(cy - ty) > 0.05) raf = requestAnimationFrame(loop);
        else running = false;
      };
      lec.addEventListener('pointermove', (e) => {
        const r = lec.getBoundingClientRect();
        cx = ((e.clientX - r.left) / r.width - 0.5) * 12;   // ±6px
        cy = ((e.clientY - r.top) / r.height - 0.5) * 12;
        if (!running) { running = true; raf = requestAnimationFrame(loop); }
      }, { passive: true });
      document.addEventListener('visibilitychange', () => { if (document.hidden) { cancelAnimationFrame(raf); running = false; } });
    }
  }
</script>
