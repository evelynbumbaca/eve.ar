---
/* ============================================================
   Cursor — cursor circular personalizado (dot + ring).
   · Aro vacío (contorno) que sigue al puntero con lerp.
   · Al ACERCARSE al nombre (var --prox 0→1) se RELLENA de
     naranja y CRECE: la firma de color del sitio.
   · Solo en puntero fino sin reduced-motion (gate en el script
     maestro). aria-hidden, pointer-events:none, z bajo el chrome.
   El movimiento/estado lo maneja el rAF maestro de la página.
   ============================================================ */
---

<div class="cursor" data-cursor-root aria-hidden="true">
  <div class="cursor-ring" data-cursor-ring></div>
  <div class="cursor-dot" data-cursor-dot></div>
</div>

<style>
  .cursor { --prox: 0; }
  .cursor-ring,
  .cursor-dot {
    position: fixed;
    left: 0; top: 0;
    border-radius: 50%;
    pointer-events: none;
    z-index: 50;
    opacity: 0;
  }
  /* visible sólo cuando el script activa el cursor custom */
  :global(html.fx-on) .cursor-ring,
  :global(html.fx-on) .cursor-dot { opacity: 1; }

  .cursor-ring {
    width: 34px; height: 34px;
    margin: -17px 0 0 -17px;
    border: 1.5px solid var(--ink);
    /* se rellena de naranja a medida que --prox sube */
    background: color-mix(in oklab, var(--orange) calc(var(--prox) * 90%), transparent);
    border-color: color-mix(in oklab, var(--orange) calc(var(--prox) * 100%), var(--ink));
    transition: opacity var(--dur-ui) var(--ease-out);
  }
  .cursor-dot {
    width: 6px; height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--ink);
    transition: opacity var(--dur-ui) var(--ease-out);
  }

  /* sobre fondo oscuro (menú abierto) el aro pasa a papel para seguir visible */
  :global(body.menu-open) .cursor-ring { border-color: var(--paper); background: transparent; }
  :global(body.menu-open) .cursor-dot { background: var(--paper); }

  @media (hover: none), (pointer: coarse) { .cursor { display: none; } }
  @media (prefers-reduced-motion: reduce) { .cursor { display: none; } }
</style>
