---
/* ============================================================
   GlowLayer — la luz naranja que sigue al cursor, detrás de
   TODO el sitio. Dos estados, con morph fluido entre ambos:
   · LIBRE: bola blanda que acompaña al puntero.
   · DOCK: al pasar sobre un elemento interactivo con borde
     ([data-glow-dock]) la luz se AMOLDA a su forma (tamaño +
     esquinas del elemento) como halo perimetral, invitando a
     la interacción. Al salir, vuelve a ser bola.
   Todo se interpola (x, y, ancho, alto, radio, blur, opacidad)
   con un mismo lerp -> movimiento orgánico. El loop se apaga al
   converger; en táctil/reduced-motion la capa no existe.
   ============================================================ */
---

<div class="glow-layer" data-glow-layer aria-hidden="true">
  <div class="glow-ball" data-glow-ball>
    <div class="glow-fill" data-glow-fill></div>
  </div>
</div>

<style>
  .glow-layer {
    position: fixed;
    inset: 0;
    z-index: 0; /* bajo <main> (z:1), sobre el fondo del body */
    pointer-events: none;
    overflow: hidden;
  }
  .glow-ball {
    position: absolute;
    left: 0; top: 0;
    /* tamaño/forma/blur/opacidad/borde los maneja el script (morph) */
    border: 0 solid color-mix(in oklab, var(--orange) 92%, transparent);
    opacity: 0;
    will-change: transform, filter;
    pointer-events: none;
  }
  /* relleno blando (estado libre); al dockear se apaga y queda el ANILLO */
  .glow-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--orange) 82%, transparent), transparent);
  }

  @media (hover: none), (pointer: coarse) { .glow-layer { display: none; } }
  @media (prefers-reduced-motion: reduce) { .glow-layer { display: none; } }
</style>

<script>
  const layer = document.querySelector('[data-glow-layer]') as HTMLElement | null;
  const ball = document.querySelector('[data-glow-ball]') as HTMLElement | null;
  const fine = matchMedia('(hover:hover) and (pointer:fine)').matches;
  const reduce = matchMedia('(prefers-reduced-motion:reduce)').matches;

  const fill = document.querySelector('[data-glow-fill]') as HTMLElement | null;

  if (layer && ball && fill && fine && !reduce) {
    const freeD = () => Math.max(innerWidth, innerHeight) * 0.4;

    let mx = innerWidth / 2, my = innerHeight * 0.4;
    let vis = false;
    let dock: HTMLElement | null = null;
    let dockR = 0;

    const d0 = freeD();
    const st = { x: mx, y: my, w: d0, h: d0, r: d0 / 2, b: 40, o: 0, bw: 0, f: 1 };
    const ap = { w: -1, h: -1, r: -1, b: -1, o: -1, bw: -1, f: -1 }; // últimos aplicados
    let raf = 0, running = false;
    let form = 0, lastForm = 0; // fase de "respiración": expansión desde atrás del elemento

    const frame = () => {
      // objetivos según estado (libre = bola blanda / dock = ANILLO al borde)
      const fw = freeD();
      let tx = mx, ty = my, tw = fw, th = tw, tr = tw / 2, tb = 40, to = vis ? 0.82 : 0, tbw = 0, tf = 1;
      let k = 0.14;
      let docked = false;
      if (dock && dock.isConnected) {
        const rc = dock.getBoundingClientRect();
        if (rc.width > 0 && rc.bottom > 0 && rc.top < innerHeight) {
          docked = true;
          // la luz viaja al centro del elemento (un poco más rápida)
          tx = rc.left + rc.width / 2;
          ty = rc.top + rc.height / 2;
          k = 0.18;
          // FASE 1 (aproximación): la bola viaja LLENA y se CONTRAE como
          // círculo hacia atrás del elemento, según su cercanía real
          const dist = Math.hypot(st.x - tx, st.y - ty);
          const D = Math.max(rc.width, rc.height) / 2 + 80;
          let e = 1 - Math.min(1, dist / D);
          e = e * e * (3 - 2 * e); // smoothstep
          const pad = 12;
          const rw = rc.width + pad * 2, rh = rc.height + pad * 2;
          const rr = Math.min((dockR || 3) + pad, Math.min(rw, rh) / 2);
          const cd = Math.min(rw, rh) * 0.92; // diámetro contraído (detrás)
          const aw = fw + (cd - fw) * e;      // círculo que se contrae
          const ar = aw / 2;
          // FASE 2 (respiración): ya llegada, se EXPANDE desde atrás
          // hasta el borde del elemento (form crece recién al arribar)
          const arrived = dist < Math.max(28, Math.min(rc.width, rc.height) * 0.2);
          form += ((arrived ? 1 : 0) - form) * (arrived ? 0.12 : 0.2);
          tw = aw + (rw - aw) * form;
          th = aw + (rh - aw) * form;
          tr = ar + (rr - ar) * form;
          tbw = 10 * form;
          tf = 1 + (0.55 - 1) * form;         // el interior queda con luz (no hueco)
          tb = 40 + (18 - 40) * e + (13 - 18) * form;
          to = vis ? 0.82 + 0.18 * form : 0;
        }
      }
      if (!docked) form += (0 - form) * 0.2;
      st.x += (tx - st.x) * k; st.y += (ty - st.y) * k;
      st.w += (tw - st.w) * k; st.h += (th - st.h) * k;
      st.r += (tr - st.r) * k; st.b += (tb - st.b) * k;
      st.o += (to - st.o) * k; st.bw += (tbw - st.bw) * k; st.f += (tf - st.f) * k;

      ball.style.transform = `translate3d(${(st.x - st.w / 2).toFixed(1)}px, ${(st.y - st.h / 2).toFixed(1)}px, 0)`;
      if (Math.abs(st.w - ap.w) > 0.5) { ball.style.width = st.w.toFixed(1) + 'px'; ap.w = st.w; }
      if (Math.abs(st.h - ap.h) > 0.5) { ball.style.height = st.h.toFixed(1) + 'px'; ap.h = st.h; }
      if (Math.abs(st.r - ap.r) > 0.5) { ball.style.borderRadius = st.r.toFixed(1) + 'px'; ap.r = st.r; }
      if (Math.abs(st.b - ap.b) > 0.3) { ball.style.filter = `blur(${st.b.toFixed(1)}px)`; ap.b = st.b; }
      if (Math.abs(st.o - ap.o) > 0.008) { ball.style.opacity = st.o.toFixed(3); ap.o = st.o; }
      if (Math.abs(st.bw - ap.bw) > 0.3) { ball.style.borderWidth = st.bw.toFixed(1) + 'px'; ap.bw = st.bw; }
      if (Math.abs(st.f - ap.f) > 0.01) { fill.style.opacity = st.f.toFixed(3); ap.f = st.f; }

      const still =
        Math.abs(tx - st.x) < 0.3 && Math.abs(ty - st.y) < 0.3 &&
        Math.abs(tw - st.w) < 0.5 && Math.abs(th - st.h) < 0.5 &&
        Math.abs(tr - st.r) < 0.5 && Math.abs(to - st.o) < 0.008 &&
        Math.abs(tbw - st.bw) < 0.3 && Math.abs(tf - st.f) < 0.01;
      if (!still) raf = requestAnimationFrame(frame);
      else running = false;
    };
    const kick = () => { if (!running) { running = true; raf = requestAnimationFrame(frame); } };

    addEventListener('pointermove', (e) => {
      mx = e.clientX; my = e.clientY;
      if (!vis) vis = true;
      kick();
    }, { passive: true });

    // dock: el cursor entra/sale de elementos interactivos con borde
    document.addEventListener('pointerover', (e) => {
      const d = (e.target as Element).closest?.('[data-glow-dock]') as HTMLElement | null;
      if (d !== dock) {
        dock = d;
        dockR = d ? parseFloat(getComputedStyle(d).borderTopLeftRadius) || 0 : 0;
        kick();
      }
    }, { passive: true });

    document.addEventListener('pointerout', (e: PointerEvent) => {
      if (!e.relatedTarget) { vis = false; dock = null; kick(); } // salió de la ventana
    });
    addEventListener('scroll', () => { if (dock) kick(); }, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { cancelAnimationFrame(raf); running = false; } else kick();
    });
  }
</script>
