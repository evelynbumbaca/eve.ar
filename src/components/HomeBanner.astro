---
/* ============================================================
   HomeBanner — inicio estilo estudio (ref. "Other°").
   · "Eve°" grande arriba-izq + descripción y redes al lado.
   · Al hacer scroll, "Eve°" sube y se integra al menú (morph
     hacia el wordmark del Topbar). La lógica vive en index.astro.
   · Grilla 3×2 (6 seleccionados) con FILTROS por disciplina
     reales (contador vivo) + link al archivo completo.
   · Hover en una tarjeta: alterna a una SEGUNDA TOMA del
     proyecto (con contenido real será otra imagen o un video).
   · La entrada de la grilla se dispara al entrar en viewport.
   · El glow naranja global vive en GlowLayer (Base).
   · Fallback (sin home-fx): nombre en flujo, estático.
   Las .ph son placeholders.
   ============================================================ */
import { projects, filters, social } from '../data/site';
import { link } from '../lib/link';
import LogoEve from './LogoEve.astro';

const works = projects.slice(0, 6);
---

<section class="banner" data-banner>
  <div class="bn-inner wrap">
    <header class="bn-head">
      <div class="bn-name-wrap">
        <p class="bn-name-slot" aria-hidden="true"><LogoEve /></p>
        <span class="bn-name-fly" data-name-fly aria-hidden="true"><LogoEve /></span>
      </div>

      <div class="bn-desc">
        <p class="bn-desc-text rise"
          data-es="Eve es diseñadora multimedia y UX/UI, especializada en motion. Construye identidades y experiencias con intención, claridad y carácter — entre la marca, lo editorial, el producto digital y el movimiento."
          data-en="Eve is a multimedia & UX/UI designer specialized in motion. She builds identities and experiences with intent, clarity and character — across brand, editorial, digital product and motion."
        >Eve es diseñadora multimedia y UX/UI, especializada en motion. Construye identidades y experiencias con intención, claridad y carácter — entre la marca, lo editorial, el producto digital y el movimiento.</p>
        <nav class="bn-social rise rise-delay-1" aria-label="Redes">
          {social.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <div class="bn-works-head" id="trabajos">
      <div class="bn-filters" role="group" aria-label="Filtrar por disciplina · Filter by discipline">
        {filters.map((f, i) => (
          <button
            class:list={['bn-filter', { 'is-on': i === 0 }]}
            type="button"
            data-filter={f.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
          ><span data-es={f.label.es} data-en={f.label.en}>{f.label.es}</span></button>
        ))}
      </div>
    </div>

    <div class="bn-grid" data-grid>
      {works.map((p, i) => (
        <a class="bn-cell" href={link(`/trabajos/${p.id}`)} data-cat={p.cat} data-glow-dock style={`--i:${i}`}>
          <span class="bn-cell-img ph" data-label={`${p.title} — cover`}></span>
          <span class="bn-cell-alt ph" data-label={`${p.title} — detalle`} aria-hidden="true"></span>
          <span class="bn-cell-cap">
            <span class="bn-cell-title">{p.title}</span>
            <span class="bn-cell-disc" data-es={p.disc.es} data-en={p.disc.en}>{p.disc.es}</span>
          </span>
        </a>
      ))}
    </div>

    <div class="bn-below">
      <h2 class="bn-sw rise">
        <span data-es="Trabajos seleccionados" data-en="Selected works">Trabajos seleccionados</span>
        <sup class="bn-count">(<span data-grid-count>{works.length}</span>)</sup>
      </h2>
      <a class="bn-all rise rise-delay-1" href={link('/trabajos')}>
        <span data-es="Ver todos los trabajos" data-en="See all works">Ver todos los trabajos</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .banner {
    position: relative;
    /* sin fondo propio: el glow global (GlowLayer) se ve a través */
    padding-top: clamp(84px, 12vh, 128px);
    padding-bottom: clamp(40px, 7vh, 90px);
  }
  .bn-inner { position: relative; }

  /* ---------- cabecera: nombre + descripción ---------- */
  .bn-head {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(24px, 4vw, 72px);
    align-items: start;
    padding-bottom: clamp(36px, 7vh, 86px);
  }
  .bn-name-wrap { position: relative; }
  /* el logotipo real de Eve, tamaño protagonista */
  .bn-name-slot :global(svg),
  .bn-name-fly :global(svg) {
    display: block;
    height: clamp(58px, 10.5vw, 152px);
    width: auto;
    color: var(--ink);
    /* las letras estiradas pueden salir de la caja del svg sin cortarse */
    overflow: visible;
  }
  .bn-name-slot { display: block; margin: 0; }

  .bn-name-fly { position: absolute; left: 0; top: 0; pointer-events: none; }
  /* letras (grupos del svg) que se estiran cerca del cursor (solo en fx).
     Sin will-change: congelaría la rasterización del vector y se pixela. */
  .bn-name-fly :global(.ltr) {
    transform-box: fill-box;
    transform-origin: 50% 62%;
  }
  /* el morph (nombre grande -> menú) corre en desktop Y en táctil */
  :global(html.morph-on) .bn-name-slot { visibility: hidden; }
  :global(html:not(.morph-on)) .bn-name-fly { display: none; }
  :global(html.morph-on) .bn-name-fly {
    position: fixed;
    left: 0; top: 0;
    transform-origin: left top;
    /* sin will-change: el svg debe re-rasterizarse al escalar (nitidez) */
    z-index: 45; /* sobre el contenido, debajo del chrome (60) y overlay (55) */
    transition: opacity 0.12s var(--ease-quint);
  }

  .bn-desc { padding-top: clamp(6px, 2vh, 18px); }
  .bn-desc-text {
    font-family: var(--sans);
    font-size: clamp(0.95rem, 1.15vw, 1.1rem);
    line-height: 1.5;
    color: var(--ink-80);
    max-width: 42ch;
  }
  .bn-social {
    display: flex; flex-wrap: wrap; gap: 18px;
    margin-top: clamp(18px, 3vh, 30px);
  }
  .bn-social a {
    font-family: var(--sans);
    font-size: var(--fs-small);
    color: var(--ink-60);
    transition: color var(--dur-micro) var(--ease-quint);
  }
  .bn-social a:hover { color: var(--ink); }

  /* ---------- filtros (arriba de la grilla, a la derecha) ---------- */
  .bn-works-head {
    display: flex; flex-wrap: wrap;
    justify-content: flex-end;
    border-top: 1px solid var(--line);
    padding-top: clamp(16px, 2.5vh, 26px);
    padding-bottom: clamp(16px, 2.5vh, 26px);
  }

  .bn-filters { display: flex; flex-wrap: wrap; gap: clamp(14px, 2.2vw, 32px); }
  .bn-filter {
    font-family: var(--sans);
    font-size: clamp(0.95rem, 1.3vw, 1.2rem);
    color: var(--ink-35);
    transition: color var(--dur-micro) var(--ease-quint);
  }
  .bn-filter:hover { color: var(--ink-60); }
  .bn-filter.is-on { color: var(--ink); }

  /* ---------- grilla 3×2 ---------- */
  .bn-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .bn-cell {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .bn-cell.is-hidden { display: none; }
  .bn-cell-img { width: 100%; height: 100%; transition: transform 0.5s var(--ease-out); }
  .bn-cell:hover .bn-cell-img { transform: scale(1.03); }

  /* segunda toma del proyecto (con contenido real: otra imagen o video) */
  .bn-cell-alt {
    position: absolute; inset: 0;
    opacity: 0;
    /* placeholder distinguible: rayado a 45° apenas más oscuro */
    background:
      repeating-linear-gradient(45deg, var(--ink-12) 0 10px, transparent 10px 20px),
      #dcd8ce;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .bn-cell:hover .bn-cell-alt { animation: frameSwap 1.5s steps(1) infinite 0.15s; }
    @keyframes frameSwap { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }
  }
  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    .bn-cell:hover .bn-cell-alt { opacity: 1; }
  }
  .bn-cell-cap {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; flex-direction: column; gap: 2px;
    padding: 12px 13px;
    background: linear-gradient(to top, rgba(14,14,14,0.5), transparent);
    opacity: 0; transform: translateY(6px);
    transition: opacity var(--dur-ui) var(--ease-out), transform var(--dur-ui) var(--ease-out);
  }
  .bn-cell:hover .bn-cell-cap,
  .bn-cell:focus-visible .bn-cell-cap { opacity: 1; transform: translateY(0); }
  .bn-cell-title { font-family: var(--serif); font-size: 1.05rem; color: #fff; line-height: 1.1; }
  .bn-cell-disc {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase;
    color: rgba(255,255,255,0.8);
  }

  /* entrada en cascada, disparada al ENTRAR EN VIEWPORT (scroll) */
  @media (prefers-reduced-motion: no-preference) {
    .bn-grid:not(.in) .bn-cell { opacity: 0; }
    .bn-grid.in .bn-cell {
      animation: cellIn 0.55s var(--ease-out) both;
      animation-delay: calc(0.05s + var(--i, 0) * 60ms);
    }
    @keyframes cellIn {
      from { opacity: 0; transform: translateY(14px); }
    }
  }

  /* ---------- debajo de la grilla: título izq + ver todos der ---------- */
  .bn-below {
    display: flex; flex-wrap: wrap; align-items: baseline;
    justify-content: space-between; gap: 12px 24px;
    padding-top: clamp(16px, 2.5vh, 26px);
  }
  /* título y "Ver todos" alineados: mismo tamaño y color */
  .bn-sw {
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    letter-spacing: -0.005em;
    color: var(--ink);
  }
  .bn-count { font-size: 0.55em; font-weight: 500; color: var(--ink-45); vertical-align: super; margin-left: 2px; }
  .bn-all {
    display: inline-flex; align-items: baseline; gap: 10px;
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    letter-spacing: -0.005em;
    color: var(--ink);
    border-bottom: 1px solid var(--ink-35);
    padding-bottom: 3px;
    transition: border-color var(--dur-micro) var(--ease-quint), opacity var(--dur-micro) var(--ease-quint);
  }
  .bn-all:hover { opacity: 0.7; border-color: var(--ink); }
  .bn-all span[aria-hidden] { transition: transform var(--dur-ui) var(--ease-out); display: inline-block; }
  .bn-all:hover span[aria-hidden] { transform: translateX(5px); }

  /* ---------- responsive / táctil ---------- */
  @media (max-width: 860px) {
    .bn-head { grid-template-columns: 1fr; gap: clamp(20px, 5vw, 36px); }
    /* celu: una columna, las piezas grandes y protagonistas */
    .bn-grid { grid-template-columns: 1fr; gap: 14px; }
    /* y una sola línea bajo la grilla: solo "Ver todos los trabajos" */
    .bn-sw { display: none; }
    .bn-below { justify-content: flex-start; }
  }
  @media (hover: none) {
    .bn-glow { display: none; }
    .bn-cell-cap { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bn-glow { display: none; }
  }
</style>

<script>
  /* Filtros de la grilla: funcionan en todos los modos (táctil incluido). */
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  if (grid) {
    // cascada al entrar en viewport (se repite en cada pasada de scroll)
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => grid.classList.toggle('in', en.isIntersecting));
      }, { threshold: 0, rootMargin: '0px 0px -7% 0px' });
      io.observe(grid);
    } else {
      grid.classList.add('in');
    }

    const cells = Array.from(grid.querySelectorAll<HTMLElement>('.bn-cell'));
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.bn-filter'));
    const count = document.querySelector<HTMLElement>('[data-grid-count]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter;
        btns.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-on', on);
          b.setAttribute('aria-pressed', String(on));
        });
        let shown = 0;
        cells.forEach((c) => {
          const show = key === 'all' || c.dataset.cat === key;
          c.classList.toggle('is-hidden', !show);
          if (show) c.style.setProperty('--i', String(shown++));
        });
        if (count) count.textContent = String(shown);
        if (!reduce) {
          // reinicia la entrada escalonada de las visibles
          cells.forEach((c) => {
            if (c.classList.contains('is-hidden')) return;
            c.style.animation = 'none';
            void c.offsetWidth;
            c.style.animation = '';
          });
        }
      });
    });
  }
</script>
