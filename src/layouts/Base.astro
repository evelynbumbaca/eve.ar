---
import '../styles/global.css';
import Topbar from '../components/Topbar.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
import GlowLayer from '../components/GlowLayer.astro';
import { ui } from '../i18n/ui';
import { link } from '../lib/link';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'EVE — Multimedia & UX/UI Designer · Buenos Aires',
  description = 'Eve, Diseñadora Multimedia & UX/UI especializada en motion, radicada en Buenos Aires. Identidad, motion, editorial y producto digital.',
} = Astro.props;

const ogImage = new URL(link('/og.png'), Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f5" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href={link('/favicon.svg')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <GlowLayer />
    <Topbar />
    <MenuOverlay />

    <main id="top">
      <slot />
    </main>

    <!-- Logica de cliente: idioma en vivo, menu, reveal on scroll -->
    <script is:inline define:vars={{ ui }}>
      (function () {
        /* ---------- idioma (ES/EN en vivo) ---------- */
        const KEY = 'eve-lang';
        let lang = localStorage.getItem(KEY) || 'es';

        function swap(el, l) {
          if (el.hasAttribute('data-i18n')) {
            const v = (ui[l] || {})[el.getAttribute('data-i18n')];
            if (v != null) el.textContent = v;
          } else {
            const v = el.getAttribute('data-' + l);
            if (v != null) el.textContent = v;
          }
        }
        function applyLang(l) {
          document.documentElement.lang = l;
          document.querySelectorAll('[data-i18n],[data-es]').forEach((el) => swap(el, l));
          document.querySelectorAll('[data-lang-opt]').forEach((s) => {
            s.classList.toggle('on', s.getAttribute('data-lang-opt') === l);
          });
        }
        window.__eveSetLang = (l) => {
          lang = l;
          localStorage.setItem(KEY, l);
          applyLang(l);
        };
        applyLang(lang);

        /* ---------- menu overlay ---------- */
        const closeMenu = () => document.body.classList.remove('menu-open');

        document.addEventListener('click', (e) => {
          if (e.target.closest('[data-lang-btn]')) {
            window.__eveSetLang(lang === 'es' ? 'en' : 'es');
            return;
          }
          if (e.target.closest('[data-menu-toggle]')) {
            document.body.classList.toggle('menu-open');
            return;
          }
          var navA = e.target.closest('.overlay nav a');
          if (navA) {
            closeMenu();
            // ancla en la misma página: scroll manual (el clic repetido con el
            // hash ya presente en la URL no dispara navegación sola)
            try {
              var u = new URL(navA.href, location.href);
              if (u.pathname === location.pathname && u.hash) {
                e.preventDefault();
                var el = document.querySelector(u.hash);
                if (el) {
                  var smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
                  el.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
                  history.pushState(null, '', u.hash);
                }
              }
            } catch (err) {}
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeMenu();
        });

        /* ---------- reveal on scroll (se repite en CADA entrada) ----------
           IntersectionObserver con toggle: al entrar en viewport el elemento
           se revela; al salir del todo, se re-arma y vuelve a revelarse en la
           próxima pasada (ambas direcciones). Nativo, sin listeners de scroll.
           Con reduced-motion (o sin IO): todo visible, estático. */
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revEls = document.querySelectorAll('.reveal, .rise');
        if (reduce || !('IntersectionObserver' in window)) {
          revEls.forEach((el) => el.classList.add('in'));
        } else {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((en) => en.target.classList.toggle('in', en.isIntersecting));
          }, { threshold: 0, rootMargin: '0px 0px -7% 0px' });
          revEls.forEach((el) => io.observe(el));
        }
      })();
    </script>
  </body>
</html>
