---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import T from '../components/T.astro';
import { site } from '../data/site';

// Productos placeholder — se reemplazan por los reales de Gumroad.
const products = [
  { name: 'Editorial Grid Kit', tag: { es: 'Plantilla · InDesign', en: 'Template · InDesign' }, price: 'US$ 18' },
  { name: 'Ink Texture Pack', tag: { es: 'Texturas · 30 piezas', en: 'Textures · 30 pieces' }, price: 'US$ 12' },
  { name: 'UI Starter — Figma', tag: { es: 'UI Kit · Figma', en: 'UI Kit · Figma' }, price: 'US$ 24' },
  { name: 'Type Specimen Set', tag: { es: 'Mockups · 12 piezas', en: 'Mockups · 12 pieces' }, price: 'US$ 9' },
];
---

<Base title="Tienda — EVE" description="Recursos digitales de Eve: plantillas, texturas y kits — en Gumroad.">
  <article class="page tienda">
    <div class="wrap">
      <header class="page-head">
        <span class="kicker mono cap"><T es="Tienda" en="Shop" /></span>
        <h1 class="page-title reveal">
          <span class="revfill"><T es="Recursos para" en="Resources to" /></span>
        </h1>
        <h1 class="page-title reveal">
          <span class="revfill accent"><T es="diseñar mejor." en="design better." /></span>
        </h1>
        <p class="page-sub rise">
          <T es="Plantillas, texturas y kits digitales — listos para descargar en Gumroad." en="Templates, textures and digital kits — ready to download on Gumroad." />
        </p>
      </header>

      <div class="shop-grid">
        {products.map((p) => (
          <a class="product" href={site.gumroad} target="_blank" rel="noopener noreferrer">
            <div class="product-frame reveal">
              <span class="ph revfill" data-label={`${p.name} — preview`}></span>
            </div>
            <div class="product-meta rise">
              <h3>{p.name}</h3>
              <p>
                <span data-es={p.tag.es} data-en={p.tag.en}>{p.tag.es}</span>
                <span class="price">{p.price}</span>
              </p>
            </div>
          </a>
        ))}
      </div>

      <div class="shop-cta rise">
        <a class="btn" href={site.gumroad} target="_blank" rel="noopener noreferrer">
          <T es="Ver todo en Gumroad" en="See all on Gumroad" />
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </article>

  <SiteFooter />
</Base>

<style>
  .page { padding-top: clamp(120px, 18vh, 200px); }
  .page-head { margin-bottom: clamp(40px, 7vh, 90px); }
  .kicker { display: block; color: var(--ink-60); margin-bottom: clamp(20px, 3vh, 34px); }
  .page-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--fs-h1);
    line-height: 1.0;
    letter-spacing: -0.02em;
  }
  .page-title .accent { font-style: italic; font-weight: 300; color: var(--ink-80); }
  .page-title .revfill { display: block; }
  .page-sub {
    margin-top: 22px;
    max-width: 40ch;
    color: var(--ink-80);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.5;
  }

  .shop-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 2.4vw, 36px) clamp(16px, 1.8vw, 26px);
  }
  .product-frame { width: 100%; aspect-ratio: 1 / 1; }
  .product-frame .ph { width: 100%; height: 100%; transition: opacity 0.4s var(--ease); }
  .product:hover .product-frame .ph { opacity: 0.82; }
  .product-meta { padding-top: 12px; }
  .product-meta h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.15;
  }
  .product-meta p {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 5px;
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-60);
  }
  .product-meta .price { color: var(--ink); }

  .shop-cta { margin-top: clamp(48px, 8vh, 96px); display: flex; justify-content: center; }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 15px 30px;
    border: 1px solid var(--ink);
    border-radius: 40px;
    font-family: var(--sans);
    font-size: 14px;
    letter-spacing: 0.04em;
    transition: background 0.25s var(--ease), color 0.25s var(--ease);
  }
  .btn:hover { background: var(--ink); color: var(--paper); }

  @media (max-width: 820px) {
    .shop-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
