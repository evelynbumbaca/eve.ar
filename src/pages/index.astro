---
import Base from '../layouts/Base.astro';
import HomeIntro from '../components/HomeIntro.astro';
import PacksSection from '../components/PacksSection.astro';
import Testimonials from '../components/Testimonials.astro';
import EstudioSection from '../components/EstudioSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Base>
  {/* gate: activa el modo enhanced antes del primer paint */}
  <script is:inline>
    try {
      var _f = matchMedia('(hover:hover) and (pointer:fine)').matches;
      var _r = matchMedia('(prefers-reduced-motion:reduce)').matches;
      // logo del inicio animado (cualquier puntero); estiramiento de letras = puntero fino
      if (!_r) document.documentElement.classList.add('morph-on');
      if (_f && !_r) document.documentElement.classList.add('home-fx');
    } catch (e) {}
  </script>

  <h1 class="visually-hidden">Eve — Diseñadora Multimedia & UX/UI · Buenos Aires, Argentina</h1>

  <HomeIntro />
  <PacksSection />
  <Testimonials />
  <EstudioSection />
  <SiteFooter />
</Base>
