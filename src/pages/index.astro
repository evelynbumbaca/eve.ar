---
import Base from '../layouts/Base.astro';
import HeroIndex from '../components/HeroIndex.astro';
import SiteFooter from '../components/SiteFooter.astro';
import T from '../components/T.astro';
import { link } from '../lib/link';
---

<Base>
  <h1 class="visually-hidden">Eve — Diseñadora Multimedia & UX/UI · Buenos Aires, Argentina</h1>

  <HeroIndex />

  <section class="home-about">
    <div class="wrap">
      <p class="ha-kicker mono cap"><T es="Estudio" en="About" /></p>
      <p class="ha-lead rise">
        <T
          es="Eve es Diseñadora Multimedia & UX/UI radicada en Buenos Aires. Trabaja en la intersección entre lo editorial, la identidad de marca y el producto digital — con criterio, claridad y carácter."
          en="Eve is a Multimedia & UX/UI Designer based in Buenos Aires. She works at the intersection of editorial, brand identity and digital product — with judgment, clarity and character."
        />
      </p>
      <a class="ha-link rise rise-delay-1" href={link('/estudio')}>
        <T es="Conocé el enfoque" en="Read the approach" />
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <SiteFooter />
</Base>

<style>
  .home-about {
    padding-top: clamp(64px, 12vh, 150px);
    padding-bottom: clamp(8px, 3vh, 40px);
  }
  .ha-kicker { color: var(--ink-45); margin-bottom: clamp(22px, 4vh, 40px); }
  .ha-lead {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.5rem, 3.4vw, 2.7rem);
    line-height: 1.28;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 24ch;
  }
  .ha-link {
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    margin-top: clamp(26px, 4vh, 46px);
    font-family: var(--sans);
    font-size: clamp(14px, 1.1vw, 16px);
    letter-spacing: 0.02em;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 4px;
    transition: opacity var(--dur-micro) var(--ease-quint);
  }
  .ha-link span { transition: transform var(--dur-ui) var(--ease-out); display: inline-block; }
  .ha-link:hover { opacity: 0.62; }
  .ha-link:hover span { transform: translateX(6px); }
</style>
