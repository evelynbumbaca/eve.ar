---
import Base from '../layouts/Base.astro';
import HomeBanner from '../components/HomeBanner.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Base>
  {/* gate: activa el modo enhanced antes del primer paint */}
  <script is:inline>
    try {
      var _f = matchMedia('(hover:hover) and (pointer:fine)').matches;
      var _r = matchMedia('(prefers-reduced-motion:reduce)').matches;
      if (_f && !_r) document.documentElement.classList.add('home-fx');
    } catch (e) {}
  </script>

  <h1 class="visually-hidden">Eve — Diseñadora Multimedia & UX/UI · Buenos Aires, Argentina</h1>

  <HomeBanner />
  <SiteFooter />
</Base>

<script>
  const reduce = matchMedia('(prefers-reduced-motion:reduce)').matches;
  const fine = matchMedia('(hover:hover) and (pointer:fine)').matches;
  const enhance = fine && !reduce;
  const html = document.documentElement;

  const banner = document.querySelector('[data-banner]') as HTMLElement | null;
  const glow = document.querySelector('[data-glow]') as HTMLElement | null;
  const fly = document.querySelector('[data-name-fly]') as HTMLElement | null;
  const slot = document.querySelector('.bn-name-slot') as HTMLElement | null;
  const target = document.querySelector('[data-name-target]') as HTMLElement | null;

  if (!enhance || !banner || !glow || !fly || !slot || !target) {
    html.classList.remove('home-fx');
  } else {
    html.classList.add('home-fx');

    const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);

    // geometría en coordenadas de DOCUMENTO (robusta ante recarga a mitad de scroll)
    let vh = innerHeight;
    let bannerDocX = 0, bannerDocY = 0;
    let slotDocX = 0, slotDocY = 0;
    let tX = 0, tY = 0, scaleFinal = 0.16, scrollEnd = 1;

    // glow que sigue al cursor
    let gx = innerWidth / 2, gy = vh * 0.4, glx = gx, gly = gy;

    // una pasada del morph (también usada sincrónicamente tras medir)
    const applyMorph = () => {
      const p = clamp01(scrollY / scrollEnd);
      const e = p >= 1 ? 1 : 1 - Math.pow(2, -10 * p);
      const bx = slotDocX - scrollX, by = slotDocY - scrollY;
      const x = bx + e * (tX - bx), y = by + e * (tY - by);
      const sc = 1 + (scaleFinal - 1) * e;
      fly.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) scale(${sc.toFixed(3)})`;
      if (e > 0.97) { fly.style.opacity = '0'; target.style.opacity = '1'; }
      else { fly.style.opacity = '1'; target.style.opacity = String(Math.max(0, (e - 0.5) * 2)); }
    };

    function measure() {
      vh = innerHeight;
      const br = banner.getBoundingClientRect();
      bannerDocX = br.left + scrollX; bannerDocY = br.top + scrollY;
      const sr = slot.getBoundingClientRect();
      slotDocX = sr.left + scrollX; slotDocY = sr.top + scrollY;
      const tr = target.getBoundingClientRect(); // topbar fijo -> coords de viewport constantes
      tX = tr.left; tY = tr.top;
      scaleFinal = Math.max(0.06, Math.min(0.5, tr.height / (sr.height || 1)));
      scrollEnd = Math.max(120, vh * 0.5);
      applyMorph(); // aplica sin esperar al próximo frame (evita flash)
    }

    let raf = 0, running = false, scrollDirty = true;
    function frame() {
      glx += (gx - glx) * 0.14;
      gly += (gy - gly) * 0.14;
      // posición del glow en el espacio del banner, sin leer layout por frame
      glow.style.transform = `translate3d(${(glx - (bannerDocX - scrollX)).toFixed(1)}px, ${(gly - (bannerDocY - scrollY)).toFixed(1)}px, 0)`;
      applyMorph();
      const moving = Math.abs(gx - glx) > 0.3 || Math.abs(gy - gly) > 0.3 || scrollDirty;
      scrollDirty = false;
      if (moving) raf = requestAnimationFrame(frame);
      else running = false;
    }
    function kick() { if (!running) { running = true; raf = requestAnimationFrame(frame); } }

    banner.addEventListener('pointermove', (e) => {
      gx = e.clientX; gy = e.clientY;
      if (!banner.classList.contains('glow-on')) banner.classList.add('glow-on');
      kick();
    }, { passive: true });
    banner.addEventListener('pointerleave', () => banner.classList.remove('glow-on'));
    addEventListener('scroll', () => { scrollDirty = true; kick(); }, { passive: true });
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(() => { measure(); scrollDirty = true; kick(); }, 150); }, { passive: true });
    document.addEventListener('visibilitychange', () => { if (document.hidden) { cancelAnimationFrame(raf); running = false; } else kick(); });

    // re-medir cuando cambia el idioma (el layout de la cabecera puede reflowear)
    const origSetLang = (window as any).__eveSetLang;
    if (origSetLang) {
      (window as any).__eveSetLang = (l: string) => {
        origSetLang(l);
        requestAnimationFrame(() => requestAnimationFrame(() => { measure(); scrollDirty = true; kick(); }));
      };
    }

    measure();
    kick();
    // re-medir tras cargar las fuentes (Inter cambia métricas del nombre)
    if ((document as any).fonts && (document as any).fonts.ready) {
      (document as any).fonts.ready.then(() => { measure(); scrollDirty = true; kick(); });
    }
    addEventListener('load', () => { measure(); scrollDirty = true; kick(); }, { once: true });
  }
</script>
