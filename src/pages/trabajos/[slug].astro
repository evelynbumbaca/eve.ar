---
import Base from '../../layouts/Base.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import T from '../../components/T.astro';
import { projects, caseSample as C } from '../../data/site';
import { cases } from '../../data/cases';
import { link } from '../../lib/link';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}

const { project: P, next: NEXT } = Astro.props;

/* caso con contenido propio (bloques) o molde genérico */
const K = cases[P.id];
let figN = 0;
const blocks = (K?.blocks ?? []).map((b) => (b.t === 'fig' || b.t === 'video' || b.t === 'gallery' ? { ...b, n: ++figN } : b));
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base title={`${P.title} — EVE`} description={`${P.title} — caso de estudio. ${P.disc.es}.`}>
  <article class="case">
    {/* HERO a sangre: la obra a todos los bordes, el título encima */}
    <header class="c-hero">
      <div class="c-hero-media">
        {K?.heroVideo
          ? <video class="c-hero-photo" src={link(`/${K.heroVideo.src}`)} poster={link(`/${K.heroVideo.poster}`)} autoplay muted loop playsinline preload="auto" aria-label={`${P.title} — portada`}></video>
          : (K?.heroImage ?? P.hero)
            ? <img class="c-hero-photo" src={link(`/${K?.heroImage ?? P.hero}`)} alt={`${P.title} — portada`} />
            : <span class="ph" data-label={`${P.title} — portada`}></span>}
      </div>
      <div class="c-hero-scrim" aria-hidden="true"></div>
      <div class="c-hero-cap wrap">
        <p class="c-hero-kick mono"><span data-es={P.disc.es} data-en={P.disc.en}>{P.disc.es}</span> · {P.year}</p>
        <h1 class="c-hero-title">{P.title}</h1>
      </div>
      <span class="c-hero-scroll" aria-hidden="true"></span>
    </header>

    <div class="wrap">
      <dl class="c-meta">
        <div>
          <dt><T es={K ? 'Contexto' : 'Cliente'} en={K ? 'Context' : 'Client'} /></dt>
          <dd>{K ? <span data-es={K.meta.context.es} data-en={K.meta.context.en}>{K.meta.context.es}</span> : P.title}</dd>
        </div>
        <div>
          <dt><T es="Servicios" en="Services" /></dt>
          <dd><span data-es={P.disc.es} data-en={P.disc.en}>{P.disc.es}</span></dd>
        </div>
        <div><dt><T es="Año" en="Year" /></dt><dd>{P.year}</dd></div>
        <div>
          <dt><T es="Rol" en="Role" /></dt>
          <dd>{K
            ? <span data-es={K.meta.role.es} data-en={K.meta.role.en}>{K.meta.role.es}</span>
            : <span data-es={C.role.es} data-en={C.role.en}>{C.role.es}</span>}</dd>
        </div>
        {K && (
          <div><dt><T es="Herramientas" en="Tools" /></dt><dd>{K.meta.tools}</dd></div>
        )}
      </dl>
    </div>

    {K ? (
      <div class="c-body wrap" style={K.theme ? `--lk-wine:${K.theme.wine};--lk-coral:${K.theme.coral};--lk-cream:${K.theme.cream};--lk-night:${K.theme.night}` : undefined}>
        <p class="c-intro rise"><span data-es={K.intro.es} data-en={K.intro.en}>{K.intro.es}</span></p>

        {blocks.map((b) => {
          switch (b.t) {
            case 'h': return (
              <h2 class="k-h rise"><span class="mono">{b.n}</span><span data-es={b.es} data-en={b.en}>{b.es}</span></h2>
            );
            case 'p': return <p class="k-p rise"><span data-es={b.es} data-en={b.en}>{b.es}</span></p>;
            case 'note': return <p class="k-note mono"><span data-es={b.es} data-en={b.en}>{b.es}</span></p>;
            case 'os': return (
              <div class="c-os k-os">
                {b.items.map((it) => (
                  <div class="os-box rise">
                    <h4><span data-es={it.label.es} data-en={it.label.en}>{it.label.es}</span></h4>
                    <p><span data-es={it.es} data-en={it.en}>{it.es}</span></p>
                  </div>
                ))}
              </div>
            );
            case 'list': return (
              <div class="k-list rise">
                <h3 class="k-sub"><span data-es={b.title.es} data-en={b.title.en}>{b.title.es}</span></h3>
                <ol>
                  {b.items.map((it, i) => (
                    <li><span class="mono">{pad(i + 1)}</span><span data-es={it.es} data-en={it.en}>{it.es}</span></li>
                  ))}
                </ol>
              </div>
            );
            case 'cols': return (
              <div class="k-cols">
                {b.items.map((it) => (
                  <div class="rise">
                    <h3 class="k-sub"><span data-es={it.title.es} data-en={it.title.en}>{it.title.es}</span></h3>
                    <p><span data-es={it.es} data-en={it.en}>{it.es}</span></p>
                  </div>
                ))}
              </div>
            );
            case 'stats': return (
              <div class="k-stats">
                {b.items.map((it) => (
                  <div class="rise">
                    <span class="k-n">{it.n}</span>
                    <p><span data-es={it.es} data-en={it.en}>{it.es}</span></p>
                  </div>
                ))}
              </div>
            );
            case 'fig': return (
              <figure class={`c-figure k-fig ${b.w === 'narrow' ? 'narrow' : ''}`}>
                <div class="frame reveal">
                  <img class="revfill" src={link(`/${b.src}`)} alt={b.es} loading="lazy" decoding="async" />
                </div>
                <figcaption>
                  <span data-es={b.es} data-en={b.en}>{b.es}</span>
                  <span class="mono">FIG {pad(b.n)}</span>
                </figcaption>
              </figure>
            );
            case 'video': return (
              <figure class="c-figure k-fig">
                <div class="frame reveal">
                  <video class="revfill" src={link(`/${b.src}`)} autoplay muted loop playsinline preload="metadata" aria-label={b.es}></video>
                </div>
                <figcaption>
                  <span data-es={b.es} data-en={b.en}>{b.es}</span>
                  <span class="mono">FIG {pad(b.n)}</span>
                </figcaption>
              </figure>
            );
            case 'compare': return (
              <figure class="c-figure k-fig lk-compare">
                <div class="lk-cards" style={`--n:${b.items.length}`}>
                  {b.items.map((it) => (
                    <div class="lk-card rise">
                      <h4>{it.name}</h4>
                      {b.rows.map((r, ri) => (
                        <div class={`lk-cell ${ri === 1 ? 'weak' : ''}`}>
                          <span class="lk-lab" data-es={r.es} data-en={r.en}>{r.es}</span>
                          <p><span data-es={it.vals[ri].es} data-en={it.vals[ri].en}>{it.vals[ri].es}</span></p>
                        </div>
                      ))}
                    </div>
                  ))}
                </div>
                <figcaption><span data-es={b.es} data-en={b.en}>{b.es}</span></figcaption>
              </figure>
            );
            case 'sitemap': return (
              <figure class="c-figure k-fig lk-map">
                <div class="lk-tiles">
                  <div class="lk-tile root rise">
                    <img src={link(`/${b.icon}`)} alt="" width="64" height="64" loading="lazy" decoding="async" />
                    <h4>{b.root}</h4>
                    <p><span data-es={b.rootNote.es} data-en={b.rootNote.en}>{b.rootNote.es}</span></p>
                  </div>
                  {b.branches.map((br) => (
                    <div class="lk-tile rise">
                      <h4><span data-es={br.title.es} data-en={br.title.en}>{br.title.es}</span></h4>
                      {br.kids.length > 0 && (
                        <ul>
                          {br.kids.map((k) => <li><span data-es={k.es} data-en={k.en}>{k.es}</span></li>)}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
                <figcaption><span data-es={b.es} data-en={b.en}>{b.es}</span></figcaption>
              </figure>
            );
            case 'steps': return (
              <figure class="c-figure k-fig lk-steps">
                <ol class="lk-flow">
                  {b.items.map((it, i) => (
                    <li class="rise">
                      <span class="lk-dia"><b class="mono">{i + 1}</b></span>
                      <span class="lk-step" data-es={it.es} data-en={it.en}>{it.es}</span>
                    </li>
                  ))}
                </ol>
                <figcaption><span data-es={b.es} data-en={b.en}>{b.es}</span></figcaption>
              </figure>
            );
            case 'fidelity': return (
              <figure class="c-figure k-fig lk-fid">
                <div class="lk-stages">
                  {b.items.map((it, i) => (
                    <div class="lk-stage rise">
                      <div class="lk-phone" data-kind={it.kind} aria-hidden="true">
                        <i class="notch"></i>
                        {it.kind === 'hi'
                          ? <img class="logo" src={link(`/${b.logo}`)} alt="" loading="lazy" decoding="async" />
                          : <i class="bar"></i>}
                        <i class="img"></i>
                        <i class="ln"></i><i class="ln s"></i>
                        <i class="btn"></i>
                        <i class="tab"></i>
                      </div>
                      <h4><span class="mono">{pad(i + 1)}</span> <span data-es={it.title.es} data-en={it.title.en}>{it.title.es}</span></h4>
                      <p><span data-es={it.text.es} data-en={it.text.en}>{it.text.es}</span></p>
                    </div>
                  ))}
                </div>
                <figcaption><span data-es={b.es} data-en={b.en}>{b.es}</span></figcaption>
              </figure>
            );
            case 'bars': return (
              <figure class="c-figure k-fig lk-bars">
                <div class="lk-panel">
                  <ul class="lk-legend">
                    {b.legend.map((l) => <li><i class={`t-${l.key}`}></i><span data-es={l.label.es} data-en={l.label.en}>{l.label.es}</span></li>)}
                  </ul>
                  {b.items.map((it) => (
                    <div class={`lk-row ${it.hot ? 'hot' : ''}`}>
                      <p class="lk-q"><span data-es={it.q.es} data-en={it.q.en}>{it.q.es}</span></p>
                      <div class="lk-bar">
                        {it.parts.map((pt) => <span class={`t-${pt.key}`} style={`width:${pt.pct}%`}>{pt.pct}%</span>)}
                      </div>
                    </div>
                  ))}
                </div>
                <figcaption><span data-es={b.es} data-en={b.en}>{b.es}</span></figcaption>
              </figure>
            );
            case 'brand': return (
              <figure class="c-figure k-fig lk-brand">
                <div class="lk-panel lk-brand-grid">
                  <div class="lk-logo"><img src={link(`/${b.logo}`)} alt="Logo Lookap" loading="lazy" decoding="async" /></div>
                  <div class="lk-mark">
                    <img class="lk-icon" src={link(`/${b.icon}`)} alt="Ícono de la app" width="96" height="96" loading="lazy" decoding="async" />
                    <div class="lk-swatches">
                      {b.swatches.map((sw) => (
                        <div class="lk-sw"><i class={`tone-${sw.tone}`}></i><span data-es={sw.name.es} data-en={sw.name.en}>{sw.name.es}</span></div>
                      ))}
                    </div>
                  </div>
                  <dl class="lk-type">
                    {b.type.map((ty) => (
                      <div><dt>{ty.name}</dt><dd><span data-es={ty.text.es} data-en={ty.text.en}>{ty.text.es}</span></dd></div>
                    ))}
                  </dl>
                </div>
                <figcaption><span data-es={b.es} data-en={b.en}>{b.es}</span></figcaption>
              </figure>
            );
            case 'gallery': return (
              <figure class="c-figure k-fig k-gallery">
                <div class="k-gal-grid">
                  {b.items.map((it) => (
                    <div class="frame reveal">
                      <img class="revfill" src={link(`/${it.src}`)} alt={it.alt} loading="lazy" decoding="async" />
                    </div>
                  ))}
                </div>
                <figcaption>
                  <span data-es={b.es} data-en={b.en}>{b.es}</span>
                  <span class="mono">FIG {pad(b.n)}</span>
                </figcaption>
              </figure>
            );
            case 'split': return (
              <div class="k-split">
                <div class="frame reveal">
                  <img class="revfill" src={link(`/${b.src}`)} alt={b.alt} loading="lazy" decoding="async" />
                </div>
                <p class="rise"><span data-es={b.es} data-en={b.en}>{b.es}</span></p>
              </div>
            );
            case 'break': return (
              <div class={`k-break ${b.w === 'narrow' ? 'narrow' : ''}`}>
                <div class="frame reveal">
                  {b.kind === 'video'
                    ? <video class="revfill" src={link(`/${b.src}`)} autoplay muted loop playsinline preload="metadata" aria-label={b.alt}></video>
                    : <img class="revfill" src={link(`/${b.src}`)} alt={b.alt} loading="lazy" decoding="async" />}
                </div>
              </div>
            );
            case 'links': return (
              <div class="k-links">
                {b.items.map((it) => (
                  <a href={it.href} target="_blank" rel="noopener noreferrer">
                    <span data-es={it.es} data-en={it.en}>{it.es}</span> <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            );
          }
        })}
      </div>
    ) : (
    <div class="c-body wrap">
        <p class="c-intro rise"><span data-es={C.intro.es} data-en={C.intro.en}>{C.intro.es}</span></p>
  
        <div class="c-os">
          <div class="os-box objetivo rise">
            <h4><span data-es={C.objetivo.label.es} data-en={C.objetivo.label.en}>{C.objetivo.label.es}</span></h4>
            <p><span data-es={C.objetivo.es} data-en={C.objetivo.en}>{C.objetivo.es}</span></p>
          </div>
          <div class="os-box solucion rise">
            <h4><span data-es={C.solucion.label.es} data-en={C.solucion.label.en}>{C.solucion.label.es}</span></h4>
            <p><span data-es={C.solucion.es} data-en={C.solucion.en}>{C.solucion.es}</span></p>
          </div>
        </div>
  
        {C.sections.map((s, i) => (
          <figure class={`c-figure ${i === 1 ? 'tall' : ''}`}>
            <div class="frame reveal"><span class="ph revfill" data-label={s.es}></span></div>
            <figcaption>
              <span data-es={s.es} data-en={s.en}>{s.es}</span>
              <span class="mono">FIG {String(i + 1).padStart(2, '0')}</span>
            </figcaption>
          </figure>
        ))}
  
        <blockquote class="c-quote rise">
          <span data-es={`“${C.quote.es}”`} data-en={`“${C.quote.en}”`}>“{C.quote.es}”</span>
        </blockquote>
      </div>
    )}

    <div class="wrap">
      <div class="c-next">
        <span class="lab"><T es="Siguiente proyecto" en="Next project" /></span>
        <a href={link(`/trabajos/${NEXT.id}`)}>{NEXT.title} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </article>

  <SiteFooter />
</Base>

<style>
  .case { padding-bottom: clamp(40px, 8vh, 96px); }

  /* ---------- HERO a sangre (imagen a todos los bordes + título encima) ---------- */
  .c-hero {
    position: relative;
    width: 100%;
    height: clamp(560px, 92vh, 920px);
    overflow: hidden;
    background: var(--ink);
    isolation: isolate;
  }
  .c-hero-media { position: absolute; inset: 0; z-index: 0; }
  .c-hero-media .ph {
    width: 100%; height: 100%;
    /* placeholder editorial oscuro (demo). Con imagen real: <img> object-fit:cover */
    background: radial-gradient(135% 110% at 28% 16%, #3d342c 0%, #231d19 52%, #14100d 100%);
    box-shadow: none;
  }
  .c-hero-media .ph::after { color: rgba(255, 255, 255, 0.26); }
  .c-hero-photo { width: 100%; height: 100%; object-fit: cover; object-position: 50% 48%; display: block; }

  .c-hero-scrim {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to top,
      rgba(12, 11, 9, 0.66) 0%,
      rgba(12, 11, 9, 0.20) 38%,
      rgba(12, 11, 9, 0.04) 68%,
      rgba(12, 11, 9, 0.10) 100%);
  }

  .c-hero-cap { position: absolute; left: 0; right: 0; bottom: clamp(34px, 6.5vh, 78px); z-index: 2; }
  .c-hero-kick { color: rgba(255, 255, 255, 0.80); margin-bottom: clamp(12px, 1.8vh, 20px); }
  .c-hero-title {
    font-family: var(--serif); font-weight: 400;
    font-size: clamp(2.6rem, 8.5vw, 7.2rem);
    line-height: 0.96; letter-spacing: -0.02em;
    color: #fff; text-wrap: balance; max-width: 15ch;
  }

  /* indicador de scroll (línea fina que respira) */
  .c-hero-scroll {
    position: absolute; z-index: 2; right: var(--pad); bottom: clamp(34px, 6.5vh, 78px);
    width: 1px; height: clamp(36px, 6vh, 60px);
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.75));
  }

  @media (prefers-reduced-motion: no-preference) {
    .c-hero-media .ph,
    .c-hero-photo { animation: heroZoom 1.5s var(--ease-out) both; transform-origin: 50% 40%; }
    @keyframes heroZoom { from { transform: scale(1.09); } to { transform: scale(1); } }
    .c-hero-kick { animation: heroRise 0.9s var(--ease-out) 0.15s both; }
    .c-hero-title { animation: heroRise 1s var(--ease-out) 0.28s both; }
    @keyframes heroRise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
    .c-hero-scroll { animation: heroScroll 2.2s var(--ease) 0.8s infinite; transform-origin: top; }
    @keyframes heroScroll { 0%, 100% { transform: scaleY(0.4); opacity: 0.4; } 50% { transform: scaleY(1); opacity: 1; } }
  }

  .c-meta {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 24px;
    padding: clamp(22px, 3vh, 34px) 0;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    margin-top: clamp(56px, 9vh, 112px);
  }
  .c-meta dt { font-family: var(--sans); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-60); margin-bottom: 7px; }
  .c-meta dd { font-family: var(--serif); font-size: clamp(15px, 1.3vw, 18px); line-height: 1.3; }

  .c-body { max-width: 980px; }
  .c-intro {
    font-family: var(--serif); font-weight: 300;
    font-size: clamp(20px, 2.5vw, 30px); line-height: 1.32; letter-spacing: -0.01em;
    max-width: 24ch; margin: clamp(48px, 9vh, 110px) 0 0;
  }

  .c-os { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 2vw, 26px); margin-top: clamp(34px, 5vh, 56px); }
  .os-box { border: 1px solid var(--ink); border-radius: 3px; padding: clamp(20px, 2vw, 30px); }
  .os-box h4 {
    font-family: var(--sans); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink); margin-bottom: 13px; display: flex; align-items: center; gap: 9px;
  }
  .os-box h4::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--ink); }
  .os-box.solucion h4::before { background: transparent; box-shadow: inset 0 0 0 1.5px var(--ink); }
  .os-box p { font-family: var(--serif); font-size: clamp(16px, 1.5vw, 20px); line-height: 1.4; }

  /* ritmo de museo: cada pieza respira */
  .c-figure { margin-top: clamp(72px, 14vh, 180px); }
  .c-figure .frame { width: 100%; aspect-ratio: 3 / 2; border-radius: 3px; }
  .c-figure.tall .frame { aspect-ratio: 4 / 5; max-width: 620px; margin: 0 auto; }
  .c-figure .ph { width: 100%; height: 100%; }
  .c-figure figcaption {
    font-family: var(--sans); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-60); margin-top: 18px; display: flex; justify-content: space-between;
  }

  .c-quote {
    font-family: var(--serif); font-weight: 300; font-style: italic;
    font-size: clamp(26px, 4vw, 48px); line-height: 1.16; letter-spacing: -0.015em;
    text-wrap: balance; padding: clamp(72px, 13vh, 160px) 0; max-width: 20ch; margin: 0 auto; text-align: center;
  }

  /* siguiente proyecto: sutil, de galería */
  .c-next {
    display: flex; align-items: baseline; justify-content: space-between; gap: 20px;
    border-top: 1px solid var(--line); padding-top: 22px; margin-top: clamp(30px, 5vh, 60px);
  }
  .c-next .lab { font-family: var(--sans); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-45); }
  .c-next a {
    display: inline-flex; align-items: baseline; gap: 10px;
    font-family: var(--serif); font-size: clamp(1.1rem, 1.7vw, 1.5rem);
    line-height: 1; letter-spacing: -0.01em;
    border-bottom: 1px solid var(--ink-35); padding-bottom: 3px;
    transition: opacity 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .c-next a:hover { opacity: 0.65; border-color: var(--ink); }

  @media (max-width: 860px) {
    .c-meta { grid-template-columns: 1fr 1fr; gap: 18px 24px; }
    .c-os { grid-template-columns: 1fr; }
  }

  /* ---------- caso con contenido propio (bloques) ---------- */
  .k-h {
    display: flex; align-items: baseline; gap: 18px;
    font-family: var(--serif); font-weight: 400; font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1; letter-spacing: -0.02em;
    margin-top: clamp(96px, 17vh, 200px); padding-top: 22px; border-top: 1px solid var(--ink);
  }
  .k-h .mono { font-size: 12px; letter-spacing: 0.1em; color: var(--ink-60); }
  .k-p {
    font-family: var(--serif); font-size: clamp(17px, 1.7vw, 22px); line-height: 1.42;
    max-width: 38em; margin-top: clamp(22px, 3.2vh, 36px);
  }
  .k-note { color: var(--ink-60); margin-top: 18px; }
  .k-os { grid-template-columns: repeat(3, 1fr); }
  .k-os .os-box p { font-size: clamp(15px, 1.25vw, 17px); }

  .k-sub {
