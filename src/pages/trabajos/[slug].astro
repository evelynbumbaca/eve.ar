---
import Base from '../../layouts/Base.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import T from '../../components/T.astro';
import CaseTree from '../../components/CaseTree.astro';
import { projects, caseSample as C } from '../../data/site';
import { cases } from '../../data/cases';
import { link } from '../../lib/link';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}

const { project: P, next: NEXT } = Astro.props;

/* caso con contenido propio (bloques) o molde genérico */
const K = cases[P.id];
let figN = 0;
const blocks = (K?.blocks ?? []).map((b) => (b.t === 'fig' || b.t === 'video' || b.t === 'gallery' ? { ...b, n: ++figN } : b));
const pad = (n: number) => String(n).padStart(2, '0');
const navItems = blocks.filter((b) => b.t === 'h') as { t: 'h'; n: string; es: string; en: string; nav?: { es: string; en: string } }[];
---

<Base title={`${P.title} — EVE`} description={`${P.title} — caso de estudio. ${P.disc.es}.`}>
  <article class="case">
    {K && (
      <>
        <div class="k-progress" aria-hidden="true"><i></i></div>
        <nav class="k-nav" aria-label="Secciones del caso">
          <ul>
            {navItems.map((h) => (
              <li><a href={`#s-${h.n}`}><span class="mono">{h.n}</span><span data-es={(h.nav ?? h).es} data-en={(h.nav ?? h).en}>{(h.nav ?? h).es}</span></a></li>
            ))}
          </ul>
        </nav>
      </>
    )}
    {/* HERO a sangre: la obra a todos los bordes, el título encima */}
    <header class="c-hero">
      <div class="c-hero-media">
        {K?.heroVideo
          ? <video class="c-hero-photo" src={link(`/${K.heroVideo.src}`)} poster={link(`/${K.heroVideo.poster}`)} autoplay muted loop playsinline preload="auto" aria-label={`${P.title} — portada`}></video>
          : (K?.heroImage ?? P.hero)
            ? <img class="c-hero-photo" src={link(`/${K?.heroImage ?? P.hero}`)} alt={`${P.title} — portada`} />
            : <span class="ph" data-label={`${P.title} — portada`}></span>}
      </div>
      <div class="c-hero-scrim" aria-hidden="true"></div>
      <div class="c-hero-cap wrap">
        <p class="c-hero-kick mono"><span data-es={P.disc.es} data-en={P.disc.en}>{P.disc.es}</span> · {P.year}</p>
        <h1 class="c-hero-title">{P.title}</h1>
      </div>
      <span class="c-hero-scroll" aria-hidden="true"></span>
    </header>

    <div class="wrap">
      <dl class="c-meta">
        <div>
          <dt><T es={K ? 'Contexto' : 'Cliente'} en={K ? 'Context' : 'Client'} /></dt>
          <dd>{K ? <span data-es={K.meta.context.es} data-en={K.meta.context.en}>{K.meta.context.es}</span> : P.title}</dd>
        </div>
        <div>
          <dt><T es="Servicios" en="Services" /></dt>
          <dd><span data-es={P.disc.es} data-en={P.disc.en}>{P.disc.es}</span></dd>
        </div>
        <div><dt><T es="Año" en="Year" /></dt><dd>{P.year}</dd></div>
        <div>
          <dt><T es="Rol" en="Role" /></dt>
          <dd>{K
            ? <span data-es={K.meta.role.es} data-en={K.meta.role.en}>{K.meta.role.es}</span>
            : <span data-es={C.role.es} data-en={C.role.en}>{C.role.es}</span>}</dd>
        </div>
        {K && (
          <div><dt><T es="Herramientas" en="Tools" /></dt><dd>{K.meta.tools}</dd></div>
        )}
      </dl>
    </div>

    {K ? (
      <div class="c-body wrap" style={K.theme ? `--lk-wine:${K.theme.wine};--lk-coral:${K.theme.coral};--lk-cream:${K.theme.cream};--lk-night:${K.theme.night}` : undefined}>
        <p class="c-intro rise"><span data-es={K.intro.es} data-en={K.intro.en}>{K.intro.es}</span></p>

        {blocks.map((b) => {
          switch (b.t) {
            case 'h': return (
              <h2 class="k-h rise" id={`s-${b.n}`}><span class="mono">{b.n}</span><span data-es={b.es} data-en={b.en}>{b.es}</span></h2>
            );
            case 'p': return <p class="k-p rise"><span data-es={b.es} data-en={b.en}>{b.es}</span></p>;
            case 'note': return <p class="k-note mono"><span data-es={b.es} data-en={b.en}>{b.es}</span></p>;
            case 'os': return (
              <div class="c-os k-os">
                {b.items.map((it) => (
                  <div class="os-box rise">
                    <h4><span data-es={it.label.es} data-en={it.label.en}>{it.label.es}</span></h4>
                    <p><span data-es={it.es} data-en={it.en}>{it.es}</span></p>
                  </div>
                ))}
              </div>
            );
            case 'list': return (
              <div class="k-list rise">
                <h3 class="k-sub"><span data-es={b.title.es} data-en={b.title.en}>{b.title.es}</span></h3>
                <ol>
                  {b.items.map((it, i) => (
                    <li><span class="mono">{pad(i + 1)}</span><span data-es={it.es} data-en={it.en}>{it.es}</span></li>
                  ))}
                </ol>
              </div>
            );
            case 'cols': return (
              <div class="k-cols">
                {b.items.map((it) => (
                  <div class="rise">
                    <h3 class="k-sub"><span data-es={it.title.es} data-en={it.title.en}>{it.title.es}</span></h3>
                    <p><span data-es={it.es} data-en={it.en}>{it.es}</span></p>
                  </div>
                ))}
              </div>
            );
            case 'stats': return (
              <div class="k-stats">
                {b.items.map((it, i) => (
                  <div class={`k-stat rise ${i === 1 ? 'alt' : ''}`}>
                    <span class="k-n">{it.n}</span>
                    <p class="k-sd"><span data-es={it.es} data-en={it.en}>{it.es}</span></p>
                    <div class="k-pair">
                      <span data-es={it.a.es} data-en={it.a.en}>{it.a.es}</span>
                      <i aria-hidden="true">+</i>
                      <span data-es={it.b.es} data-en={it.b.en}>{it.b.es}</span>
                    </div>
                  </div>
                ))}
              </div>
            );
            case 'finding': return (
              <div class="k-find">
                <div class="k-fbox found rise">
                  <span class="k-ftag mono" data-es={b.found.title.es} data-en={b.found.title.en}>{b.found.title.es}</span>
                  <span class="k-n">{b.found.n}</span>
                  <p><span data-es={b.found.es} data-en={b.found.en}>{b.found.es}</span></p>
                </div>
                <div class="k-fbox changed rise">
                  <span class="k-ftag mono" data-es={b.changed.title.es} data-en={b.changed.title.en}>{b.changed.title.es}</span>
                  <ul>
                    {b.changed.items.map((it) => (
                      <li>
                        <strong><span data-es={it.from.es} data-en={it.from.en}>{it.from.es}</span></strong>
                        <span class="arr" aria-hidden="true">→</span>
                        <span data-es={it.to.es} data-en={it.to.en}>{it.to.es}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            );
            case 'fig': return (
              <figure class={`c-figure k-fig ${b.w === 'narrow' ? 'narrow' : ''}`}>
                <div class="frame reveal">
                  <img class="revfill" src={link(`/${b.src}`)} alt={b.es} loading="lazy" decoding="async" />
                </div>
                <figcaption>
                  <span data-es={b.es} data-en={b.en}>{b.es}</span>
                  <span class="mono">FIG {pad(b.n)}</span>
                </figcaption>
              </figure>
            );
            case 'video': return (
              <figure class="c-figure k-fig">
                <div class="frame reveal">
                  <video class="revfill" src={link(`/${b.src}`)} autoplay muted loop playsinline preload="metadata" aria-label={b.es}></video>
                </div>
                <figcaption>
                  <span data-es={b.es} data-en={b.en}>{b.es}</span>
                  <span class="mono">FIG {pad(b.n)}</span>
                </figcaption>
              </figure>
            );
            case 'glance': return (
              <div class="k-glance rise">
                <span class="mono" data-es={b.label.es} data-en={b.label.en}>{b.label.es}</span>
                <ul>
                  {b.items.map((it) => (
                    <li><b>{it.n}</b><span data-es={it.es} data-en={it.en}>{it.es}</span></li>
                  ))}
                </ul>
              </div>
            );
            case 'personas': return (
              <div class="k-personas">
                {b.items.map((pe) => (
                  <article class={`k-pe rise ${pe.tone}`}>
                    <header>
                      <div class="k-arch" aria-hidden="true"><span>{pe.name.charAt(0)}</span></div>
                      <div>
                        <h4>{pe.name}</h4>
                        <p class="k-role"><span data-es={pe.role.es} data-en={pe.role.en}>{pe.role.es}</span></p>
                        <p class="k-pm mono"><span data-es={pe.meta.es} data-en={pe.meta.en}>{pe.meta.es}</span></p>
                      </div>
                    </header>
                    <dl>
                      <div><dt data-es={b.labels.why.es} data-en={b.labels.why.en}>{b.labels.why.es}</dt><dd><span data-es={pe.why.es} data-en={pe.why.en}>{pe.why.es}</span></dd></div>
                      <div><dt data-es={b.labels.motivation.es} data-en={b.labels.motivation.en}>{b.labels.motivation.es}</dt><dd><span data-es={pe.motivation.es} data-en={pe.motivation.en}>{pe.motivation.es}</span></dd></div>
                      <div><dt data-es={b.labels.frustration.es} data-en={b.labels.frustration.en}>{b.labels.frustration.es}</dt><dd><span data-es={pe.frustration.es} data-en={pe.frustration.en}>{pe.frustration.es}</span></dd></div>
                    </dl>
                  </article>
                ))}
              </div>
            );
            case 'features': return (
              <div class="k-feat">
                <div class="fl rise">
                  <h3 class="k-sub"><span data-es={b.title.es} data-en={b.title.en}>{b.title.es}</span></h3>
                  <ul>
                    {b.items.map((it) => <li><span data-es={it.es} data-en={it.en}>{it.es}</span></li>)}
                  </ul>
                </div>
                <div class="mvp rise">
                  <span class="k-ftag mono" data-es={b.mvpTitle.es} data-en={b.mvpTitle.en}>{b.mvpTitle.es}</span>
                  <ol>
                    {b.mvp.map((it, i) => <li><b class="mono">{pad(i + 1)}</b><span data-es={it.es} data-en={it.en}>{it.es}</span></li>)}
                  </ol>
                </div>
              </div>
            );
            case 'metrics': return (
              <figure class="c-figure k-fig lk-metrics">
                <div class="lk-panel">
                  <div class="lk-mscroll">
                    <div class="lk-mt">
                      <div class="lk-mh">
                        <span data-es={b.heads.task.es} data-en={b.heads.task.en}>{b.heads.task.es}</span>
                        <span data-es={b.heads.done.es} data-en={b.heads.done.en}>{b.heads.done.es}</span>
                        <span data-es={b.heads.time.es} data-en={b.heads.time.en}>{b.heads.time.es}</span>
                        <span data-es={b.heads.steps.es} data-en={b.heads.steps.en}>{b.heads.steps.es}</span>
                      </div>
                      {b.rows.map((r) => (
                        <div class={`lk-mr ${r.hot ? 'hot' : ''}`}>
                          <span class="lk-mtask"><span data-es={r.task.es} data-en={r.task.en}>{r.task.es}</span></span>
                          <span class="lk-dots" aria-label={`${r.done} / 5`}>
                            {[0, 1, 2, 3, 4].map((i) => <i class={r.done >= i + 1 ? 'full' : r.done >= i + 0.5 ? 'half' : ''}></i>)}
                          </span>
                          <span class="lk-mv">{r.time}</span>
                          <span class="lk-mv">{r.steps}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                  <p class="lk-mnote"><span data-es={b.note.es} data-en={b.note.en}>{b.note.es}</span></p>
                </div>
                <figcaption><span data-es={b.es} data-en={b.en}>{b.es}</span></figcaption>
              </figure>
            );
            case 'compare': return (
              <figure class="c-figure k-fig lk-compare">
                <div class="lk-cards" style={`--n:${b.items.length}`}>
                  {b.items.map((it) => (
                    <div class="lk-card rise">
                      <h4>{it.name}</h4>
                      {b.rows.map((r, ri) => (
                        <div class={`lk-cell ${ri === 1 ? 'weak' : ''}`}>
                          <span class="lk-lab" data-es={r.es} data-en={r.en}>{r.es}</span>
                          <p><span data-es={it.vals[ri].es} data-en={it.vals[ri].en}>{it.vals[ri].es}</span></p>
                        </div>
                      ))}
                    </div>
                  ))}
                </div>
                <figcaption><span data-es={b.es} data-en={b.en}>{b.es}</span></figcaption>
              </figure>
            );
            case 'sitemap': return (
              <figure class="c-figure k-fig lk-map k-wide">
                <div class="lk-panel lk-tree">
                  <div class="lk-troot"><span>{b.root}</span></div>
                  <div class="lk-tcols" style={`--n:${b.branches.length}`}>
                    {b.branches.map((br) => (
                      <div class="lk-col">
                        <div class="lk-nd head"><span data-es={br.title.es} data-en={br.title.en}>{br.title.es}</span></div>
                        {br.kids.length > 0 && <CaseTree nodes={br.kids} />}
                      </div>
                    ))}
                  </div>
                </div>
                <figcaption><span data-es={b.es} data-en={b.en}>{b.es}</span></figcaption>
              </figure>
            );
            case 'steps': return (
              <figure class="c-figure k-fig lk-steps">
                <ol class="lk-flow">
                  {b.items.map((it, i) => (
                    <li class="rise">
                      <div class="lk-sc">
                        <span class="lk-dia"><b class="mono">{i + 1}</b></span>
                        <span class="lk-step" data-es={it.es} data-en={it.en}>{it.es}</span>
                      </div>
                    </li>
                  ))}
                </ol>
                <figcaption><span data-es={b.es} data-en={b.en}>{b.es}</span></figcaption>
              </figure>
            );
            case 'fidelity': return (
              <figure class="c-figure k-fig lk-fid">
                <div class="lk-stages">
                  {b.items.map((it, i) => (
                    <div class="lk-stage rise">
                      <div class="lk-phone" data-kind={it.kind} aria-hidden="true">
                        <i class="notch"></i>
                        {it.kind === 'hi'
                          ? <img class="logo" src={link(`/${b.logo}`)} alt="" loading="lazy" decoding="async" />
                          : <i class="logo"></i>}
                        <i class="fld">{it.kind === 'hi' && <u>Usuario</u>}</i>
                        <i class="fld">{it.kind === 'hi' && <u>Contraseña</u>}</i>
                        <i class="btn">{it.kind === 'hi' && <u>Ingresar</u>}</i>
                        <i class="b2">{it.kind === 'hi' && <u>Ingresar con Google</u>}</i>
                        <i class="b2">{it.kind === 'hi' && <u>Registrarme</u>}</i>
                      </div>
                      <h4><span class="mono">{pad(i + 1)}</span> <span data-es={it.title.es} data-en={it.title.en}>{it.title.es}</span></h4>
                      <p><span data-es={it.text.es} data-en={it.text.en}>{it.text.es}</span></p>
                    </div>
                  ))}
                </div>
                <figcaption><span data-es={b.es} data-en={b.en}>{b.es}</span></figcaption>
              </figure>
            );
            case 'bars': return (
              <figure class="c-figure k-fig lk-bars">
                <div class="lk-panel">
                  <ul class="lk-legend">
                    {b.legend.map((l) => <li><i class={`t-${l.key}`}></i><span data-es={l.label.es} data-en={l.label.en}>{l.label.es}</span></li>)}
                  </ul>
                  {b.items.map((it) => (
                    <div class={`lk-row ${it.hot ? 'hot' : ''}`}>
                      <p class="lk-q"><span data-es={it.q.es} data-en={it.q.en}>{it.q.es}</span></p>
                      <div class="lk-bar">
                        {it.parts.map((pt) => <span class={`t-${pt.key}`} style={`width:${pt.pct}%`}>{pt.pct}%</span>)}
                      </div>
                    </div>
                  ))}
                </div>
                <figcaption><span data-es={b.es} data-en={b.en}>{b.es}</span></figcaption>
              </figure>
            );
            case 'brand': return (
              <figure class="c-figure k-fig lk-brand">
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" />
                <div class="lk-board">
                  <div class="lk-b logo rise">
                    <img src={link(`/${b.logo}`)} alt="Logo Lookap" loading="lazy" decoding="async" />
                    <span class="lk-tag" data-es={b.labels.logo.es} data-en={b.labels.logo.en}>{b.labels.logo.es}</span>
                  </div>
                  <div class="lk-b icon rise">
                    <img src={link(`/${b.icon}`)} alt="Ícono de la app" width="132" height="132" loading="lazy" decoding="async" />
                    <span class="lk-tag" data-es={b.labels.icon.es} data-en={b.labels.icon.en}>{b.labels.icon.es}</span>
                  </div>
                  <div class="lk-b palette rise">
                    {b.swatches.map((sw) => (
                      <div class={`lk-band tone-${sw.tone}`}><span class="lk-cn" data-es={sw.name.es} data-en={sw.name.en}>{sw.name.es}</span><code class="lk-hex">{sw.hex}</code></div>
                    ))}
                    <span class="lk-tag" data-es={b.labels.palette.es} data-en={b.labels.palette.en}>{b.labels.palette.es}</span>
                  </div>
                  <div class="lk-b type rise">
                    <p class="lk-aa">Aa</p>
                    <p class="lk-fname">{b.font.name}</p>
                    <ul class="lk-specs">
                      {b.font.specs.map((sp) => (
                        <li style={`font-size:${sp.size}px;font-weight:${sp.weight}`}><span data-es={sp.es} data-en={sp.en}>{sp.es}</span> <em>{sp.size} pt</em></li>
                      ))}
                    </ul>
                    <span class="lk-tag" data-es={b.labels.type.es} data-en={b.labels.type.en}>{b.labels.type.es}</span>
                  </div>
                </div>
                <figcaption><span data-es={b.es} data-en={b.en}>{b.es}</span></figcaption>
              </figure>
            );
            case 'gallery': return (
              <figure class="c-figure k-fig k-gallery">
                <div class="k-gal-grid">
                  {b.items.map((it) => (
                    <div class="frame reveal">
                      <img class="revfill" src={link(`/${it.src}`)} alt={it.alt} loading="lazy" decoding="async" />
                    </div>
                  ))}
                </div>
                <figcaption>
                  <span data-es={b.es} data-en={b.en}>{b.es}</span>
                  <span class="mono">FIG {pad(b.n)}</span>
                </figcaption>
              </figure>
            );
            case 'split': return (
              <div class="k-split">
                <div class="frame reveal">
                  <img class="revfill" src={link(`/${b.src}`)} alt={b.alt} loading="lazy" decoding="async" />
                </div>
                <p class="rise"><span data-es={b.es} data-en={b.en}>{b.es}</span></p>
              </div>
            );
            case 'break': return (
              <div class={`k-break ${b.w === 'narrow' ? 'narrow' : ''}`}>
                <div class="frame reveal">
                  {b.kind === 'video'
                    ? <video class="revfill" src={link(`/${b.src}`)} autoplay muted loop playsinline preload="metadata" aria-label={b.alt}></video>
                    : <img class="revfill" src={link(`/${b.src}`)} alt={b.alt} loading="lazy" decoding="async" />}
                </div>
              </div>
            );
            case 'links': return (
              <div class="k-links">
                {b.items.map((it) => (
                  <a href={it.href} target="_blank" rel="noopener noreferrer">
                    <span data-es={it.es} data-en={it.en}>{it.es}</span> <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            );
          }
        })}
      </div>
    ) : (
    <div class="c-body wrap">
        <p class="c-intro rise"><span data-es={C.intro.es} data-en={C.intro.en}>{C.intro.es}</span></p>
  
        <div class="c-os">
          <div class="os-box objetivo rise">
            <h4><span data-es={C.objetivo.label.es} data-en={C.objetivo.label.en}>{C.objetivo.label.es}</span></h4>
            <p><span data-es={C.objetivo.es} data-en={C.objetivo.en}>{C.objetivo.es}</span></p>
          </div>
          <div class="os-box solucion rise">
            <h4><span data-es={C.solucion.label.es} data-en={C.solucion.label.en}>{C.solucion.label.es}</span></h4>
            <p><span data-es={C.solucion.es} data-en={C.solucion.en}>{C.solucion.es}</span></p>
          </div>
        </div>
  
        {C.sections.map((s, i) => (
          <figure class={`c-figure ${i === 1 ? 'tall' : ''}`}>
            <div class="frame reveal"><span class="ph revfill" data-label={s.es}></span></div>
            <figcaption>
              <span data-es={s.es} data-en={s.en}>{s.es}</span>
              <span class="mono">FIG {String(i + 1).padStart(2, '0')}</span>
            </figcaption>
          </figure>
        ))}
  
        <blockquote class="c-quote rise">
          <span data-es={`“${C.quote.es}”`} data-en={`“${C.quote.en}”`}>“{C.quote.es}”</span>
        </blockquote>
      </div>
    )}

    <div class="wrap">
      <div class="c-next">
        <span class="lab"><T es="Siguiente proyecto" en="Next project" /></span>
        <a href={link(`/trabajos/${NEXT.id}`)}>{NEXT.title} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </article>

  {K && (
    <script is:inline>
      (function () {
        var nav = document.querySelector('.k-nav');
        if (!nav) return;
        var hero = document.querySelector('.c-hero');
        var bar = document.querySelector('.k-progress i');
        var links = Array.prototype.slice.call(nav.querySelectorAll('a'));
        var secs = links.map(function (a) { return document.querySelector(a.getAttribute('href')); });
        function onScroll() {
          var y = window.scrollY, max = document.documentElement.scrollHeight - window.innerHeight;
          if (bar) bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, y / max) : 0) + ')';
          nav.classList.toggle('show', y > (hero ? hero.offsetHeight - 90 : 400));
          var cur = -1;
          secs.forEach(function (s, i) { if (s && s.getBoundingClientRect().top < window.innerHeight * 0.4) cur = i; });
          links.forEach(function (a, i) { a.classList.toggle('on', i === cur); });
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>
  )}

  <SiteFooter />
</Base>

