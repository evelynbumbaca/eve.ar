---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import T from '../components/T.astro';

const services = [
  { es: 'Identidad de marca', en: 'Brand identity' },
  { es: 'Diseño UX/UI', en: 'UX/UI design' },
  { es: 'Editorial', en: 'Editorial' },
  { es: 'Packaging', en: 'Packaging' },
  { es: 'Dirección de arte', en: 'Art direction' },
  { es: 'Diseño web', en: 'Web design' },
];
const tools = ['Figma', 'Illustrator', 'Photoshop', 'InDesign', 'After Effects', 'Webflow', 'Blender'];
---

<Base title="Sobre mí — EVE" description="Sobre Eve: diseñadora multimedia y UX/UI. Enfoque, servicios y herramientas.">
  <article class="page estudio">
    <div class="wrap">
      <header class="page-head">
        <span class="kicker mono cap"><T es="Sobre mí" en="About me" /></span>
        <h1 class="page-title reveal">
          <span class="revfill"><T es="Diseño con intención," en="Design with intent," /></span>
        </h1>
        <h1 class="page-title reveal">
          <span class="revfill accent"><T es="no decoración." en="not decoration." /></span>
        </h1>
      </header>

      <div class="estudio-grid">
        <div class="portrait reveal">
          <span class="ph revfill" data-label="retrato — 4:5"></span>
        </div>
        <div class="bio">
          <p class="lead rise">
            <T
              es="Soy Eve, diseñadora multimedia y UX/UI radicada en Buenos Aires. Trabajo en la intersección entre lo editorial, la identidad de marca y el producto digital."
              en="I'm Eve, a multimedia and UX/UI designer based in Buenos Aires. I work at the intersection of editorial, brand identity and digital product."
            />
          </p>
          <p class="rise rise-delay-1">
            <T
              es="Me interesa el diseño que ordena: tomar lo disperso y volverlo legible, memorable y útil. Combino criterio editorial, sensibilidad tipográfica y pensamiento de producto para que cada proyecto tenga una narrativa clara y un sistema que lo sostenga."
              en="I care about design that brings order: taking the scattered and making it legible, memorable and useful. I combine editorial judgment, typographic sensibility and product thinking so every project has a clear narrative and a system to hold it together."
            />
          </p>
        </div>
      </div>

      <section class="cols">
        <div class="col rise">
          <h2 class="col-h mono cap"><T es="Servicios" en="Services" /></h2>
          <ul class="list">
            {services.map((s) => (
              <li><span data-es={s.es} data-en={s.en}>{s.es}</span></li>
            ))}
          </ul>
        </div>
        <div class="col rise rise-delay-1">
          <h2 class="col-h mono cap"><T es="Herramientas" en="Tools" /></h2>
          <ul class="list">
            {tools.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="col rise rise-delay-2">
          <h2 class="col-h mono cap"><T es="Enfoque" en="Approach" /></h2>
          <p class="approach">
            <T
              es="Escuchar, ordenar, prototipar y refinar. Cada decisión visual responde a un porqué — y se prueba hasta que funciona."
              en="Listen, order, prototype and refine. Every visual decision answers a why — and gets tested until it works."
            />
          </p>
        </div>
      </section>
    </div>
  </article>

  <SiteFooter />
</Base>

<style>
  .page { padding-top: clamp(120px, 18vh, 200px); }
  .page-head { margin-bottom: clamp(48px, 8vh, 110px); }
  .kicker { display: block; color: var(--ink-60); margin-bottom: clamp(20px, 3vh, 34px); }
  .page-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--fs-h1);
    line-height: 1.0;
    letter-spacing: -0.02em;
  }
  .page-title .accent { font-style: italic; font-weight: 300; color: var(--ink-80); }
  .page-title .revfill { display: block; }

  .estudio-grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) 1.2fr;
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
    margin-bottom: var(--section);
  }
  .portrait { width: 100%; aspect-ratio: 4 / 5; border-radius: 2px; }
  .portrait .ph { width: 100%; height: 100%; }
  .bio .lead {
    font-family: var(--serif);
    font-weight: 300;
    font-size: var(--fs-lead);
    line-height: 1.34;
    letter-spacing: -0.01em;
    margin-bottom: 1.2em;
  }
  .bio p { max-width: 52ch; color: var(--ink-80); }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(28px, 4vw, 64px);
    border-top: 1px solid var(--line);
    padding-top: clamp(28px, 4vh, 48px);
  }
  .col-h { color: var(--ink-60); margin-bottom: 18px; }
  .list { list-style: none; display: grid; gap: 9px; }
  .list li {
    font-family: var(--serif);
    font-size: clamp(1.05rem, 1.3vw, 1.3rem);
    padding-bottom: 9px;
    border-bottom: 1px solid var(--ink-12);
  }
  .approach { color: var(--ink-80); line-height: 1.55; }

  @media (max-width: 820px) {
    .estudio-grid { grid-template-columns: 1fr; }
    .portrait { max-width: 320px; }
    .cols { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
