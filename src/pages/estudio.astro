---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import T from '../components/T.astro';

/* Qué hago (capacidades) — motion primero */
const capabilities = [
  { es: 'Motion & animación', en: 'Motion & animation' },
  { es: 'Contenido audiovisual & e-learning', en: 'Audiovisual content & e-learning' },
  { es: 'Identidad de marca', en: 'Brand identity' },
  { es: 'Dirección creativa', en: 'Creative direction' },
  { es: 'Diseño UX/UI & producto', en: 'UX/UI & product design' },
  { es: 'Editorial & diseño de información', en: 'Editorial & information design' },
  { es: 'Diseño web', en: 'Web design' },
  { es: 'Realidad aumentada', en: 'Augmented reality' },
];

/* Herramientas agrupadas (del CV, ampliadas) */
const toolGroups = [
  { label: { es: 'Motion & Video', en: 'Motion & Video' }, items: ['After Effects', 'Premiere', 'Animate', 'CapCut', 'Audition'] },
  { label: { es: 'Diseño', en: 'Design' }, items: ['Illustrator', 'Photoshop', 'InDesign', 'Lightroom'] },
  { label: { es: 'UX/UI & Web', en: 'UX/UI & Web' }, items: ['Figma', 'Adobe XD', 'Spark AR'] },
  { label: { es: 'IA', en: 'AI' }, items: ['Midjourney', 'Runway', 'ChatGPT', 'DALL·E'] },
];
---

<Base title="Sobre mí — EVE" description="Diseñadora multimedia y UX/UI especializada en motion. Qué hago, herramientas y enfoque.">
  <article class="page estudio">
    <div class="wrap">
      <h1 class="visually-hidden">Sobre mí — Eve · Diseñadora Multimedia & UX/UI</h1>

      <div class="estudio-grid">
        <div class="portrait reveal">
          <span class="ph revfill" data-label="retrato — 4:5"></span>
        </div>
        <div class="bio">
          <p class="lead rise">
            <T
              es="Diseño identidades y contenido que se mueve — literalmente. Uno la dirección de marca, el criterio editorial y el pensamiento de producto con una especialización fuerte en motion: hago que una identidad no solo se vea bien, sino que cobre vida."
              en="I design identities and content that move — literally. I bring together brand direction, editorial judgment and product thinking with a strong focus on motion: making an identity not just look good, but come alive."
            />
          </p>
          <p class="rise rise-delay-1">
            <T
              es="Me interesa el diseño que ordena: tomar lo disperso y volverlo legible, memorable y útil. Cada decisión —color, tipografía, ritmo, movimiento— responde a un porqué estratégico, y se prueba hasta que funciona. Más de 7 años diseñando entre lo institucional, lo privado y proyectos propios."
              en="I care about design that brings order: taking the scattered and making it legible, memorable and useful. Every decision — color, type, rhythm, motion — answers a strategic why, and gets tested until it works. 7+ years of design across institutional, private and independent work."
            />
          </p>
        </div>
      </div>

      <section class="spec" aria-label="Especialidad: motion">
        <div class="spec-head rise">
          <span class="spec-kicker mono cap"><T es="Especialidad" en="Specialty" /></span>
          <h2 class="spec-title"><T es="Motion & contenido audiovisual" en="Motion & audiovisual content" /></h2>
        </div>
        <div class="spec-body rise rise-delay-1">
          <p class="spec-lead">
            <T
              es="Animo logos y sistemas de marca, y produzco contenido audiovisual de principio a fin: motion graphics, edición y postproducción, y sistemas de plantillas reutilizables que estandarizan y agilizan la producción de video."
              en="I animate logos and brand systems, and produce audiovisual content end to end: motion graphics, editing and post-production, and reusable template systems that standardize and speed up video production."
            />
          </p>
          <p class="spec-lead">
            <T
              es="Con un foco fuerte en contenido para e-learning y capacitación: traduzco información compleja —protocolos, manuales, procesos— en piezas visuales claras, didácticas y en movimiento."
              en="With a strong focus on e-learning and training content: I turn complex information — protocols, manuals, processes — into clear, didactic pieces that move."
            />
          </p>
          <p class="spec-tags mono">
            <T
              es="Animación de logos · Motion graphics · Edición & postproducción · Plantillas reutilizables · Contenido para e-learning · Diseño de información"
              en="Logo animation · Motion graphics · Editing & post · Reusable templates · E-learning content · Information design"
            />
          </p>
        </div>
      </section>

      <section class="also" aria-label="Marca, editorial y producto">
        <div class="spec-head rise">
          <span class="spec-kicker mono cap"><T es="Además" en="Also" /></span>
          <h2 class="spec-title"><T es="Marca, editorial & producto" en="Brand, editorial & product" /></h2>
        </div>
        <div class="spec-body rise rise-delay-1">
          <p class="spec-lead">
            <T
              es="Construyo identidades de marca completas, del concepto al sistema, y las llevo a la práctica: editorial, packaging, papelería y contenido para redes. Diseño y testeo experiencias digitales — prototipos, wireframes y flujos de usuario."
              en="I build complete brand identities, from concept to system, and take them into practice: editorial, packaging, stationery and social content. I design and test digital experiences — prototypes, wireframes and user flows."
            />
          </p>
          <p class="spec-lead">
            <T
              es="En editorial participé en el diseño del libro «¿Sabés quién fue?». Sumo también dirección de arte para campañas y realidad aumentada para redes — siempre buscando que la información se entienda y la marca se sostenga."
              en="In editorial, I took part in the design of the book «¿Sabés quién fue?». I also do art direction for campaigns and augmented reality for social — always making the information clear and the brand hold together."
            />
          </p>
          <p class="spec-tags mono neutral">
            <T
              es="Identidad & sistemas de marca · Editorial & libros · Packaging · UX/UI & prototipado · Contenido & redes · Realidad aumentada"
              en="Identity & brand systems · Editorial & books · Packaging · UX/UI & prototyping · Content & social · Augmented reality"
            />
          </p>
        </div>
      </section>

      <section class="cols">
        <div class="col rise">
          <h2 class="col-h mono cap"><T es="Qué hago" en="What I do" /></h2>
          <ul class="list">
            {capabilities.map((s) => (
              <li><span data-es={s.es} data-en={s.en}>{s.es}</span></li>
            ))}
          </ul>
        </div>
        <div class="col rise rise-delay-1">
          <h2 class="col-h mono cap"><T es="Herramientas" en="Tools" /></h2>
          <div class="tools">
            {toolGroups.map((g) => (
              <div class="tool-group">
                <span class="tool-label mono"><span data-es={g.label.es} data-en={g.label.en}>{g.label.es}</span></span>
                <span class="tool-items">{g.items.join(' · ')}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="col rise rise-delay-2">
          <h2 class="col-h mono cap"><T es="Enfoque" en="Approach" /></h2>
          <p class="approach">
            <T
              es="Escuchar, ordenar, prototipar y refinar. Pensamiento estratégico, curaduría estética y atención al detalle — para que cada proyecto tenga una narrativa clara y un sistema que lo sostenga."
              en="Listen, order, prototype and refine. Strategic thinking, aesthetic curation and attention to detail — so every project has a clear narrative and a system to hold it together."
            />
          </p>
        </div>
      </section>
    </div>
  </article>

  <SiteFooter />
</Base>

<style>
  .page { padding-top: clamp(110px, 16vh, 170px); }

  .estudio-grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) 1.2fr;
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
    margin-bottom: var(--section);
  }
  .portrait { width: 100%; aspect-ratio: 4 / 5; border-radius: 2px; }
  .portrait .ph { width: 100%; height: 100%; }
  .bio .lead {
    font-family: var(--serif);
    font-weight: 300;
    font-size: var(--fs-lead);
    line-height: 1.34;
    letter-spacing: -0.01em;
    margin-bottom: 1.2em;
  }
  .bio p { max-width: 52ch; color: var(--ink-80); }

  /* ---------- especialidad: motion (destacado) + marca/editorial ---------- */
  .spec, .also {
    display: grid;
    grid-template-columns: minmax(200px, 0.34fr) 1fr;
    gap: clamp(24px, 4vw, 72px);
    border-top: 1px solid var(--line);
    padding-top: clamp(28px, 4vh, 52px);
    margin-bottom: var(--section);
  }
  /* la segunda banda de tags es neutra: motion es el único destacado en naranja */
  .spec-tags.neutral { color: var(--ink-45); }
  .spec-kicker { color: var(--ink-45); display: block; margin-bottom: 14px; }
  .spec-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.4vw, 2.9rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .spec-lead {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 46ch;
  }
  .spec-lead + .spec-lead { margin-top: clamp(14px, 2vh, 22px); color: var(--ink-80); }
  .spec-tags {
    margin-top: clamp(20px, 3vh, 30px);
    color: var(--orange);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 2;
  }

  /* ---------- columnas ---------- */
  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(28px, 4vw, 64px);
    border-top: 1px solid var(--line);
    padding-top: clamp(28px, 4vh, 48px);
  }
  .col-h { color: var(--ink-60); margin-bottom: 18px; }
  .list { list-style: none; display: grid; gap: 9px; }
  .list li {
    font-family: var(--serif);
    font-size: clamp(1.05rem, 1.3vw, 1.3rem);
    padding-bottom: 9px;
    border-bottom: 1px solid var(--ink-12);
  }
  .approach { color: var(--ink-80); line-height: 1.55; }

  .tools { display: grid; gap: 16px; }
  .tool-group { display: grid; gap: 5px; padding-bottom: 12px; border-bottom: 1px solid var(--ink-12); }
  .tool-label { color: var(--ink-45); font-size: 10px !important; letter-spacing: 0.1em; text-transform: uppercase; }
  .tool-items {
    font-family: var(--serif);
    font-size: clamp(1rem, 1.2vw, 1.2rem);
    line-height: 1.35;
    color: var(--ink);
  }

  @media (max-width: 820px) {
    .estudio-grid { grid-template-columns: 1fr; }
    .portrait { max-width: 320px; }
    .spec, .also { grid-template-columns: 1fr; gap: 16px; }
    .cols { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
