---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import T from '../components/T.astro';

/* Herramientas agrupadas (del CV, actualizadas) */
const toolGroups = [
  { label: { es: 'Motion & Video', en: 'Motion & Video' }, items: ['After Effects', 'Premiere', 'Animate', 'Audition'] },
  { label: { es: 'Diseño', en: 'Design' }, items: ['Illustrator', 'Photoshop', 'InDesign', 'Lightroom'] },
  { label: { es: 'UX/UI & Web', en: 'UX/UI & Web' }, items: ['Figma', 'Adobe XD'] },
  { label: { es: 'IA', en: 'AI' }, items: ['ChatGPT', 'Claude', 'Gemini'], note: { es: 'En actualización constante ante nuevas herramientas', en: 'Continuously updated as new tools emerge' } },
];
---

<Base title="Sobre mí — EVE" description="Diseñadora multimedia y UX/UI especializada en motion. Marca, producto digital y contenido audiovisual.">
  <article class="page estudio">
    <div class="wrap">
      <h1 class="visually-hidden">Sobre mí — Eve · Diseñadora Multimedia & UX/UI</h1>

      <div class="estudio-grid">
        <div class="portrait reveal">
          <span class="ph revfill" data-label="retrato — 4:5"></span>
        </div>
        <div class="bio">
          <p class="lead rise">
            <T
              es="Diseño identidades y contenido que se mueve — literalmente. Uno la dirección de marca, el criterio editorial y el pensamiento de producto con una especialización fuerte en motion: hago que una identidad no solo se vea bien, sino que cobre vida."
              en="I design identities and content that move — literally. I bring together brand direction, editorial judgment and product thinking with a strong focus on motion: making an identity not just look good, but come alive."
            />
          </p>
          <p class="rise rise-delay-1">
            <T
              es="Me interesa el diseño que ordena: tomar lo disperso y volverlo legible, memorable y útil. Cada decisión —color, tipografía, ritmo, movimiento— responde a un porqué estratégico, y se prueba hasta que funciona. Más de 7 años diseñando entre lo institucional, lo privado y proyectos propios."
              en="I care about design that brings order: taking the scattered and making it legible, memorable and useful. Every decision — color, type, rhythm, motion — answers a strategic why, and gets tested until it works. 7+ years of design across institutional, private and independent work."
            />
          </p>
        </div>
      </div>

      {/* ---- Motion (especialidad) ---- */}
      <section class="disc" aria-label="Motion">
        <h2 class="disc-title rise"><T es="Motion & contenido audiovisual" en="Motion & audiovisual content" /></h2>
        <div class="disc-body rise rise-delay-1">
          <p class="disc-lead">
            <T
              es="Animo logos y sistemas de marca, y produzco contenido audiovisual de principio a fin: motion graphics, edición y postproducción, y sistemas de plantillas reutilizables que estandarizan y agilizan la producción de video."
              en="I animate logos and brand systems, and produce audiovisual content end to end: motion graphics, editing and post-production, and reusable template systems that standardize and speed up video production."
            />
          </p>
          <p class="disc-lead">
            <T
              es="Cada identidad que diseño nace pensada para moverse: animaciones, piezas para redes e intros que le dan ritmo y presencia a la marca en pantalla."
              en="Every identity I design is born to move: animations, social pieces and intros that give a brand rhythm and presence on screen."
            />
          </p>
          <p class="disc-tags accent mono">
            <T
              es="Animación de logos · Motion graphics · Edición & postproducción · Plantillas reutilizables · Contenido para redes · Intros & videos"
              en="Logo animation · Motion graphics · Editing & post · Reusable templates · Social content · Intros & video"
            />
          </p>
        </div>
      </section>

      {/* ---- Marca / branding ---- */}
      <section class="disc" aria-label="Identidad de marca">
        <h2 class="disc-title rise"><T es="Identidad de marca" en="Brand identity" /></h2>
        <div class="disc-body rise rise-delay-1">
          <p class="disc-lead">
            <T
              es="Construyo identidades completas, del concepto al sistema: logo, paleta, tipografía y un lenguaje visual coherente en cada punto de contacto. Después las llevo a la práctica — editorial, packaging, papelería, dirección de arte, campañas y key visuals — para que la marca se sostenga en el mundo real."
              en="I build complete identities, from concept to system: logo, palette, type and a visual language that stays coherent at every touchpoint. Then I take them into practice — editorial, packaging, stationery, art direction, campaigns and key visuals — so the brand holds together in the real world."
            />
          </p>
          <p class="disc-lead">
            <T
              es="Co-creación del libro «¿Sabés quién fue?»."
              en="Co-creation of the book «¿Sabés quién fue?»."
            />
          </p>
          <p class="disc-tags mono">
            <T
              es="Estrategia & concepto · Sistemas de marca · Editorial & libros · Packaging & papelería · Dirección de arte · Campañas & key visuals"
              en="Strategy & concept · Brand systems · Editorial & books · Packaging & stationery · Art direction · Campaigns & key visuals"
            />
          </p>
        </div>
      </section>

      {/* ---- UX/UI & producto ---- */}
      <section class="disc" aria-label="Diseño UX/UI y producto">
        <h2 class="disc-title rise"><T es="Diseño UX/UI & producto" en="UX/UI & product design" /></h2>
        <div class="disc-body rise rise-delay-1">
          <p class="disc-lead">
            <T
              es="Diseño y prototipo productos digitales de punta a punta. Formé parte del prototipado de la nueva web de un organismo público de alcance nacional, y de equipos de UX enfocados en mejorar el recorrido del usuario."
              en="I design and prototype digital products end to end. I was part of the prototyping of the new website for a national public organization, and of UX teams focused on improving the user journey."
            />
          </p>
          <p class="disc-lead">
            <T
              es="Arquitectura de información, flujos, wireframes y UX writing — con un objetivo claro: que el producto final funcione mejor para quien lo usa."
              en="Information architecture, flows, wireframes and UX writing — with one clear goal: a final product that works better for the people who use it."
            />
          </p>
          <p class="disc-tags mono">
            <T
              es="Research · Wireframes & prototipos · Flujos de usuario · UX writing · Figma & Adobe XD · Diseño responsivo"
              en="Research · Wireframes & prototypes · User flows · UX writing · Figma & Adobe XD · Responsive design"
            />
          </p>
        </div>
      </section>

      {/* ---- herramientas + enfoque ---- */}
      <section class="cols">
        <div class="col rise">
          <h2 class="col-h mono cap"><T es="Herramientas" en="Tools" /></h2>
          <div class="tools">
            {toolGroups.map((g) => (
              <div class="tool-group">
                <span class="tool-label mono"><span data-es={g.label.es} data-en={g.label.en}>{g.label.es}</span></span>
                <span class="tool-items">{g.items.join(' · ')}</span>
                {g.note && <span class="tool-note mono"><span data-es={g.note.es} data-en={g.note.en}>{g.note.es}</span></span>}
              </div>
            ))}
          </div>
        </div>
        <div class="col rise rise-delay-1">
          <h2 class="col-h mono cap"><T es="Enfoque" en="Approach" /></h2>
          <p class="approach">
            <T
              es="Escuchar, ordenar, prototipar y refinar. Pensamiento estratégico, curaduría estética y atención al detalle — para que cada proyecto tenga una narrativa clara y un sistema que lo sostenga."
              en="Listen, order, prototype and refine. Strategic thinking, aesthetic curation and attention to detail — so every project has a clear narrative and a system to hold it together."
            />
          </p>
        </div>
      </section>
    </div>
  </article>

  <SiteFooter />
</Base>

<style>
  .page { padding-top: clamp(110px, 16vh, 170px); }

  .estudio-grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) 1.2fr;
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
    margin-bottom: var(--section);
  }
  .portrait { width: 100%; aspect-ratio: 4 / 5; border-radius: 2px; }
  .portrait .ph { width: 100%; height: 100%; }
  .bio .lead {
    font-family: var(--serif);
    font-weight: 300;
    font-size: var(--fs-lead);
    line-height: 1.34;
    letter-spacing: -0.01em;
    margin-bottom: 1.2em;
  }
  .bio p { max-width: 52ch; color: var(--ink-80); }

  /* ---------- bloques de disciplina (título izq · desarrollo der) ---------- */
  .disc {
    display: grid;
    grid-template-columns: minmax(200px, 0.34fr) 1fr;
    gap: clamp(24px, 4vw, 72px);
    border-top: 1px solid var(--line);
    padding-top: clamp(28px, 4vh, 52px);
    margin-bottom: clamp(48px, 8vh, 110px);
  }
  .disc-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.4vw, 2.9rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .disc-lead {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 48ch;
  }
  .disc-lead + .disc-lead { margin-top: clamp(14px, 2vh, 22px); color: var(--ink-80); }
  .disc-tags {
    margin-top: clamp(20px, 3vh, 30px);
    color: var(--ink-45);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 2;
  }
  .disc-tags.accent { color: var(--orange); } /* motion = único destacado */

  /* ---------- herramientas + enfoque ---------- */
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 80px);
    border-top: 1px solid var(--line);
    padding-top: clamp(28px, 4vh, 48px);
  }
  .col-h { color: var(--ink-60); margin-bottom: 18px; }
  .approach { color: var(--ink-80); line-height: 1.55; max-width: 46ch; }

  .tools { display: grid; gap: 16px; }
  .tool-group { display: grid; gap: 5px; padding-bottom: 12px; border-bottom: 1px solid var(--ink-12); }
  .tool-label { color: var(--ink-45); font-size: 10px !important; letter-spacing: 0.1em; text-transform: uppercase; }
  .tool-items {
    font-family: var(--serif);
    font-size: clamp(1rem, 1.2vw, 1.2rem);
    line-height: 1.35;
    color: var(--ink);
  }
  .tool-note { display: block; margin-top: 5px; color: var(--ink-45); font-size: 11px !important; letter-spacing: 0.02em; }

  @media (max-width: 820px) {
    .estudio-grid { grid-template-columns: 1fr; }
    .portrait { max-width: 320px; }
    .disc { grid-template-columns: 1fr; gap: 16px; }
    .cols { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
