---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import T from '../components/T.astro';

const services = [
  { es: 'Identidad de marca', en: 'Brand identity' },
  { es: 'Motion & animación', en: 'Motion & animation' },
  { es: 'Diseño UX/UI', en: 'UX/UI design' },
  { es: 'Editorial', en: 'Editorial' },
  { es: 'Packaging', en: 'Packaging' },
  { es: 'Dirección de arte', en: 'Art direction' },
  { es: 'Diseño web', en: 'Web design' },
];
const tools = ['After Effects', 'Premiere Pro', 'Illustrator', 'Photoshop', 'InDesign', 'Figma', 'Herramientas de IA'];

/* experiencia laboral (resumen aprobado por Eve) */
const jobs = [
  {
    where: 'Coto',
    when: { es: 'Actualidad', en: 'Present' },
    role: { es: 'Diseñadora multimedia — Contenido audiovisual & e-learning', en: 'Multimedia designer — Audiovisual content & e-learning' },
    desc: {
      es: 'Encargada del contenido audiovisual y las plantillas en movimiento del sector: diseño corporativo interno, recursos visuales para plataformas de capacitación, edición y animación de videos instructivos, y diseño de información — protocolos, normas y manuales técnicos traducidos a piezas visuales didácticas. Desarrollo de sistemas de plantillas y MOGRTs para estandarizar el video de la empresa, automatización de flujos con expresiones y resolución técnica de procesos de animación.',
      en: 'In charge of the area’s audiovisual content and motion templates: internal corporate design, visual resources for training platforms, editing and animation of instructional video, and information design — protocols, standards and technical manuals turned into didactic visual pieces. Template systems and MOGRTs to standardize company video, workflow automation with expressions, and technical troubleshooting across animation processes.',
    },
  },
  {
    where: 'NIC Argentina',
    when: { es: 'Rol anterior', en: 'Previous role' },
    role: { es: 'Diseño y comunicación visual', en: 'Design & visual communication' },
    desc: {
      es: 'Diseño de piezas gráficas y comunicación visual para el organismo que administra los dominios .ar.',
      en: 'Graphic pieces and visual communication for the organization that manages .ar domains.',
    },
  },
  {
    where: 'Freelance',
    when: { es: '7+ años', en: '7+ years' },
    role: { es: 'Identidad visual & motion', en: 'Visual identity & motion' },
    desc: {
      es: 'Identidades, dirección creativa y animación para emprendedores, marcas personales y PyMEs.',
      en: 'Identities, creative direction and animation for founders, personal brands and SMEs.',
    },
  },
];
---

<Base title="Sobre mí — EVE" description="Sobre Eve: diseñadora multimedia y UX/UI. Enfoque, servicios y herramientas.">
  <article class="page estudio">
    <div class="wrap">
      <h1 class="visually-hidden">Sobre mí — Eve · Diseñadora Multimedia & UX/UI</h1>

      <div class="estudio-grid">
        <div class="portrait reveal">
          <span class="ph revfill" data-label="retrato — 4:5"></span>
        </div>
        <div class="bio">
          <p class="lead rise">
            <T
              es="Soy Eve, diseñadora multimedia y UX/UI radicada en Buenos Aires, especializada en motion. Trabajo en la intersección entre la identidad de marca, lo editorial, el producto digital y el movimiento."
              en="I'm Eve, a multimedia and UX/UI designer based in Buenos Aires, specialized in motion. I work at the intersection of brand identity, editorial, digital product and motion."
            />
          </p>
          <p class="rise rise-delay-1">
            <T
              es="Me interesa el diseño que ordena: tomar lo disperso y volverlo legible, memorable y útil. Combino criterio editorial, sensibilidad tipográfica y pensamiento de producto para que cada proyecto tenga una narrativa clara y un sistema que lo sostenga."
              en="I care about design that brings order: taking the scattered and making it legible, memorable and useful. I combine editorial judgment, typographic sensibility and product thinking so every project has a clear narrative and a system to hold it together."
            />
          </p>
        </div>
      </div>

      <section class="exp" aria-label="Experiencia">
        <h2 class="exp-h mono cap rise"><T es="Experiencia" en="Experience" /></h2>
        {jobs.map((j, i) => (
          <article class:list={['exp-row', 'rise', `rise-delay-${Math.min(i + 1, 3)}`]}>
            <div class="exp-meta">
              <span class="exp-where">{j.where}</span>
              <span class="exp-when mono"><span data-es={j.when.es} data-en={j.when.en}>{j.when.es}</span></span>
            </div>
            <div class="exp-body">
              <h3 class="exp-role"><span data-es={j.role.es} data-en={j.role.en}>{j.role.es}</span></h3>
              <p class="exp-desc"><span data-es={j.desc.es} data-en={j.desc.en}>{j.desc.es}</span></p>
            </div>
          </article>
        ))}
        <p class="exp-skills mono rise">
          <T
            es="Motion graphics · Edición de video · Plantillas & MOGRTs · Automatización de flujos · Diseño de información · Troubleshooting técnico"
            en="Motion graphics · Video editing · Templates & MOGRTs · Workflow automation · Information design · Technical troubleshooting"
          />
        </p>
      </section>

      <section class="cols">
        <div class="col rise">
          <h2 class="col-h mono cap"><T es="Servicios" en="Services" /></h2>
          <ul class="list">
            {services.map((s) => (
              <li><span data-es={s.es} data-en={s.en}>{s.es}</span></li>
            ))}
          </ul>
        </div>
        <div class="col rise rise-delay-1">
          <h2 class="col-h mono cap"><T es="Herramientas" en="Tools" /></h2>
          <ul class="list">
            {tools.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="col rise rise-delay-2">
          <h2 class="col-h mono cap"><T es="Enfoque" en="Approach" /></h2>
          <p class="approach">
            <T
              es="Escuchar, ordenar, prototipar y refinar. Cada decisión visual responde a un porqué — y se prueba hasta que funciona."
              en="Listen, order, prototype and refine. Every visual decision answers a why — and gets tested until it works."
            />
          </p>
        </div>
      </section>
    </div>
  </article>

  <SiteFooter />
</Base>

<style>
  .page { padding-top: clamp(110px, 16vh, 170px); }

  .estudio-grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) 1.2fr;
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
    margin-bottom: var(--section);
  }
  .portrait { width: 100%; aspect-ratio: 4 / 5; border-radius: 2px; }
  .portrait .ph { width: 100%; height: 100%; }
  .bio .lead {
    font-family: var(--serif);
    font-weight: 300;
    font-size: var(--fs-lead);
    line-height: 1.34;
    letter-spacing: -0.01em;
    margin-bottom: 1.2em;
  }
  .bio p { max-width: 52ch; color: var(--ink-80); }

  /* ---------- experiencia ---------- */
  .exp {
    border-top: 1px solid var(--line);
    padding-top: clamp(28px, 4vh, 48px);
    margin-bottom: var(--section);
  }
  .exp-h { color: var(--ink-60); margin-bottom: clamp(24px, 4vh, 40px); display: block; }
  .exp-row {
    display: grid;
    grid-template-columns: minmax(180px, 0.32fr) 1fr;
    gap: 16px clamp(24px, 4vw, 64px);
    padding-block: clamp(20px, 3vh, 30px);
    border-top: 1px solid var(--ink-12);
  }
  .exp-meta { display: flex; flex-direction: column; gap: 6px; }
  .exp-where {
    font-family: var(--serif);
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    letter-spacing: -0.01em;
  }
  .exp-when { color: var(--ink-45); font-size: 10px !important; letter-spacing: 0.1em; text-transform: uppercase; }
  .exp-role {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    letter-spacing: 0.01em;
    margin-bottom: 8px;
  }
  .exp-desc {
    font-family: var(--sans);
    font-size: clamp(0.92rem, 1.05vw, 1rem);
    line-height: 1.55;
    color: var(--ink-80);
    max-width: 68ch;
  }
  .exp-skills {
    margin-top: clamp(20px, 3vh, 30px);
    color: var(--ink-45);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 2;
  }
  @media (max-width: 720px) {
    .exp-row { grid-template-columns: 1fr; gap: 10px; }
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(28px, 4vw, 64px);
    border-top: 1px solid var(--line);
    padding-top: clamp(28px, 4vh, 48px);
  }
  .col-h { color: var(--ink-60); margin-bottom: 18px; }
  .list { list-style: none; display: grid; gap: 9px; }
  .list li {
    font-family: var(--serif);
    font-size: clamp(1.05rem, 1.3vw, 1.3rem);
    padding-bottom: 9px;
    border-bottom: 1px solid var(--ink-12);
  }
  .approach { color: var(--ink-80); line-height: 1.55; }

  @media (max-width: 820px) {
    .estudio-grid { grid-template-columns: 1fr; }
    .portrait { max-width: 320px; }
    .cols { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
