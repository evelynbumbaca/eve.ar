---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import T from '../components/T.astro';
import { site, social } from '../data/site';
---

<Base title="Contacto — EVE" description="Hablemos. Contacto de Eve — diseñadora multimedia y UX/UI en Buenos Aires.">
  <article class="page contacto">
    <div class="wrap">
      <header class="page-head">
        <span class="kicker mono cap"><T es="Contacto" en="Contact" /></span>
        <h1 class="page-title reveal">
          <span class="revfill"><T es="Hagamos algo" en="Let's make something" /></span>
        </h1>
        <h1 class="page-title reveal">
          <span class="revfill accent"><T es="memorable." en="memorable." /></span>
        </h1>
        <p class="page-sub rise">
          <T es="Contame sobre tu proyecto y te respondo a la brevedad." en="Tell me about your project and I'll get back to you shortly." />
        </p>
      </header>

      <div class="contacto-grid">
        <form class="contact-form rise" id="contact-form" novalidate>
          <div class="field">
            <label for="cf-name"><T es="Nombre" en="Name" /></label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="cf-email">Email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="cf-msg"><T es="Mensaje" en="Message" /></label>
            <textarea id="cf-msg" name="message" rows="5" required></textarea>
          </div>
          <button class="submit" type="submit" data-glow-dock>
            <span data-i18n-send><T es="Enviar mensaje" en="Send message" /></span>
            <span aria-hidden="true">→</span>
          </button>
          <p class="form-note" id="cf-note" hidden></p>
        </form>

        <aside class="contact-direct rise rise-delay-1">
          <div class="direct-row">
            <span class="mono cap"><T es="Escribime" en="Email" /></span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div class="direct-row">
            <span class="mono cap"><T es="Ubicación" en="Location" /></span>
            <span><T es="Buenos Aires, Argentina" en="Buenos Aires, Argentina" /></span>
          </div>
          <div class="direct-row">
            <span class="mono cap"><T es="Redes" en="Social" /></span>
            <nav class="direct-social">
              {social.map((s) => (
                <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
              ))}
            </nav>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <SiteFooter />
</Base>

<style>
  .page { padding-top: clamp(120px, 18vh, 200px); }
  .page-head { margin-bottom: clamp(40px, 7vh, 90px); }
  .kicker { display: block; color: var(--ink-60); margin-bottom: clamp(20px, 3vh, 34px); }
  .page-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--fs-h1);
    line-height: 1.0;
    letter-spacing: -0.02em;
  }
  .page-title .accent { font-style: italic; font-weight: 300; color: var(--ink-80); }
  .page-title .revfill { display: block; }
  .page-sub {
    margin-top: 22px;
    max-width: 34ch;
    color: var(--ink-80);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.5;
  }

  .contacto-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
    border-top: 1px solid var(--line);
    padding-top: clamp(32px, 5vh, 56px);
  }

  .field { margin-bottom: clamp(20px, 3vh, 30px); }
  .field label {
    display: block;
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-60);
    margin-bottom: 10px;
  }
  .field input,
  .field textarea {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line);
    padding: 8px 0 12px;
    font-family: var(--serif);
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    color: var(--ink);
    transition: border-color 0.25s var(--ease);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--ink);
  }
  .field textarea { resize: vertical; line-height: 1.4; }

  .submit {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
    padding: 14px 26px;
    border-radius: 40px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 14px;
    letter-spacing: 0.04em;
    transition: opacity 0.25s var(--ease);
  }
  .submit:hover { opacity: 0.85; }
  .form-note {
    margin-top: 18px;
    font-size: var(--fs-small);
    color: var(--ink-60);
  }

  .contact-direct { display: grid; gap: clamp(22px, 3vh, 32px); }
  .direct-row { display: grid; gap: 8px; }
  .direct-row > .mono { color: var(--ink-45); }
  .direct-row a,
  .direct-row span:not(.mono) {
    font-family: var(--serif);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
  }
  .direct-row a { transition: opacity 0.2s var(--ease); }
  .direct-row a:hover { opacity: 0.6; }
  .direct-social { display: flex; flex-wrap: wrap; gap: 16px; }

  @media (max-width: 820px) {
    .contacto-grid { grid-template-columns: 1fr; gap: 44px; }
  }
</style>

<script is:inline define:vars={{ email: site.email }}>
  // Sin backend todavia: al enviar, componemos un mail prellenado.
  const form = document.getElementById('contact-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = (data.get('name') || '').toString().trim();
      const from = (data.get('email') || '').toString().trim();
      const msg = (data.get('message') || '').toString().trim();
      const note = document.getElementById('cf-note');
      if (!name || !from || !msg) {
        if (note) { note.hidden = false; note.textContent = 'Completá todos los campos · Please fill in all fields'; }
        return;
      }
      const subject = encodeURIComponent(`Proyecto — ${name}`);
      const body = encodeURIComponent(`${msg}\n\n— ${name} (${from})`);
      window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
      if (note) { note.hidden = false; note.textContent = 'Abriendo tu cliente de correo… · Opening your email client…'; }
    });
  }
</script>
